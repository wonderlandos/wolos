#!/bin/sh
#
# PROVIDE: wold
# REQUIRE: FILESYSTEMS ldconfig
# BEFORE: LOGIN
# KEYWORD: shutdown
#
# wold_enable="YES"   launchd-style job supervisor (jobs: /usr/local/etc/wolos/jobs)

. /etc/rc.subr

name=wold
rcvar=wold_enable
load_rc_config $name
: ${wold_enable:="NO"}
: ${wold_jobs:="/usr/local/etc/wolos/jobs"}

pidfile="/var/run/${name}.pid"
procname="/usr/local/sbin/wold"
command="/usr/sbin/daemon"
command_args="-p ${pidfile} -S -T ${name} ${procname} ${wold_jobs}"
# SIGTERM stops every job tree (children first) before wold exits.
stop_postcmd="rm -f ${pidfile} /var/run/wold.sock /var/run/wol-qos.sock"

run_rc_command "$1"
