{
  "grants": [
    {
      "app": "/usr/bin/wlrctl",
      "capability": "window-list"
    },
    {
      "app": "/usr/bin/wayvnc",
      "capability": "screen-capture"
    },
    {
      "app": "/usr/bin/wayvnc",
      "capability": "input-injection"
    },
    {
      "app": "/usr/bin/wl-paste",
      "capability": "clipboard-history"
    },
    {
      "app": "/usr/bin/grim",
      "capability": "screen-capture"
    },
    {
      "app": "/usr/bin/slurp",
      "capability": "shell-layer"
    }
  ],
  "_note": "Dev VM: wayvnc serves the desktop to image/vm/open.sh. grim/slurp back iara-screenshot (Super+Shift+3/4/5). On user systems these grants come from Settings > Privacy."
}
