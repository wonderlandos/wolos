[Unit]
Description=WolOS first boot: drivers only the internet has (NVIDIA), once
ConditionPathExists=!/var/lib/wolos/firstboot-done
After=wolos-hw.service network-online.target
Wants=network-online.target
Before=wold.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/wolos/firstboot
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
