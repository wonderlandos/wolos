[Unit]
Description=WolOS hardware: drivers and settings for the devices present (wol hw boot)
DefaultDependencies=no
After=systemd-modules-load.service systemd-udevd.service local-fs.target
Before=wolos-gpu.service wolos-firstboot.service wold.service NetworkManager.service sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Every boot (a disk moves between machines): load the drivers the hardware catalogue names, write
# next-boot settings (microcode, vendor drivers), publish /run/wolos-hw.json for Settings and `wol hw`.
ExecStart=/usr/bin/wol hw boot

[Install]
WantedBy=sysinit.target
