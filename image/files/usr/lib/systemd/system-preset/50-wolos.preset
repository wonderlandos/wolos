# WolOS services (ADR 0016). Arch units WolOS relies on are enabled here too.
enable wold.service
enable wolos-boot-ok.service
enable wolos-verity-check.service
enable systemd-sysext.service
enable wolos-hw.service
enable wolos-gpu.service
enable wolos-firstboot.service
enable wolos-power.service
enable wolos-update-check.timer
enable wolos-update-download.timer
enable wolos-report.timer
enable wolos-xguard.service
enable wolos-xguard-update.timer
enable wolos-xguard-sweep.timer
enable NetworkManager.service
enable bluetooth.service
enable nftables.service
enable cups.socket
enable avahi-daemon.service
enable systemd-timesyncd.service
enable udisks2.service
enable seatd.service
# NetworkManager runs the network; no text console on the screen (WolOS login window on tty1).
disable systemd-networkd.service
disable systemd-networkd-wait-online.service
disable getty@.service
