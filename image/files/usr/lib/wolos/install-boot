#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# WolOS installer: make the disk start the new system (ADR 0023, 0025). The one place install-run
# calls: boot-setup picks the protection and installs the loader. Runs after the seal.
# WOLOS_OTHER_SYSTEMS non-empty: another system shares the disk, so the menu shows for a moment.
set -u
here=$(cd "$(dirname "$0")" && pwd)
exec sh "$here/boot-setup" "$WOLOS_ROOT" "$WOLOS_ESP"
