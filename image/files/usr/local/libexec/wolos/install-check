#!/bin/sh
# WolOS installer: may <disk> be erased? Reads only (never writes a disk). Run by install-run
# before anything is written, and by the Install WolOS app to word its warning. One fact per line:
#   size <bytes>
#   os <Windows|Linux|macOS|FreeBSD>   another system lives on this disk (GPT/MBR types, labels)
#   secureboot on                      firmware Secure Boot is on: the installed WolOS won't start
#   refuse <not-listed|too-small|in-use>
# Exit 0: may erase. 2: refused (the boot medium, a missing disk, too small, a mounted partition).
set -u
MIN_BYTES=16000000000   # crate shell install::MIN_BYTES
here=$(dirname "$0")
disk=${1:-}
if [ -z "$disk" ] || ! sh "$here/install-disks" | grep -qx -- "$disk"; then
  echo "refuse not-listed"; exit 2
fi
rc=0
bytes=$(diskinfo "$disk" 2>/dev/null | awk '{print $3}')
case $bytes in ''|*[!0-9]*) bytes=0 ;; esac
echo "size $bytes"
gpart list "$disk" 2>/dev/null | awk '
  $1 == "type:" || $1 == "rawtype:" || $1 == "label:" {
    v = tolower($0); sub(/^[ \t]*[a-z]+: *!?/, "", v)
    if (v ~ /^(ms-reserved|ms-recovery|ntfs|e3c9e316-0b5c-4db8-817d-f92df00215ae|de94bba4-06d1-4d40-a16a-bfd50179d6ac)$/ ||
        v ~ /^(microsoft reserved partition|basic data partition)$/) os["Windows"] = 1
    else if (v ~ /^linux-/ || v ~ /^(0fc63daf-8483-4772-8e79-3d69d8477de4|4f68bce3-e8cd-4db1-96e7-fbcaf984b709|0657fd6d-a4ab-43c4-84e5-0933c84b4f4f|e6d6d379-f507-44c2-a23c-238f2a3df928|a19d880f-05fc-4d3b-a006-743f0f84911e|933ac7e1-2eb4-4f13-b844-0e14e2aef915)$/) os["Linux"] = 1
    else if (v ~ /^apple-/ || v ~ /^(48465300-0000-11aa-aa11-00306543ecac|7c3457ef-0000-11aa-aa11-00306543ecac)$/) os["macOS"] = 1
    else if (v ~ /^freebsd-(ufs|zfs)$/ || v ~ /^(516e7cb6-6ecf-11d6-8ff8-00022d09712b|516e7cba-6ecf-11d6-8ff8-00022d09712b)$/) os["FreeBSD"] = 1
  }
  END { n = split("Windows Linux macOS FreeBSD", names, " "); for (i = 1; i <= n; i++) if (names[i] in os) print "os " names[i] }'
# Byte 0 of EFI global variable SecureBoot (efivar --hex: "<offset>: 01 ..."). Absent: BIOS boot.
sb=$(efivar --hex -n 8be4df61-93ca-11d2-aa0d-00e098032b8c-SecureBoot 2>/dev/null |
  awk '{for (i = 1; i <= NF; i++) if ($i !~ /:$/ && $i ~ /^[0-9a-fA-F][0-9a-fA-F]$/) {print $i; exit}}')
[ "$sb" = 01 ] && echo "secureboot on"
[ "$bytes" -ge "$MIN_BYTES" ] || { echo "refuse too-small"; rc=2; }
# A partition of it still mounted (a USB disk opened in Files): install-run unmounts those first.
if mount -p 2>/dev/null | awk -v d="/dev/$disk" 'index($1, d) == 1 && substr($1, length(d) + 1) ~ /^([ps][0-9].*)?$/ {f = 1} END {exit !f}'; then
  echo "refuse in-use"; rc=2
fi
exit $rc
