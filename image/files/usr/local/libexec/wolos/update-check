#!/bin/sh
# Daily update check (wol_core::update::check, archicture/modules/security.md). cron runs it
# hourly as root; it checks at most once every 20 hours, so a computer asleep at night still
# checks once a day. `update-check now` checks regardless. It only looks and downloads: installing
# is Software Update (wol-admind), after a restore point.
#
# Findings in $D, readable by every account (the shell notifies from them):
#   pkg      packages with a newer version (pkg version)
#   audit    installed packages with a known vulnerability (pkg audit)
#   base     freebsd-update fetch output when FreeBSD fixes are ready, else empty
#   checked  when the check finished (seconds since 1970)
# freebsd-update.conf: the stock configuration, limited to `world` when the running kernel is not
# GENERIC, so WolKernel is never replaced by a GENERIC kernel. Install uses the same file.
set -u
D=${WOLOS_UPDATES:-/var/db/wolos/updates}
STOCK=${WOLOS_FREEBSD_UPDATE_CONF:-/etc/freebsd-update.conf}
EVERY=72000

now=$(date +%s)
last=$(cat "$D/checked" 2>/dev/null)
case $last in '' | *[!0-9]*) last=0 ;; esac
[ "${1:-}" = now ] || [ $((now - last)) -ge $EVERY ] || exit 0

umask 022
mkdir -p "$D" || exit 1
# Offline: no stamp, the next hour tries again.
pkg update -q >/dev/null 2>&1 || exit 0

pkg version -U -vRL= >"$D/pkg.new" 2>/dev/null && mv "$D/pkg.new" "$D/pkg"
# Exit 1 also means "found some"; an empty list from a failed fetch keeps the last one.
pkg audit -F -q >"$D/audit.new" 2>/dev/null
st=$?
if [ $st -eq 0 ] || [ -s "$D/audit.new" ]; then mv "$D/audit.new" "$D/audit"; else rm -f "$D/audit.new"; fi

if [ "$(sysctl -n kern.ident)" = GENERIC ]; then
	cp "$STOCK" "$D/freebsd-update.conf.new"
else
	sed 's/^Components[[:space:]].*/Components world/' "$STOCK" >"$D/freebsd-update.conf.new"
fi
mv "$D/freebsd-update.conf.new" "$D/freebsd-update.conf"
FU="freebsd-update -f $D/freebsd-update.conf"
if PAGER=cat $FU --not-running-from-cron fetch >"$D/base.new" 2>&1 &&
	$FU updatesready >/dev/null 2>&1; then
	mv "$D/base.new" "$D/base"
else
	rm -f "$D/base.new"
	: >"$D/base"
fi

date +%s >"$D/checked"
chmod 644 "$D/pkg" "$D/audit" "$D/base" "$D/checked" "$D/freebsd-update.conf" 2>/dev/null
exit 0
