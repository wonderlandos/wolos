#!/bin/sh
# WolOS boot entry, run in the new system right after bsdinstall's bootconfig (installerconfig).
# Touches only <disk>'s own EFI partition (new: the installer just created it):
#   \EFI\WolOS\loader.efi (+ loader.png/os_wolos.png: the WolOS icon in rEFInd and similar menus);
#   \EFI\BOOT\BOOTX64.EFI only when missing or already a FreeBSD/WolOS loader;
#   firmware entry "WolOS" first in BootOrder. Other systems' entries are only moved down;
#   bsdinstall's entry on this partition (\efi\freebsd) is replaced. BIOS boot: files only.
set -u
R=${WOLOS_ROOT:-}
disk=${1:-}
[ -n "$disk" ] || { echo "install-esp: no disk"; exit 1; }
esp=$(gpart show -p "$disk" 2>/dev/null | awk '$4 == "efi" {print $3; exit}')
[ -n "$esp" ] || { echo "install-esp: no EFI partition on $disk (BIOS boot only)"; exit 0; }
case $esp in "$disk"p[0-9]*) ;; *) echo "install-esp: $esp is not on $disk"; exit 1 ;; esac
mnt=${WOLOS_ESP_MNT:-}
if [ -z "$mnt" ]; then
  mnt=$(mktemp -d /tmp/wolos-esp.XXXXXX) && mount_msdosfs "/dev/$esp" "$mnt" || { echo "install-esp: cannot mount $esp"; exit 1; }
  trap 'umount "$mnt"; rmdir "$mnt"' EXIT
fi
efi=$R/boot/loader.efi
mkdir -p "$mnt/EFI/WolOS" && cp "$efi" "$mnt/EFI/WolOS/loader.efi" || { echo "install-esp: copy failed"; exit 1; }
for n in loader.png os_wolos.png; do
  [ -f "$R/usr/local/share/wolos/boot/os_wolos.png" ] && cp "$R/usr/local/share/wolos/boot/os_wolos.png" "$mnt/EFI/WolOS/$n"
done
fb=$mnt/EFI/BOOT/BOOTX64.EFI
if [ ! -f "$fb" ] || cmp -s "$fb" "$efi" || grep -aq 'FreeBSD/amd64 EFI loader' "$fb"; then
  mkdir -p "$mnt/EFI/BOOT" && cp "$efi" "$fb"
fi
# bsdinstall's copy: one WolOS entry in boot menus, not two.
for d in "$mnt/EFI/freebsd" "$mnt/efi/freebsd"; do
  [ -f "$d/loader.efi" ] && cmp -s "$d/loader.efi" "$efi" && rm -rf "$d"
done
efibootmgr >/dev/null 2>&1 || exit 0    # BIOS boot: no firmware entries
uuid=$(gpart list "$disk" | awk -v p="$esp" '/Name: / {f = ($NF == p)} f && $1 == "rawuuid:" {print $2; exit}')
[ -n "$uuid" ] || { efibootmgr --create --activate --label WolOS --loader "$mnt/EFI/WolOS/loader.efi" >/dev/null; exit 0; }
ours() { efibootmgr -v | awk -v u="$uuid" 'index(tolower($0), tolower(u)) && match($0, /Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]/) {print substr($0, RSTART + 4, 4)}'; }
for n in $(ours); do efibootmgr -B -b "$n" >/dev/null; done
efibootmgr --create --activate --label WolOS --loader "$mnt/EFI/WolOS/loader.efi" >/dev/null || { echo "install-esp: no firmware entry (BOOTX64.EFI still starts WolOS)"; exit 0; }
new=$(ours | head -1)
[ -n "$new" ] || exit 0
rest=$(efibootmgr | awk -F': *' '/^BootOrder/ {print $2}' | tr -d ' ' | tr ',' '\n' | grep -vx -- "$new" | paste -sd, -)
efibootmgr -o "$new${rest:+,$rest}" >/dev/null
