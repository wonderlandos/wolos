#!/bin/sh
# WolOS installer: print the disks it may erase, one per line.
# Never cd/md, nor the disk we booted from: memstick (ufs/FreeBSD_Install), ISO (iso9660/WOLOS)
# or a Ventoy stick (msdosfs/VTOYEFI).
set -u
media=$(glabel status 2>/dev/null | awk '$1 ~ /^(ufs\/FreeBSD_Install|iso9660\/WOLOS|msdosfs\/VTOYEFI)$/ {print $3}' |
  sed -E 's/([sp][0-9]+.*)?$//' | sort -u)
for d in $(sysctl -n kern.disks); do
  case $d in cd*|md*) continue ;; esac
  echo "$media" | grep -qx "$d" || echo "$d"
done
