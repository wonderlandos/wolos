#!/bin/sh
# Install the WolOS desktop packages from the offline repo (wolospkg.txz -> /var/cache/wolos-repo),
# then remove the repo. Run in the target root (installer chroot or live root chroot). Idempotent.
set -eu
# bsdinstall chroot PATH lacks /usr/local: pkg POST-INSTALL scripts call indexinfo etc. from there.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
R=/var/cache/wolos-repo
[ -f "$R/wolos-packages.txt" ] || { echo "install-pkgs: no $R (already installed?)"; exit 0; }
C=$(mktemp -d)
printf 'wolos: { url: "file://%s", enabled: yes, signature_type: "none" }\n' "$R" > "$C/wolos.conf"
# pkg 2.x fetch -d stores packages under All/Hashed/<name>-<ver>~<hash>.pkg: find, never a fixed glob
# (a non-matching glob made pkg(7) fall back to a network bootstrap and fail offline).
P=$(find "$R/All" -name 'pkg-[0-9]*.pkg' | head -1)
[ -n "$P" ] || { echo "install-pkgs: no pkg package in $R" >&2; exit 1; }
pkg -N >/dev/null 2>&1 || env ASSUME_ALWAYS_YES=yes pkg add "$P"
# shellcheck disable=SC2046
rc=0; env ASSUME_ALWAYS_YES=yes pkg -R "$C" install -y -r wolos $(cat "$R/wolos-packages.txt") || rc=$?
[ "$rc" = 0 ] || { echo "install-pkgs: pkg install exited $rc" >&2; rm -rf "$C"; exit "$rc"; }
# WolOS Hyprland fork (patches 0001-0004) over pkg hyprland; lock so pkg upgrade never reverts it.
if [ -f "$R/hyprland-fork.tar" ]; then
  tar -C / -xpf "$R/hyprland-fork.tar"
  pkg lock -y hyprland
fi
# WolOS i915kms (kernel/drm: deadline boost, foreground waitboost) over pkg drm-612-kmod.
if [ -f "$R/drm-fork.tar" ]; then
  tar -C / -xpf "$R/drm-fork.tar"
  kldxref /boot/modules 2>/dev/null || :
  pkg lock -y drm-612-kmod
fi
# Overlay MIME types and handlers (`.wol` -> App Store): the caches only see files pkg installed.
command -v update-mime-database >/dev/null && update-mime-database /usr/local/share/mime
command -v update-desktop-database >/dev/null && update-desktop-database -q /usr/local/share/applications
rm -rf "$R" "$C"
