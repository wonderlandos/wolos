#!/bin/sh
# PROVIDE: wold
# REQUIRE: DAEMON dbus seatd
# KEYWORD: shutdown
. /etc/rc.subr
name=wold
rcvar=wold_enable
load_rc_config $name
: ${wold_enable:=YES}
command=/usr/sbin/daemon
pidfile=/var/run/wold.pid
# pidfile = daemon(8) supervisor pid; procname stays the daemon (rc.subr matches its "daemon:" title).
command_args="-r -P ${pidfile} -o /var/log/wold.log /usr/local/bin/wold"
run_rc_command "$1"
