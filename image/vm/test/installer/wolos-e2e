#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# In the VM: walk the installer's steps for scenario wolos.e2e=<name> on /dev/vda, install, power off.
s=$(sed -n 's/.*wolos\.e2e=\([^ ]*\).*/\1/p' /proc/cmdline)
L=/usr/lib/wolos
D=/run/wolos-e2e
udevadm settle
if [ "$s" = medium ]; then
  # The disk this system started from must not be listed, must not be installable.
  m=$(lsblk -no PKNAME -p "$(findmnt -no SOURCE /run/archiso/bootmnt)" | head -1)
  if sh $L/install-disks | grep -qx "$m"; then echo medium-listed > /dev/ttyS0
  elif sh $L/install-run "$m" | grep -q 'not a disk'; then echo medium-refused > /dev/ttyS0
  else echo medium-accepted > /dev/ttyS0; fi
  systemctl poweroff; exit
fi
mkdir -p "$D"
# As the app does: the live user, through sudo.
as_live() { runuser -u live -- sudo -n "$@"; }
as_live $L/install-check /dev/vda --probe > "$D/probe.json"
install_scenario "$s" "$D/probe.json" "$D/plan" > /dev/ttyS0 2>&1 || { echo "wolos-install: failed 0 scenario" > /dev/ttyS0; systemctl poweroff; exit; }
# The serial port is opened for each line: a getty starting on it hangs up whoever held it open.
as_live $L/install-run --plan "$D/plan/plan.json" 2>&1 | while IFS= read -r l; do echo "$l" > /dev/ttyS0; done
systemctl poweroff
