# SPDX-License-Identifier: GPL-2.0-or-later
# wolos-shim (ADR 0025): the first stage most PCs already trust, and the firmware's key screen,
# for computers whose keys can't be changed. Fedora's signed build, byte for byte: nothing here is
# rebuilt or altered, so its signatures and its own identity stay true. Pinned by hash.
# A local build only: not in image/repo/packages and not in any image. Without it the key screen
# tier is simply not offered (`wol boot detect`).
pkgname=wolos-shim
pkgver=16.1
_fedrel=7
pkgrel=1
pkgdesc='Signed first-stage boot loader and key enrolment screen (Fedora build, unmodified)'
arch=(x86_64)
url='https://github.com/rhboot/shim'
license=(LicenseRef-shim)
makedepends=(libarchive)
options=(!strip !debug)
source=("https://kojipkgs.fedoraproject.org/packages/shim/$pkgver/$_fedrel/x86_64/shim-x64-$pkgver-$_fedrel.x86_64.rpm"
  "shim-COPYRIGHT::https://raw.githubusercontent.com/rhboot/shim/$pkgver/COPYRIGHT")
noextract=("shim-x64-$pkgver-$_fedrel.x86_64.rpm")
sha256sums=('4badee0c00c4c41a53f41c8a2dd566dca815ca051f1d2fba92490d0a0194f5c3' '15edf527919ddcb2f514ab9d16ad07ef219e4bb490e0b79560be510f0c159cc2')

check() {
  bsdtar -xf "shim-x64-$pkgver-$_fedrel.x86_64.rpm"
  cd "usr/lib/efi/shim/$pkgver-$_fedrel/EFI/fedora"
  echo "351e131d3c4a636704e9cae7d1296baf8a05beca9922cfebbfa48933c9bf1ad3  shimx64.efi" | sha256sum -c
  echo "ed4442fa88cccba3a9e6a32d21a8f4c56bf5aab184f1fb9aadde8d3a9d04dc27  mmx64.efi" | sha256sum -c
}

package() {
  cd "usr/lib/efi/shim/$pkgver-$_fedrel/EFI/fedora"
  install -Dm644 -t "$pkgdir/usr/share/wolos/shim" shimx64.efi mmx64.efi
  install -Dm644 "$srcdir/shim-COPYRIGHT" "$pkgdir/usr/share/licenses/wolos-shim/COPYRIGHT"
}
