# wolos-mirrorlist: where pacman finds [wolos] and [wolos-cachy] (ADR 0019). The date is the
# release's snapshot (image/arch/snapshot); `wol update` moves it, `wol mirror rank` reorders it.
pkgname=wolos-mirrorlist
pkgver=2026.10.20
pkgrel=2
pkgdesc='WolOS package mirror list'
arch=(any)
url='https://github.com/wonderlandos/wolos'
license=(BSD-2-Clause)
backup=(etc/pacman.d/wolos-mirrorlist)
source=(wolos-mirrorlist)
sha256sums=(SKIP)

package() {
  install -Dm644 wolos-mirrorlist "$pkgdir/etc/pacman.d/wolos-mirrorlist"
}
