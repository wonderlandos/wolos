From da47f5494bdf4a66a781ffdd65b8f38170ad700b Mon Sep 17 00:00:00 2001
From: kleeedolinux <71413974+kleeedolinux@users.noreply.github.com>
Date: Mon, 26 Oct 2026 08:20:43 -0300
Subject: [PATCH] xdg-shell: advertise minimise; client minimise moves the
 window to special:hidden

---
 src/desktop/view/Window.cpp | 5 +++++
 src/protocols/XDGShell.cpp  | 3 +++
 2 files changed, 8 insertions(+)

diff --git a/src/desktop/view/Window.cpp b/src/desktop/view/Window.cpp
index 8836f73..f64a4e1 100644
--- a/src/desktop/view/Window.cpp
+++ b/src/desktop/view/Window.cpp
@@ -1424,6 +1424,11 @@ void CWindow::onUpdateState() {
             m_wantsInitialFullscreen = fs;
     }
 
+    // WolOS: client minimise (CSD button) hides the window like the Minimise menu item.
+    const std::optional<bool> requestsMin = m_xdgSurface ? m_xdgSurface->m_toplevel->m_state.requestsMinimize : std::nullopt;
+    if (requestsMin.value_or(false) && m_isMapped && g_pKeybindManager->m_dispatchers.contains("movetoworkspacesilent"))
+        g_pKeybindManager->m_dispatchers["movetoworkspacesilent"](std::format("special:hidden,address:0x{:x}", rc<uintptr_t>(this)));
+
     if (requestsMX.has_value() && !(m_suppressedEvents & SUPPRESS_MAXIMIZE)) {
         if (m_isMapped) {
             auto window = m_self.lock();
diff --git a/src/protocols/XDGShell.cpp b/src/protocols/XDGShell.cpp
index d3d2f4d..1eabcee 100644
--- a/src/protocols/XDGShell.cpp
+++ b/src/protocols/XDGShell.cpp
@@ -169,6 +169,9 @@ CXDGToplevelResource::CXDGToplevelResource(SP<CXdgToplevel> resource_, SP<CXDGSu
         *p     = XDG_TOPLEVEL_WM_CAPABILITIES_FULLSCREEN;
         p      = sc<uint32_t*>(wl_array_add(&arr, sizeof(uint32_t)));
         *p     = XDG_TOPLEVEL_WM_CAPABILITIES_MAXIMIZE;
+        // WolOS: minimise is real (the window goes to special:hidden), so clients enable their button.
+        p  = sc<uint32_t*>(wl_array_add(&arr, sizeof(uint32_t)));
+        *p = XDG_TOPLEVEL_WM_CAPABILITIES_MINIMIZE;
         m_resource->sendWmCapabilities(&arr);
         wl_array_release(&arr);
     }
-- 
