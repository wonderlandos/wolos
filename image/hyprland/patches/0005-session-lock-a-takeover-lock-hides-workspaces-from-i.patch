diff --git a/tests/helpers/WolosLock.cpp b/tests/helpers/WolosLock.cpp
new file mode 100644
index 0000000..e4cb1b1
--- /dev/null
+++ b/tests/helpers/WolosLock.cpp
@@ -0,0 +1,32 @@
+#include <helpers/WolosLock.hpp>
+
+#include <gtest/gtest.h>
+
+using namespace WolosLock;
+
+TEST(WolosLock, workspacesHiddenUnderTheLock) {
+    struct {
+        SLockState s;
+        bool       hidden;
+    } cases[] = {
+        {{.missing = false, .locked = false, .denied = false, .takeover = false}, false}, // fresh lock on an unlocked desktop: no black flash
+        {{.missing = true, .locked = false, .denied = false, .takeover = false}, true},  // lock missing or timed out
+        {{.missing = false, .locked = true, .denied = false, .takeover = false}, true},  // lock confirmed
+        {{.missing = false, .locked = false, .denied = true, .takeover = false}, true},  // lock denied
+        {{.missing = false, .locked = false, .denied = false, .takeover = true}, true},  // locked start / crashed locker restored
+    };
+    for (auto c : cases)
+        EXPECT_EQ(workspacesHidden(c.s), c.hidden) << c.s.missing << c.s.locked << c.s.denied << c.s.takeover;
+}
+
+TEST(WolosLock, takeoverOnlyWhenAlreadyLocked) {
+    EXPECT_TRUE(isTakeover(true));
+    EXPECT_FALSE(isTakeover(false));
+}
+
+TEST(WolosLock, crashRestartRelaunchesTheLocker) {
+    using V = std::vector<std::string>;
+    EXPECT_EQ(crashLockArgs("wol-lock --startup"), (V{"--locked-cmd", "wol-lock --startup"}));
+    EXPECT_EQ(crashLockArgs(""), (V{"--locked"})); // upstream: locked, nothing to unlock with
+    EXPECT_EQ(crashLockArgs(nullptr), (V{"--locked"}));
+}
