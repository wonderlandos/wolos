@@ -21,6 +21,8 @@
 #include "./pass/TextureMatteElement.hpp"
 #include "./pass/TransformedWindowPassElement.hpp"
 #include "types.hpp"
+#include "../helpers/WolosPerf.hpp"
+#include <unordered_map>
 #include "../output/Monitor.hpp"
 #include "../desktop/state/Fadeout.hpp"
 #include "../desktop/view/LayerSurface.hpp"
@@ -306,6 +308,9 @@ namespace Render {
         std::vector<SP<IRenderbuffer>> m_renderbuffers;
         std::vector<PHLWINDOWREF>      m_renderUnfocused;
         SP<CEventLoopTimer>            m_renderUnfocusedTimer;
+        // WolOS: per-window frame-callback throttle state (see WolosPerf.hpp)
+        std::unordered_map<const void*, WolosPerf::SThrottleState> m_wolosThrottle;
+        Time::steady_tp                m_wolosLastFrameEvents = Time::steadyNow();
 
         friend class CRenderPass;
         friend class Render::GL::CHyprOpenGLImpl;
diff --git a/tests/helpers/WolosPerf.cpp b/tests/helpers/WolosPerf.cpp
index 677b169..2d9b030 100644
--- a/tests/helpers/WolosPerf.cpp
+++ b/tests/helpers/WolosPerf.cpp
@@ -49,3 +49,38 @@ TEST(WolosPerf, autoScanoutCoversGamesAndVideo) {
     EXPECT_TRUE(autoScanoutAllows(false, false, true));   // Proton game: tearing hint, no content type
     EXPECT_FALSE(autoScanoutAllows(false, false, false)); // a fullscreen editor keeps composition
 }
+
+TEST(WolosPerf, visibleFractionSubtractsOverlappingOccluders) {
+    SRect self{0, 0, 100, 100};
+    EXPECT_DOUBLE_EQ(visibleFraction(self, {}), 1.0);
+    EXPECT_DOUBLE_EQ(visibleFraction(self, {{0, 0, 100, 100}}), 0.0);
+    EXPECT_DOUBLE_EQ(visibleFraction(self, {{0, 0, 50, 100}}), 0.5);
+    EXPECT_DOUBLE_EQ(visibleFraction(self, {{0, 0, 50, 100}, {25, 0, 50, 100}}), 0.25); // overlap counted once
+    EXPECT_DOUBLE_EQ(visibleFraction(self, {{-50, -50, 300, 300}}), 0.0);                // larger than self
+    EXPECT_DOUBLE_EQ(visibleFraction(self, {{200, 200, 10, 10}}), 1.0);                  // elsewhere
+}
+
+TEST(WolosPerf, occludedSurfacesAreFrozenForTwoUpdatesOrAboutThirtyThreeMs) {
+    SThrottleConfig c;
+    SThrottleState  st;
+    EXPECT_TRUE(allowFrameCallback(st, 0.0, 11, 16.6, c));  // first opportunity always delivers
+    EXPECT_FALSE(allowFrameCallback(st, 0.0, 11, 16.6, c)); // frozen
+    EXPECT_FALSE(allowFrameCallback(st, 0.0, 11, 16.6, c)); // 33.2 ms, 2 skipped
+    EXPECT_TRUE(allowFrameCallback(st, 0.0, 11, 16.6, c));  // 2 updates reached
+    SThrottleState st2;
+    allowFrameCallback(st2, 0.0, 11, 1.0, c);
+    EXPECT_FALSE(allowFrameCallback(st2, 0.0, 11, 10.0, c));
+    EXPECT_TRUE(allowFrameCallback(st2, 0.0, 11, 23.4, c)); // 33.4 ms >= 33.3
+}
+
+TEST(WolosPerf, throttleNeedsManyWindowsAndLowVisibility) {
+    SThrottleConfig c;
+    SThrottleState  st;
+    allowFrameCallback(st, 1.0, 20, 16.0, c);
+    EXPECT_TRUE(allowFrameCallback(st, 1.0, 20, 16.0, c));  // visible window: never throttled
+    EXPECT_TRUE(allowFrameCallback(st, 0.19, 10, 16.0, c)); // exactly 10 windows: not "more than 10"
+    EXPECT_TRUE(allowFrameCallback(st, 0.2, 20, 16.0, c));  // at the cutoff: still visible
+    EXPECT_FALSE(allowFrameCallback(st, 0.19, 20, 1.0, c)); // below the cutoff with 20 windows
+    c.enabled = false;
+    EXPECT_TRUE(allowFrameCallback(st, 0.0, 20, 1.0, c));
+}
