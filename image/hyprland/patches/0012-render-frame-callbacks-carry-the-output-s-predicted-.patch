         SP<CEventLoopTimer>         m_dpmsRetryTimer;
 
         WolosPerf::SReconfigureBarrier m_wolosReconfigure;
+        WolosPerf::SPresentPredictor   m_wolosPresent;
         SP<CEventLoopTimer>         m_wolosReconfigureTimer;
         bool                        m_pendingFrame    = false; // if we schedule a frame during rendering, reschedule it after
         bool                        m_renderingActive = false;
diff --git a/src/output/MonitorFrameScheduler.cpp b/src/output/MonitorFrameScheduler.cpp
index 9299bfb..b68de21 100644
--- a/src/output/MonitorFrameScheduler.cpp
+++ b/src/output/MonitorFrameScheduler.cpp
@@ -25,7 +25,9 @@ void CMonitorFrameScheduler::onSyncFired() {
     // Sync fired: reset submitted state, set as rendered. Check the last render time. If we are running
     // late, we will instantly render here.
 
-    if (std::chrono::duration_cast<std::chrono::microseconds>(hrc::now() - m_lastRenderBegun).count() / 1000.F < 1000.F / PMONITOR->m_refreshRate) {
+    static auto PDEADLINE = CConfigValue<Config::FLOAT>("misc:frame_deadline");
+
+    if (!WolosPerf::renderMissedDeadline(std::chrono::duration_cast<std::chrono::microseconds>(hrc::now() - m_lastRenderBegun).count() / 1000.0, PMONITOR->m_refreshRate, *PDEADLINE)) {
         // we are in. Frame is valid. We can just render as normal.
         Log::logger->log(Log::TRACE, "CMonitorFrameScheduler: {} -> onSyncFired, didn't miss.", PMONITOR->m_name);
         m_renderAtFrame = true;
diff --git a/src/render/Renderer.cpp b/src/render/Renderer.cpp
index 725b09f..304d120 100644
--- a/src/render/Renderer.cpp
+++ b/src/render/Renderer.cpp
@@ -2546,6 +2546,10 @@ void IHyprRenderer::sendFrameEventsToWorkspace(PHLMONITOR pMonitor, PHLWORKSPACE
     const WolosPerf::SThrottleConfig CFG{
         .enabled = *PTHROTTLE, .windowCount = sc<int>(*PCOUNT), .cutoff = *PCUTOFF, .freezeMs = *PFREEZEMS, .freezeUpdates = sc<int>(*PFREEZEUPD)};
 
+    // Callbacks carry the output's predicted next present time (from presentation feedback), not "now".
+    const auto PREDICTEDMS = pMonitor->m_wolosPresent.next(WolosPerf::nowMs());
+    const auto predicted   = now + std::chrono::duration_cast<Time::steady_dur>(std::chrono::duration<double, std::milli>(PREDICTEDMS - WolosPerf::nowMs()));
+
     const auto                       elapsedMs = std::chrono::duration<double, std::milli>(now - m_wolosLastFrameEvents).count();
     m_wolosLastFrameEvents                     = now;
 
@@ -2599,7 +2603,7 @@ void IHyprRenderer::sendFrameEventsToWorkspace(PHLMONITOR pMonitor, PHLWORKSPACE
         if (skipChildren)
             continue;
 
-        view->wlSurface()->resource()->frame(now);
+        view->wlSurface()->resource()->frame(predicted);
     }
 
     if (!seen.empty())
diff --git a/tests/helpers/WolosPerf.cpp b/tests/helpers/WolosPerf.cpp
index 629881b..930d3e4 100644
--- a/tests/helpers/WolosPerf.cpp
+++ b/tests/helpers/WolosPerf.cpp
@@ -100,3 +100,20 @@ TEST(WolosPerf, reconfigureWaitsForAcksButNeverPast250ms) {
     b.begin(4000);
     EXPECT_DOUBLE_EQ(b.remainingMs(4100, 250), 150.0);
 }
+
+TEST(WolosPerf, nextPresentFollowsTheOutputsRefreshGrid) {
+    SPresentPredictor p;
+    EXPECT_DOUBLE_EQ(p.next(100.0), 100.0); // no feedback yet: now
+    p.onPresented(1000.0, 16.0);
+    EXPECT_DOUBLE_EQ(p.next(1005.0), 1016.0);
+    EXPECT_DOUBLE_EQ(p.next(1020.0), 1032.0);
+    EXPECT_DOUBLE_EQ(p.next(1031.0), 1032.0); // never goes backwards
+    p.onPresented(1048.0, 8.0);               // mode change to 125 Hz
+    EXPECT_DOUBLE_EQ(p.next(1049.0), 1056.0);
+}
+
+TEST(WolosPerf, renderDeadlineIs95PercentOfTheFrame) {
+    EXPECT_FALSE(renderMissedDeadline(15.0, 60.F, 0.95)); // 15.83 ms budget
+    EXPECT_TRUE(renderMissedDeadline(15.9, 60.F, 0.95));
+    EXPECT_FALSE(renderMissedDeadline(100.0, 0.F, 0.95)); // unknown refresh: never late
+}
