# WolOS bsdinstall script: asks only for the disk, then ZFS + boot environments.
DISTRIBUTIONS="kernel.txz base.txz wolos.txz wolospkg.txz"
export nonInteractive="YES"
# bsdinstall script re-inits its log when BSDINSTALL_LOG differs from debugFile; unset it means
# debugFile="" and every DEBUG line goes to the console. Same file: log only (copied to /var/log).
export BSDINSTALL_LOG=/tmp/bsdinstall_log
# linux_base-rl9's PRE-INSTALL refuses without 64-bit Linux support in the running (installer)
# kernel: "Cannot install package: kernel missing 64-bit Linux support" -> pkg exit 3.
kldload -n linux64 || echo "WOLOS: kldload linux64 failed; Linux packages install at first boot"
export ZFSBOOT_POOL_NAME=zroot
export ZFSBOOT_BEROOT_NAME=ROOT
export ZFSBOOT_BOOTFS_NAME=default
export ZFSBOOT_VDEV_TYPE=stripe
export ZFSBOOT_PARTITION_SCHEME=GPT
export ZFSBOOT_BOOT_TYPE=BIOS+UEFI
export ZFSBOOT_SWAP_SIZE=4g
# Candidate disks: never the boot media (memstick, ISO, Ventoy stick).
disks=$(/usr/local/libexec/wolos/install-disks)
if [ -n "${WOLOS_INSTALL_DISK:-}" ]; then
  # Install WolOS app (libexec/wolos/install-run): the disk was chosen and confirmed there.
  # Progress for the app on stdout: "wolos-install: <stage> <percent> <message>".
  wolos_step=prepare
  # A stop reports one line instead of the log in a dialog box, unmounts and lets the pool go
  # (Try Again starts clean). Replaces bsdinstall's error(): its EXIT trap calls it by name.
  error() {
    echo "wolos-install: failed 0 $wolos_step: ${1:-a step failed}"
    [ -f "$PATH_FSTAB" ] || exit 1
    command bsdinstall umount || :
    zpool export -f "$ZFSBOOT_POOL_NAME" || :
    exit 1
  }
  # Each bsdinstall step reports its stage first (this function shadows the command).
  bsdinstall() {
    case $1 in
      zfsboot) wolos_step=disk
        echo "wolos-install: disk 2 Erasing $ZFSBOOT_DISKS: GPT, EFI and BIOS boot, ZFS pool $ZFSBOOT_POOL_NAME" ;;
      checksum) wolos_step=files; echo "wolos-install: files 5 Checking the system files" ;;
      distextract) echo "wolos-install: files 6 Copying the system" ;;
      bootconfig) wolos_step=boot; echo "wolos-install: boot 22 Installing the boot loader" ;;
      config) wolos_step=settings; echo "wolos-install: settings 24 Writing the system settings" ;;
      entropy) wolos_step=finish; echo "wolos-install: finish 97 Finishing up" ;;
    esac
    command bsdinstall "$@"
  }
  echo "$disks" | grep -qx -- "$WOLOS_INSTALL_DISK" || error "not a disk the installer may erase"
  ZFSBOOT_DISKS=$WOLOS_INSTALL_DISK
else
  items=
  for d in $(echo "$disks" | sort); do   # by name: the first item is the first disk (vtbd0, nda0)
    items="$items $d \"$(geom disk list "$d" | awk -F': ' '/descr/{print $2; exit}') $(($(diskinfo "$d" | awk '{print $3}') / 1073741824))G\""
  done
  # bsdinstall script sends stdout/stderr to its log: draw on the console tty, capture the choice from fd 2.
  T=/dev/tty; { : >/dev/tty; } 2>/dev/null || T=/dev/console
  ZFSBOOT_DISKS=$(eval "bsddialog --title 'WolOS install' --menu 'Erase and install on:' 15 60 6 $items" 2>&1 >"$T" <"$T") || { echo cancelled; exit 1; }
  bsddialog --yesno "ALL DATA on $ZFSBOOT_DISKS will be erased. Continue?" 7 60 >$T 2>&1 <$T || exit 1
fi
export ZFSBOOT_DISKS

#!/bin/sh
# Runs chrooted in the new system.
# pkg scripts need devfs. Inside a chroot, 'umount /dev' resolves to the INSTALLER's /dev
# ("Device busy"; -f kills the console), so unmount ours by its fsid (mount -v), new after mounting.
devfs_ids() { mount -v | awk '$4=="(devfs," {gsub(",","",$6); print $6}' | sort; }
before=$(devfs_ids); mount -t devfs devfs /dev; DEVFS_ID=$(devfs_ids | grep -vxF "$before")
# \EFI\WolOS\loader.efi + firmware entry "WolOS" first, on the picked disk's own ESP only.
/usr/local/libexec/wolos/install-esp "$ZFSBOOT_DISKS" || echo "WOLOS: install-esp failed (BOOTX64.EFI still boots)"
# Console = this script's stdout: one progress line; full pkg output in the log. For the Install
# WolOS app (WOLOS_INSTALL_DISK set): "wolos-install: packages <percent> ..." lines instead.
[ -n "${WOLOS_INSTALL_DISK:-}" ] || printf '\033[2J\033[H\n  Installing WolOS...\n'
{ /usr/local/libexec/wolos/install-pkgs; echo "install-pkgs rc=$?"; } 2>&1 | tee /var/log/wolos-install-pkgs.log |
  awk -v app="${WOLOS_INSTALL_DISK:-}" '
       $2=="Installing" && $1 ~ /^\[[0-9]+\/[1-9][0-9]*\]$/ { gsub(/[][]/, "", $1); split($1, nm, "/")
         if (app != "") printf "wolos-install: packages %d Installing apps (%d of %d)\n", 25 + int(70 * nm[1] / nm[2]), nm[1], nm[2]
         else printf "\r  Installing WolOS... (%s)   ", $1
         fflush() }
       END { if (app != "") print "wolos-install: finish 95 Setting up the new system"; else printf "\r  Installing WolOS... done            \n" }'
grep -q '^install-pkgs rc=0$' /var/log/wolos-install-pkgs.log || echo "WOLOS: install-pkgs FAILED (firstboot retries from the local repo)"
if ! umount "$DEVFS_ID" 2>/dev/null; then
  # A package script left a process holding the target devfs: log and stop it, then retry.
  { echo "devfs busy, holders:"; fstat -f /dev; } >> /var/log/wolos-install-pkgs.log 2>&1
  pids=$(fstat -f /dev 2>/dev/null | awk -v me=$$ 'NR>1 && $3!=me {print $3}' | sort -u)
  [ -n "$pids" ] && kill $pids 2>/dev/null; sleep 2
  umount "$DEVFS_ID" || echo "WOLOS: could not unmount the target devfs ($DEVFS_ID)"
fi
cat /boot/loader.conf.wolos >> /boot/loader.conf
# Console: WolOS getty banner; ttyv0 belongs to the login window (wol-login writes a WolOS notice there
# when it cannot start), recovery getty stays on ttyv1+.
sed -i '' 's|:im=\\r\\n%s/%m (%h) (%t)\\r\\n\\r\\n:|:im=\\r\\nWolOS (%h) (%t)\\r\\n\\r\\n:|' /etc/gettytab
grep -q 'WolOS (%h)' /etc/gettytab || echo "WOLOS: gettytab banner not patched"
sed -i '' -E 's|^(ttyv0[[:space:]].*[[:space:]])on(ifexists)?([[:space:]])|\1off\3|' /etc/ttys
for kv in dbus_enable=YES seatd_enable=YES linux_enable=YES wold_enable=YES \
          wolos_firstboot_enable=YES ntpd_enable=YES ntpd_sync_on_start=YES \
          sendmail_enable=NONE clear_tmp_enable=YES zfs_enable=YES hostname=wolos \
          cupsd_enable=YES avahi_daemon_enable=YES autofs_enable=YES \
          pf_enable=YES pf_rules=/usr/local/share/wolos/pf.conf syslogd_flags=-ss; do
  sysrc "$kv"
done
sysrc ifconfig_DEFAULT="SYNCDHCP"
# USB sticks under /media, writable for WolOS accounts (/etc/autofs/special_wolmedia).
grep -q '^/media' /etc/auto_master || printf '/media\t\t-wolmedia\t-nosuid,noatime\n' >> /etc/auto_master
sysrc osrelease_enable=NO   # /etc/os-release is the WolOS file from wolos.txz
touch /firstboot
bectl create -r install-base 2>/dev/null || :
