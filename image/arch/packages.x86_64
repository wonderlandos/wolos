# WolOS live + installed system. The desktop list is desktop/packages.txt; image/build.sh merges both.
# wolos-base (ADR 0017, [wolos]): Arch base + linux-wolos (+ headers for DKMS such as nvidia-open-dkms)
# + uutils coreutils, sudo-rs, bsdtar, zsh, systemd and the wol tools, at one release version.
wolos-base
wolos-mirrorlist
linux-firmware
intel-ucode
amd-ucode
sof-firmware
mkinitcpio
mkinitcpio-archiso
plymouth
# Installer and A/B slots: systemd-repart and systemd-boot (in systemd) with btrfs-progs and
# dosfstools for the file systems, unsquash of the live root.
arch-install-scripts
btrfs-progs
dosfstools
squashfs-tools
efibootmgr
pacman-contrib
# Hardware and networking.
networkmanager
iwd
wireless-regdb
bluez
bluez-utils
nftables
pciutils
usbutils
dkms
# Swap in compressed RAM (usr/lib/systemd/zram-generator.conf).
zram-generator
less
man-db
