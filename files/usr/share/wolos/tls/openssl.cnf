# SPDX-License-Identifier: GPL-2.0-or-later
# The WolOS TLS policy for every program that uses the system OpenSSL (ADR 0055): curl and so
# pacman, systemd-resolved's DNS over TLS, wget, Python, Ruby, git over https, our scripts.
# /usr/lib/wolos/tls-policy points /etc/ssl/openssl.cnf here (an `ssl_conf` line in its
# [openssl_init] and an `.include` of this file); nothing else in that file is changed.
# Checked by crates/controller/tests/image_tls.rs. Programs may still ask for less on their own.

[wolos_ssl_conf]
system_default = wolos_tls_policy

[wolos_tls_policy]
# TLS 1.3 first, 1.2 at least: TLS 1.0 and 1.1 and every SSL version are refused.
MinProtocol = TLSv1.2
# The hybrid post-quantum group first, X25519 right after it. `*` sends a key share for both in the
# first message, so a server with the hybrid group takes it and one without it answers with X25519
# at no extra round trip. ML-KEM is never offered alone; the classical curves stay for old servers.
Groups = *X25519MLKEM768:*X25519:secp256r1:secp384r1
# TLS 1.3 suites: AEAD only (this is OpenSSL's default set, written down so it cannot drift).
Ciphersuites = TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256
# TLS 1.2 suites: ephemeral elliptic-curve key exchange with an AEAD cipher, nothing else (no CBC,
# no RSA key transport, no finite-field DH, no SHA-1 MAC).
CipherString = ECDHE+AESGCM:ECDHE+CHACHA20:!aNULL:!eNULL:@SECLEVEL=2
# No renegotiation of a TLS 1.2 session, in either direction.
Options = NoRenegotiation
