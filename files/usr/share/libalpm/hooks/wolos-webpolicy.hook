# Web policy, track 1 (docs/modules/webapps.md): re-apply the byte patches of the shipped
# policies whenever a patched file or a policy plan is installed or upgraded. Generated by
# wol_core::webpolicy::hook; a refused patch is reported and the file left as packaged.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/share/wolos/webpolicy/*.plan

[Action]
Description = Applying WolOS web-app policies...
When = PostTransaction
Exec = /usr/lib/wolos/webpolicy
