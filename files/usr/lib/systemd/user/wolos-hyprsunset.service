# Night Light (wol_core::toggles): hyprsunset tints the screen, warm at start when Night Light was
# left on, identity otherwise; `hyprctl hyprsunset` drives it.
[Unit]
Description=WolOS Night Light (hyprsunset)
PartOf=wolos-session.target
After=wolos-session.target
# A helper that cannot reach the display any more (the session ended) stops retrying after 5 tries.
StartLimitIntervalSec=60
StartLimitBurst=5
ConditionPathExists=/usr/bin/hyprsunset

[Service]
ExecStart=/usr/lib/wolos/hyprsunset-run
StandardOutput=null
Restart=on-failure
RestartSec=2
