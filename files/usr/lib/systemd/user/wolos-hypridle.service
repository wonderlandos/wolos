# Idle lock, lock before sleep, display off, battery sleep (hypridle). The account's own
# config (System Settings > Lock & Idle) wins over the system default; not on the live medium.
[Unit]
Description=WolOS idle and sleep lock (hypridle)
PartOf=wolos-session.target
After=wolos-session.target
# A helper that cannot reach the display any more (the session ended) stops retrying after 5 tries.
StartLimitIntervalSec=60
StartLimitBurst=5
ConditionPathExists=!/etc/wolos-live

[Service]
ExecStart=/usr/lib/wolos/hypridle-run
Restart=on-failure
RestartSec=2
