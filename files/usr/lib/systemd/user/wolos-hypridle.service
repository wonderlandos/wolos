# Idle lock, lock before sleep, display off, battery sleep (hypridle). The account's own
# config (System Settings > Lock & Idle) wins over the system default; not on the live medium.
[Unit]
Description=WolOS idle and sleep lock (hypridle)
PartOf=wolos-session.target
After=wolos-session.target
# A crash burst never leaves it dead (RH-221): restarts slow down to one every 30 s instead of a
# start limit, and the unit stops with the session (PartOf).
StartLimitIntervalSec=0
ConditionPathExists=!/etc/wolos-live

[Service]
# oomd ranks every descendant of user@.service: the session cannot lose this one (QA-A7-12).
ManagedOOMPreference=omit
ExecStart=/usr/lib/wolos/hypridle-run
Restart=on-failure
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
