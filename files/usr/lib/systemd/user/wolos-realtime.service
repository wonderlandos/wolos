# wol-realtime: the session's foreground QoS and GPU helper.
[Unit]
Description=WolOS realtime helper (wol-realtime)
PartOf=wolos-session.target
After=wolos-session.target
# A crash burst never leaves it dead (RH-221): restarts slow down to one every 30 s instead of a
# start limit, and the unit stops with the session (PartOf).
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/wol-realtime
StandardOutput=null
Restart=on-failure
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
