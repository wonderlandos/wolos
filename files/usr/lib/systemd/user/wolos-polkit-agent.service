# The password dialog for programs that ask polkit (pkexec, Files, disks).
[Unit]
Description=WolOS polkit authentication agent
PartOf=wolos-session.target
After=wolos-session.target
# A crash burst never leaves it dead (RH-221): restarts slow down to one every 30 s instead of a
# start limit, and the unit stops with the session (PartOf).
StartLimitIntervalSec=0
ConditionPathExists=/usr/bin/lxqt-policykit-agent

[Service]
ExecStart=/usr/bin/lxqt-policykit-agent
Restart=on-failure
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
