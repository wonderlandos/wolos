# The full signature engine starts when something asks (ADR 0028), and only once the person fetched the signatures.
[Unit]
Description=WolOS full malware check, on demand
# The engine's own condition (wolos-clam.service, QA-ACC-25): no socket to wait on where it never starts.
ConditionMemory=>=5G

[Socket]
ListenStream=/run/wolos/clam.sock
SocketMode=0666

[Install]
WantedBy=sockets.target
