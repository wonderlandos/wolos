[Unit]
Description=Let the security chip unlock the disk again after a start it refused
Documentation=file:///usr/share/doc/wolos/modules/security.md
# Only after a start where the password or recovery key was typed: systemd-cryptsetup caches it in
# root's user keyring ("cryptsetup", about 150 s). `wol encrypt reseal` finds nothing otherwise, and
# exits 0 on a passphrase-only install (no `tpm2-device` in rd.luks.options): the PCR public key is no
# marker for that (a TPM disk without Secure Boot has none), so the command line decides, in the binary.
ConditionKernelCommandLine=rd.luks.name
# Not after a start the firmware did not measure (see wolos-tpm-bind.service): sealing to that
# state would make the next good start ask again.
ConditionSecurity=measured-uki
After=cryptsetup.target local-fs.target wolos-tpm-bind.service
Before=wolos-boot-ok.service

[Service]
Type=oneshot
ExecStart=/usr/bin/wol encrypt reseal
# The cached secret is a key of root's user keyring that only its possessor may read (the
# kernel's default for a key systemd-cryptsetup adds: anyone else of the same uid may only see
# it). A service gets a session keyring of its own (KeyringMode=private, systemd's default),
# not linked to root's user keyring: the search finds the key and the read is refused, so the
# reseal did nothing at every start the chip refused (QA-BOOT-1). shared links it in.
KeyringMode=shared
# Hardening (audit A7/B5, crates/controller/tests/units.rs): systemd-cryptenroll writes the LUKS header and talks to the TPM device; udev over netlink.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ProtectKernelLogs=yes
ProtectHostname=yes
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
