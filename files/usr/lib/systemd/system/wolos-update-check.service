[Unit]
Description=WolOS daily update check (looks only)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/wolos/update-check
# A oneshot has no start timeout of its own: a hung check would hold the unit, and the hourly
# timer would never start it again until a restart (audit8 stability2 #5).
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
# Hardening (audit A7/B5, crates/controller/tests/units.rs): network fetcher: writes only its state directory; checkupdates and pacman -Qq read the package database; pacman -Sy on the copy drops to its download user (setuid/setgid, chown of the download folder), so the same capabilities as wolos-update-download (audit S10).
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
StateDirectory=wolos/updates
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
