# The first-use malware check (ADR 0024). Holds one kernel mark on /home, /tmp and removable disks;
# anything it cannot do, it allows.
[Unit]
Description=WolOS first-use malware check
After=local-fs.target
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target

[Service]
ExecStart=/usr/bin/wol-xguard guard
Restart=on-failure
RestartSec=2
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER
NoNewPrivileges=yes
# No option here may give it a mount namespace (ProtectSystem, PrivateTmp, PrivateNetwork...): kernel
# marks hold on mounts, and in a namespace of its own it would watch copies nobody else uses.
RuntimeDirectory=wolos
RuntimeDirectoryPreserve=yes
# Keeps it off the network, in place of PrivateNetwork.
RestrictAddressFamilies=AF_UNIX
MemoryMax=512M
# Hardening (audit A7/B5, crates/controller/tests/units.rs): fanotify (CAP_SYS_ADMIN) on every mount and reads every home: no mount namespace (no Protect*/Private* that makes one, crates/xguard/tests/units.rs); AF_UNIX only already set.
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ProtectHostname=yes
# No MemoryDenyWriteExecute: the deep scan it forks (wol-xguard scan) inherits the filter, and
# YARA-X turns its rules into machine code at load time (wasmtime), which the filter forbids (audit S4).

[Install]
WantedBy=multi-user.target
