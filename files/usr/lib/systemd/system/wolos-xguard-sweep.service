# The background malware pass (ADR 0024): lowest priority, stops by itself on any activity.
[Unit]
Description=WolOS background malware check
ConditionACPower=true

[Service]
Type=oneshot
ExecStart=/usr/bin/wol-xguard sweep
User=_xguard
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
# Reads every home, writes none (audit P6-2): only the state directory below is writable.
ProtectHome=read-only
ReadWritePaths=/var/lib/wolos/xguard
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
OOMScoreAdjust=300
MemoryHigh=512M
