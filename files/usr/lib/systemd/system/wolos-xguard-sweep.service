# The background malware pass (ADR 0024): lowest priority, stops by itself on any activity.
[Unit]
Description=WolOS background malware check
ConditionACPower=true
# Its findings go to the guard over the guard's socket: running after it, the socket is there.
After=wolos-xguard.service

[Service]
Type=oneshot
ExecStart=/usr/bin/wol-xguard sweep
User=_xguard
# CAP_DAC_READ_SEARCH reads every home; nothing else. Each account's findings list (sweep-<uid>.json,
# 0600, owned by the account) is handed to the guard over its socket (verb `findings`), and the guard,
# as root, writes it in its own folder: this pass gives no file to anyone, so no CAP_CHOWN (audit
# R7-1, DT-6). The socket is reachable from here: a socket on a read-only mount still connects, and
# a socket on a path is not bound to the network namespace.
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
# Reads every home, writes none (audit P6-2): only its own folder below (its memory) is writable,
# not the guard's (audit F10).
ProtectHome=read-only
ReadWritePaths=/var/lib/wolos/xguard/sweep
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
OOMScoreAdjust=300
MemoryHigh=512M
