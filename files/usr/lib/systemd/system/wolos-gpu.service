[Unit]
Description=WolOS GPU: panel brightness once the display driver is up
After=wolos-hw.service
Before=wold.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/wolos/gpu
# Hardening (audit A7/B5, crates/controller/tests/units.rs): writes /sys/class/backlight only (ProtectSystem leaves /sys writable; uid 0 owns the files, so no capability is needed).
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
