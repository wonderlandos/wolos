[Unit]
Description=WolOS error reports (sent only when turned on in Settings)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/wolos/report
Nice=10
IOSchedulingClass=idle
# Hardening (audit A7/B5, crates/controller/tests/units.rs): network sender: reads systemctl and the journal over AF_UNIX, writes only its state directory.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
StateDirectory=wolos/reports
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
