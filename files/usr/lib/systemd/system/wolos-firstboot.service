[Unit]
Description=WolOS first boot: drivers only the internet has (NVIDIA), once
ConditionPathExists=!/var/lib/wolos/firstboot-done
After=wolos-hw.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/wolos/firstboot
# Longer than wol hw boot's own bound on pacman (25 min + 30 s, QA-SYS-6): the unit never kills
# pacman mid-transaction, which left its lock and the drivers half installed.
TimeoutStartSec=30min
# Hardening (audit A7/B5, crates/controller/tests/units.rs): installs drivers with pacman (network, setuid download user, DKMS, modprobe, initramfs): only restrictions pacman and its hooks never need.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ProtectHome=yes
ProtectKernelLogs=yes
ProtectHostname=yes

[Install]
WantedBy=multi-user.target
