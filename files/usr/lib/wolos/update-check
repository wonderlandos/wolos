#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Daily update check (wolos-update-check.timer, wol_core::update::check). The timer runs it hourly;
# it checks at most once every 20 hours, so a computer asleep at night still checks once a day.
# `update-check now` checks regardless. It only looks: installing is Software Update (wol update).
# Findings in $D, readable by every account (the shell notifies from them):
#   pkg      packages with a newer version at the pinned snapshot and in [wolos] (checkupdates)
#   audit    installed packages with a known vulnerability (arch-audit -q)
#   kernels  installed package names (pacman -Qq): kernels besides linux-wolos are reported
#   base     the latest release manifest; base.sig its signature in hex (verified when read)
#   checked  when the check finished (seconds since 1970)
# It also refreshes the certificate revocation list (ADR 0046): revoked.json and its .wsig from the
# hub's CDN, handed to `wol trust update`, which installs them in /var/lib/wolos/trust only when the
# signature verifies against the image's roots and the list is newer than the one held.
set -u
D=${WOLOS_UPDATES:-/var/lib/wolos/updates}
URL=${WOLOS_RELEASE_URL:-https://github.com/wonderlandos/wolos-packages/releases/latest/download/release.json}
REVOKED_URL=${WOLOS_REVOKED_URL:-https://cdn.wolos.org/plugins/revoked.json}
EVERY=72000
now=$(date +%s)
last=$(cat "$D/checked" 2>/dev/null)
case $last in '' | *[!0-9]*) last=0 ;; esac
# A stamp from the future (the clock was ahead when it was written) is stale, not fresh (C9-5).
[ "$last" -le "$now" ] || last=0
[ "${1:-}" = now ] || [ $((now - last)) -ge $EVERY ] || exit 0
umask 022
mkdir -p "$D" || exit 1
# checkupdates: 0 updates listed, 2 none; anything else (offline) leaves no stamp: the next hour tries.
checkupdates --nocolor >"$D/pkg.new" 2>/dev/null
case $? in
0 | 2) mv "$D/pkg.new" "$D/pkg" ;;
*) rm -f "$D/pkg.new"; exit 0 ;;
esac
# Exit 1 also means "found some"; an empty list from a failed run keeps the last one. Without
# arch-audit there is no list at all (not an empty one: that would read "no known vulnerabilities").
if command -v arch-audit >/dev/null 2>&1; then
	arch-audit -q >"$D/audit.new" 2>/dev/null
	st=$?
	if [ $st -eq 0 ] || [ -s "$D/audit.new" ]; then mv "$D/audit.new" "$D/audit"; else rm -f "$D/audit.new"; fi
else
	echo "update-check: arch-audit is not installed: no vulnerability list" >&2
	rm -f "$D/audit"
fi
pacman -Qq >"$D/kernels" 2>/dev/null
if curl -fsSL -o "$D/base.new" "$URL" 2>/dev/null &&
	curl -fsSL "$URL.sig" 2>/dev/null | od -An -v -tx1 | tr -d " \n" >"$D/base.sig.new" &&
	[ -s "$D/base.sig.new" ]; then
	mv "$D/base.new" "$D/base"
	mv "$D/base.sig.new" "$D/base.sig"
else
	rm -f "$D/base.new" "$D/base.sig.new"
fi
# HTTPS only, no redirect to another scheme, at most 1 MiB and 64 KiB, 60 s each.
T=$(mktemp -d) || T=
# shellcheck disable=SC2064 # $T is fixed now: expand it when the trap is set, on purpose
trap "[ -z '$T' ] || { rm -f '$T/revoked.json' '$T/revoked.json.wsig'; rmdir '$T' 2>/dev/null; }" EXIT
if [ -n "$T" ]; then
	if curl -fsSL --proto =https --proto-redir =https --max-filesize 1048576 --max-time 60 -o "$T/revoked.json" "$REVOKED_URL" 2>/dev/null &&
		curl -fsSL --proto =https --proto-redir =https --max-filesize 65536 --max-time 60 -o "$T/revoked.json.wsig" "$REVOKED_URL.wsig" 2>/dev/null; then
		mkdir -p /var/lib/wolos/trust
		wol trust update "$T/revoked.json" "$T/revoked.json.wsig" >/dev/null 2>&1 ||
			echo "update-check: the downloaded revocation list was not installed (not newer, or it does not verify)" >&2
	fi
fi
date +%s >"$D/checked"
chmod 644 "$D/pkg" "$D/checked"
chmod 644 "$D/audit" "$D/kernels" "$D/base" "$D/base.sig" 2>/dev/null
exit 0
