#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Build this slot's kernels into signed boot images on the ESP and write their entries (ADR 0025).
# Pacman hook 95-wolos-esp after a kernel or initramfs change; the installer and updates with --new.
#   linux-wolos  -> EFI/wolos/wolos-<slot>.efi, entry wolos-<slot>[+tries].conf: counted, sorted by
#                   generation so the newest good slot boots and a bad one falls behind the other.
#                   Its fallback entry wolos-<slot>-fallback[+tries].conf starts the same image with
#                   the same counter, sorted last (QA-BOOT-13): a lost entry is not a dead end.
#   other kernel -> EFI/wolos/wolos-<slot>-<pkgbase>.efi, entry wolos-<slot>-<pkgbase>.conf.
# One image holds kernel, initramfs and command line, so one signature covers all three. Image names
# never change: another boot manager (rEFInd, GRUB) points at them; the counter stays on the entry.
# A changed image (kernel, initramfs or command line: QA-SYS-11) gets three tries again, as a new
# slot does: the entry name goes back to +3. Every file is on the disk before its name moves and
# the whole ESP before the end (QA-F7: FAT, a power cut after "updated" left empty images).
# Each image's digest stays next to it (<slot>/image.sha256): a good boot of the other slot
# checks it (`wol boot bless`, QA-LIVE4-4).
# Env: WOLOS_ROOT (slot root), WOLOS_ESP (/efi), WOLOS_SLOT (wolos-a), WOLOS_CMDLINE, WOLOS_RELEASE,
#      WOLOS_SB_DIR (keys, see boot-keys), WOLOS_SLOTS (/run/wolos/slots.json).
set -eu
R=${WOLOS_ROOT:-}
new=${1:-}
ESP=${WOLOS_ESP:-/efi}
# A chroot has no ESP (a pacman run inside an update): the update builds the image itself.
[ -n "${WOLOS_ESP:-}" ] || mountpoint -q /efi || exit 0
slot=${WOLOS_SLOT:-}
if [ -z "$slot" ] && [ -z "$R" ] && [ -r /proc/cmdline ]; then
  slot=$(sed -n 's/.*subvol=\/*@\(wolos-[ab]\).*/\1/p' /proc/cmdline)
fi
if [ -z "$slot" ]; then
  [ -f "$R/etc/wolos/slot" ] || exit 0    # live system: no slot, nothing to sync
  slot=wolos-$(cat "$R/etc/wolos/slot")
fi
opts=${WOLOS_CMDLINE:-$(sed "s/subvol=@wolos-[ab]/subvol=@$slot/" "$R/etc/kernel/cmdline")}
ver=$(cat "$R/usr/share/wolos/base.version" 2>/dev/null || :)
rel=$(printf '%s' "${WOLOS_RELEASE:-${ver:-current}}" | tr / .)
S=${WOLOS_SB_DIR:-/var/lib/wolos/secureboot}
E=$ESP/loader/entries; D=$ESP/EFI/wolos; old=$ESP/$slot
here=$(cd "$(dirname "$0")" && pwd)
mkdir -p "$E" "$D" "$old"
# What an earlier run cut off left (BOOT2-7): this slot's half-written files only.
rm -f "$D/$slot".efi.new "$D/$slot"-*.efi.new "$E/$slot".conf.new "$E/$slot"+*.conf.new "$E/$slot"-*.conf.new \
  "$old/image.sha256.new" "$old/image.inputs.new"

# The newest generation on the ESP; a new slot goes one above it, so it sorts first.
top=0
for f in "$E"/wolos-[ab]*.conf; do
  [ -f "$f" ] || continue
  g=$(sed -n 's/^version \([0-9]*\)-.*/\1/p' "$f"); [ -n "$g" ] || continue
  [ "$g" -le "$top" ] || top=$g
done
cur=
for f in "$E/$slot".conf "$E/$slot"+*.conf; do
  [ -f "$f" ] || continue
  printf '%s\n' "${f##*/}" | grep -qE "^$slot(\+[0-9]+(-[0-9]+)?)?\.conf$" || continue
  cur=${f##*/}; break
done
gen=$((top + 1))
if [ "$new" != --new ] && [ -n "$cur" ]; then
  g=$(sed -n 's/^version \([0-9]*\)-.*/\1/p' "$E/$cur"); [ -z "$g" ] || gen=$g
elif [ "$new" != --new ]; then
  # The slot's entry is lost: its fallback entry keeps the generation (QA-BOOT-13).
  for f in "$E/$slot"-fallback.conf "$E/$slot"-fallback+*.conf; do
    [ -f "$f" ] || continue
    g=$(sed -n 's/^version \([0-9]*\)-.*/\1/p' "$f"); [ -z "$g" ] || { gen=$g; break; }
  done
fi

words="$opts wolos.epoch=$gen"
[ ! -s "$S/cmdline" ] || words="$words $(cat "$S/cmdline")"
[ ! -r "$old/verity" ] || words="$words wolos.seal=$(cat "$old/verity")"

K=
if [ -f "$S/db.crt" ]; then
  K=$(WOLOS_SB_DIR=$S sh "$here/boot-keys" open)
  trap 'WOLOS_SB_DIR=$S sh "$here/boot-keys" close' EXIT
fi

drop=
for k in "$R"/boot/vmlinuz-*; do
  [ -f "$k" ] || continue
  kb=${k##*/vmlinuz-}
  if [ "$kb" = linux-wolos ]; then
    title="WolOS${ver:+ $ver}"; key=wolos; img=$slot
    # What goes into the image; a change means a kernel this entry has not started yet. No record
    # (an image from before it): kept as it is, recorded now.
    inputs=$({ cat "$k" "$R/boot/initramfs-$kb.img" 2>/dev/null; printf '%s' "$words"; } | sha256sum | cut -d' ' -f1)
    was=$(cat "$old/image.inputs" 2>/dev/null || :)
    if [ "$new" = --new ] || [ -z "$cur" ] || { [ -n "$was" ] && [ "$was" != "$inputs" ]; }; then
      drop=$cur   # removed once the new entry is on the disk: never a moment with none
      name=$slot+3.conf
    else
      name=$cur
    fi
  else
    title="WolOS ($kb)"; key=wolos-$kb; img=$slot-$kb; name=$slot-$kb.conf
  fi
  set -- --linux="$k" --cmdline="$words" --os-release="@$R/usr/lib/os-release" --output="$D/$img.efi.new"
  [ ! -f "$R/boot/initramfs-$kb.img" ] || set -- "$@" --initrd="$R/boot/initramfs-$kb.img"
  [ ! -f "$R/usr/share/wolos/boot/splash.bmp" ] || set -- "$@" --splash="$R/usr/share/wolos/boot/splash.bmp"
  if [ -n "$K" ]; then
    set -- "$@" --signtool=systemd-sbsign --no-sign-kernel --secureboot-private-key="$K/db.key" --secureboot-certificate="$S/db.crt" \
      --pcr-private-key="$K/tpm2-pcr-private.pem" --pcr-public-key="$S/tpm2-pcr-public.pem" --phases=enter-initrd
  fi
  ukify build "$@" >/dev/null
  sync "$D/$img.efi.new"
  mv -f "$D/$img.efi.new" "$D/$img.efi"
  # The image under its name on the disk before an entry names it (QA-LIVE4-7: FAT renames are
  # directory writes a file's own sync does not cover).
  sync -f "$ESP/"
  if [ "$kb" = linux-wolos ]; then
    # Whole or not at all: boot-ok, boot-rearm and `wol boot bless` compare against them.
    sha256sum "$D/$img.efi" | cut -d' ' -f1 > "$old/image.sha256.new"
    printf '%s\n' "$inputs" > "$old/image.inputs.new"
    sync "$old/image.sha256.new" "$old/image.inputs.new"
    mv -f "$old/image.sha256.new" "$old/image.sha256"
    mv -f "$old/image.inputs.new" "$old/image.inputs"
  fi
  {
    echo "title $title"
    echo "sort-key $key"
    echo "version $gen-$rel"
    echo "uki /EFI/wolos/$img.efi"
  } > "$E/$name.new"
  sync "$E/$name.new"
  mv -f "$E/$name.new" "$E/$name"
  if [ -n "$drop" ] && [ "$drop" != "$name" ]; then
    sync -f "$ESP/"
    rm -f "$E/$drop"
  fi
  drop=
  if [ "$kb" = linux-wolos ]; then
    # The fallback entry (QA-BOOT-13, ADR 0025): the same image and the same try counter, sorted
    # after every slot entry, so a lost or garbled entry still leaves something to start, and a
    # slot the counter gave up on is given up on in its fallback too. Written once the slot's
    # entry is on the disk: a cut damages at most one of the two.
    sync -f "$ESP/"
    c=${name#"$slot"}; c=${c%.conf}
    fb="$slot-fallback$c.conf"
    {
      echo "title $title (fallback entry)"
      echo "sort-key wolos.fallback"
      echo "version $gen-$rel"
      echo "uki /EFI/wolos/$img.efi"
    } > "$E/$fb.new"
    sync "$E/$fb.new"
    mv -f "$E/$fb.new" "$E/$fb"
    for f in "$E/$slot"-fallback.conf "$E/$slot"-fallback+*.conf; do
      [ -f "$f" ] && [ "${f##*/}" != "$fb" ] || continue
      sync -f "$ESP/"
      rm -f "$f"
    done
  fi
done
# The images replace the loose kernels of older systems.
rm -f "$old"/vmlinuz-* "$old"/initramfs-*
# Names, directories and the FAT itself on the disk before anyone says "updated" (QA-F7).
sync -f "$ESP/"
# The slot list for Settings > Restore and `wol restore`: they run as the person, who cannot read
# the ESP (fmask 0077), so their own `bootctl list` fails (QA-LIVE4-5, F5/F6). bootctl's JSON as
# it is, world-readable, replaced whole; a failed listing keeps the last good one.
L=${WOLOS_SLOTS:-/run/wolos/slots.json}
if list=$(bootctl --esp-path="$ESP" list --json=short 2>/dev/null) && [ -n "$list" ]; then
  if mkdir -p "${L%/*}" && printf '%s\n' "$list" > "$L.new" && chmod 0644 "$L.new"; then
    mv -f "$L.new" "$L" || :
  else
    rm -f "$L.new"
  fi
fi
