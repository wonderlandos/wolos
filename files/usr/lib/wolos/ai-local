#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Local AI module, user step (`post` of /usr/share/wolos/modules/ai-local.json, run as the person by
# `wol modules enable ai-local`, ADR 0032, docs/modules/modules.md): the module depends on `ollama`
# (CPU); this adds the GPU backend `wol hw compute --json` names (ollama-cuda, ollama-rocm or
# ollama-vulkan) through `wol install`, which asks wol-admind and so the administrator password.
# Idempotent: an installed backend, or `cpu`, needs nothing. Exit 0 when done, 1 when a step failed.
set -eu
json=$(wol hw compute --json)
backend=$(printf '%s\n' "$json" | sed -n 's/.*"backend": *"\([a-z]*\)".*/\1/p')
case "$backend" in
  cuda|rocm|vulkan) pkg="ollama-$backend" ;;
  cpu) exit 0 ;;
  *) echo "ai-local: unknown compute backend '$backend'" >&2; exit 1 ;;
esac
if pacman -Qq "$pkg" >/dev/null 2>&1; then
  exit 0
fi
wol install "$pkg"
