#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Install WolOS (ADR 0013, ADR 0016, ADR 0018): erase <disk> and install, as root (the live image
# lets its user run this with sudo, no password). GPT from repart.d via systemd-repart: ESP (1 GiB, /efi) + one btrfs partition with
# subvolumes @wolos-a (this system), @home and @var; the first update creates @wolos-b. The live
# root (airootfs.sfs) is copied into @wolos-a without the live-only files, and systemd-boot starts it
# with boot counting (three tries). boot-setup picks the Secure Boot tier and leaves the words for
# the person in WOLOS_BOOT_NOTE (ADR 0022).
# Progress on stdout, one line per step: "wolos-install: <stage> <percent> <message>", stages
# prepare 0, disk 5, files 15, keys 40, encrypt 45, initramfs 70 (the plan's language, keyboard
# and time zone go in first: the initramfs carries the console keymap), settings 90, seal 92,
# boot 95, done 100. A stop is one line "wolos-install: fail <stage> <message>": the reason, then the last
# lines of the log (one line, no pipes). Every tool's output goes to the log.
# Results (audit3 R2B-1): the log and the recovery key go to /run/wolos/install/ (WOLOS_RESULT_DIR),
# a folder this script makes anew, root's only (0700); never into the plan's folder, which belongs
# to the caller. The Install app reads them with `install-check --result`, which hands the key out
# once. The log is also copied to <target>/var/log/wolos-install.log when the install is done.
# Exit: 0 installed, 1 the install stopped, 2 nothing was written (not a disk the installer may erase,
# a plan the disk no longer matches, encryption that can't be set up).
# Encrypt disk: WOLOS_ENCRYPT=auto|yes|no|passphrase (default auto: on; the TPM2 unlocks it when
# there is one, else WOLOS_PASSPHRASE_FILE is needed). LUKS2 under btrfs; the recovery key is left
# once in the results folder (recovery-key, mode 600).
# The decisions are `wol encrypt ...` and `wol seal ...` (crates/core). The finished slot is sealed.
# --plan FILE (ADR 0023): the Install WolOS app's choices: Erase, Alongside or Manual, language, zone,
# account, host name, auto-login and swap. Next to FILE: disk-password and account-password (read,
# then removed; nothing is written there). Alongside and Manual partition through `wol install
# layout`, which never names a partition the plan doesn't. `wol install info` and `layout` answer
# in KEY=VALUE lines, read against the keys each may set: generated text never runs as shell
# (STANDARDS 2, audit3 R2B-14). The boot loader is `install-boot`; it learns from the plan whether
# the startup partition is shared and whether Windows stays (WOLOS_ESP_SHARED, WOLOS_WINDOWS,
# WOLOS_BITLOCKER; Windows on another disk of this computer counts too). Windows staying also keeps
# the hardware clock in local time (/etc/adjtime LOCAL, audit3 R2B-12).
# Without a plan (autoinstall) the same choices come from the environment: WOLOS_HOSTNAME (checked
# by `wol install hostname`, default wolos), WOLOS_AUTOLOGIN=yes|no, WOLOS_SWAP=none|zram|swapfile:<GiB> (default zram).
# Env (tests): WOLOS_INSTALL_PATH, WOLOS_INSTALL_ROOT (/mnt/wolos), WOLOS_SOURCE_SFS, WOLOS_NO_INHIBIT,
# WOLOS_RESULT_DIR, WOLOS_INSTALL_LOG.
set -u
PATH=${WOLOS_INSTALL_PATH:-/usr/bin:/usr/sbin}; export PATH
# Closing the lid or idling must not sleep the machine mid-install; the hold ends with the install.
# First of all: the run under the hold starts the results folder and the log afresh, so anything
# said before it would be lost (QA-DOC-22).
if [ "${WOLOS_NO_INHIBIT:-0}" != 1 ] && [ -z "${WOLOS_INHIBITED:-}" ] && command -v systemd-inhibit >/dev/null; then
  WOLOS_INHIBITED=1 exec systemd-inhibit --what=sleep:idle:handle-lid-switch --who="Install WolOS" \
    --why="Installing WolOS" "$0" "$@"
fi
# The results folder: whatever is at that name from an earlier run (or put there by anyone) goes,
# and this run makes its own, so nothing in it was decided by someone else. Not makeable (a test
# that is not root): a fresh private temp folder instead, said in the log.
R=${WOLOS_RESULT_DIR:-/run/wolos/install}
rm -rf "${R:?}"
made=$(mkdir -p "${R%/*}" 2>&1 && (umask 077 && mkdir "$R") 2>&1) || { R=$(mktemp -d); echo "results in $R: $made" >&2; }
# stdout is the progress protocol; everything the tools say goes to the log.
LOG=${WOLOS_INSTALL_LOG:-$R/log}
{ mkdir -p "$(dirname "$LOG")" && : > "$LOG"; } 2>/dev/null || LOG=$(mktemp)
exec 2>>"$LOG"
stage=prepare
say() { stage=$1; echo "wolos-install: $*"; echo "wolos-install: $*" >&2; }
# The log's last words, one line, no pipes: what really went wrong.
why() {
  tail -n 8 "$LOG" 2>/dev/null | grep -v '^wolos-install:' | tail -n 3 | tr -d '|' | tr '\n' ' ' |
    sed 's/  */ /g; s/ *$//' | cut -c1-400
}
plan=; plandir=
report() { # REASON: the fail line carries the reason and the real error
  w=$(why)
  say fail "$stage" "$*${w:+: $w}"
}
# Before any write: nothing to undo.
refuse() { report "$*"; exit 2; }
disk=${1:-}
here=$(cd "$(dirname "$0")" && pwd)
wipe=1
WOLOS_HOSTNAME=${WOLOS_HOSTNAME:-wolos}; WOLOS_AUTOLOGIN=${WOLOS_AUTOLOGIN:-no}; WOLOS_SWAP=${WOLOS_SWAP:-zram}
account=${WOLOS_ACCOUNT:-}
# Secure Boot wanted (the Install app's choice; boot-setup records it), the optional modules and the
# media formats the person ticked (ADR 0032; `wol install info` checks every id and package name).
WOLOS_SECURE=${WOLOS_SECURE:-yes}; modules=${WOLOS_MODULES:-}; extra_packages=
# What `wol install layout` says beyond the devices; an erase keeps none of it.
others=0 esp_reused=0 esp_wolos=0 windows=0 bitlocker=0
slots=two home_dev='' var_dev='' extra_fstab='' extra_crypttab=''
nl='
'
take() { # info|layout: KEY=VALUE lines on stdin (controller install.rs info_text, Applied::env)
  while IFS= read -r kv; do
    case $kv in *=*) ;; *) continue ;; esac
    k=${kv%%=*} v=${kv#*=}
    case $1:$k in
      info:disk) disk=$v ;;
      info:wipe) wipe=$v ;;
      info:WOLOS_ENCRYPT) WOLOS_ENCRYPT=$v ;;
      info:account) account=$v ;;
      info:WOLOS_HOSTNAME) WOLOS_HOSTNAME=$v ;;
      info:WOLOS_AUTOLOGIN) WOLOS_AUTOLOGIN=$v ;;
      info:WOLOS_SWAP) WOLOS_SWAP=$v ;;
      info:WOLOS_SECURE) WOLOS_SECURE=$v ;;
      info:modules) modules=$v ;;
      info:extra_packages) extra_packages=$v ;;
      layout:esp) esp=$v ;;
      layout:root) root=$v ;;
      layout:fsdev) fsdev=$v ;;
      layout:slots) slots=$v ;;
      layout:home_dev) home_dev=$v ;;
      layout:var_dev) var_dev=$v ;;
      layout:others) others=$v ;;
      layout:esp_reused) esp_reused=$v ;;
      layout:esp_wolos) esp_wolos=$v ;;
      layout:windows) windows=$v ;;
      layout:bitlocker) bitlocker=$v ;;
      layout:extra_fstab) extra_fstab=${extra_fstab:+$extra_fstab$nl}$v ;;
      layout:extra_crypttab) extra_crypttab=${extra_crypttab:+$extra_crypttab$nl}$v ;;
      *) echo "install-run: $1 said $k, which is not one of its keys" >&2 ;;
    esac
  done
}
if [ "$disk" = --plan ]; then
  plan=${2:-}
  plandir=$(dirname "$plan")
  # The plan's passwords leave with the run, whatever its end: done, fail or refuse (audit5 C9-6).
  trap 'rm -f "$plandir/account-password" "$plandir/disk-password"' EXIT
  info=$(wol install info "$plan") || refuse "the install plan can't be read"
  take info <<EOF
$info
EOF
  [ ! -s "$plandir/disk-password" ] || WOLOS_PASSPHRASE_FILE=$plandir/disk-password
  export WOLOS_ENCRYPT WOLOS_PASSPHRASE_FILE
fi
# The recovery key lands in the results folder only, whoever called (autoinstall too).
WOLOS_RECOVERY_OUT=$R/recovery-key; export WOLOS_RECOVERY_OUT
# The computer name: wol_core::settings::hostname, the rule Settings uses (audit3 R2B-18). A
# plan's name was checked by `wol install info` already; the environment's (autoinstall) here.
if [ -z "$plan" ]; then
  WOLOS_HOSTNAME=$(wol install hostname "$WOLOS_HOSTNAME") || WOLOS_HOSTNAME=
fi
[ -n "$WOLOS_HOSTNAME" ] || WOLOS_HOSTNAME=wolos
T=${WOLOS_INSTALL_ROOT:-/mnt/wolos}
SFS=${WOLOS_SOURCE_SFS:-/run/archiso/bootmnt/wolos/x86_64/airootfs.sfs}
# A try before this one may have left its volume open and its mounts in place: let them go first.
! mountpoint -q "$T" 2>/dev/null || umount -R "$T" || :
! mountpoint -q /run/wolos/install-look 2>/dev/null || umount /run/wolos/install-look || :
# Every volume a try opened goes: the system (wolosroot) and the extra ones `wol install layout`
# names wolos<folder>; a layout that stopped part way closes its own, this catches the rest.
for m in "${WOLOS_MAPPER_DIR:-/dev/mapper}"/wolos*; do
  [ ! -e "$m" ] || cryptsetup close "${m##*/}" || :
done
# Only a disk the installer lists at all; then its partitions mounted by the person (a USB disk
# opened in Files) go first, never the live medium's. install-check then sees the disk as it is.
if [ -z "$disk" ] || ! sh "$here/install-disks" | grep -qx -- "$disk"; then
  refuse "not a disk the installer may erase: ${disk:-none}"
fi
# `wol install mounts`: deepest first; a swap partition on it is switched off (umount can't).
wol install mounts "$disk" | while read -r what m; do
  case $what:$m in
    mount:/ | mount:/run/archiso*) ;;
    mount:*) umount "$m" ;;
    swap:*) swapoff "$m" ;;
  esac
done
# Every check before the first write: a refused disk is left exactly as it was.
facts=$(sh "$here/install-check" "$disk") || refuse "not a disk the installer may erase: $disk"
others=$(printf '%s\n' "$facts" | grep -c '^os ')
# Windows elsewhere on this computer (another disk) stays whatever happens here; its BitLocker
# measures the Secure Boot keys boot-setup may change (audit3 R2B-9). Read only.
elsewhere=no elsewhere_bitlocker=no
for o in $(sh "$here/install-disks"); do
  [ "$o" != "$disk" ] || continue
  f=$(sh "$here/install-check" "$o") || :
  case $nl$f$nl in *"${nl}os Windows$nl"*) elsewhere=yes ;; esac
  case $nl$f$nl in *"${nl}bitlocker yes$nl"*) elsewhere_bitlocker=yes ;; esac
done
# A plan is checked against the disk as it is now: if anything changed since the summary, nothing runs.
# The same check refuses what would otherwise fail after the erase (settings, account name, password).
if [ -n "$plan" ]; then
  verdict=$(wol install check "$plan") || refuse "the disk is not what the plan was made for${verdict:+ ($verdict)}"
fi
cleanup() {
  sync; umount -R "$T" 2>/dev/null || :
  # The extra encrypted volumes (crypttab names), then the system.
  for n in $(printf '%s\n' "${extra_crypttab:-}" | awk 'NF {print $1}'); do cryptsetup close "$n" 2>/dev/null || :; done
  [ "$unlock" = off ] || cryptsetup close wolosroot 2>/dev/null || :
  rm -rf "${KEYDIR:?}"
}
fail() { report "$*"; cleanup; exit 1; }
part() { case $disk in *[0-9]) echo "${disk}p$1" ;; *) echo "$disk$1" ;; esac; }
say prepare 0 "Preparing to install on $disk"
unlock=$(wol encrypt decide "${WOLOS_ENCRYPT:-auto}") || refuse "disk encryption: a passphrase of 8 or more characters is needed"
KEYDIR=${WOLOS_KEYDIR:-/run/wolos/install-keys}

# LUKS2: formatted with a throw-away random key (a file in RAM), replaced by the real ones below.
if [ "$unlock" != off ]; then
  (umask 077 && mkdir -p "$KEYDIR" && head -c 64 /dev/urandom > "$KEYDIR/key") || fail "could not make the disk key"
fi
if [ "$wipe" = 1 ]; then
  say disk 5 "Erasing $disk"
  # systemd-repart lays out the disk from repart.d (ESP + btrfs root with the slot subvolumes, ADR 0018).
  # The live system may still hold the old partitions (udev probing what a cut install left):
  # repart's first add then fails 'Device or resource busy' (QA-DOC-28). The kernel forgets them
  # and the old table goes first; a partition still busy gets one more try after a second.
  forget() {
    udevadm settle
    partx -d "$disk" >/dev/null 2>&1 || :
    wipefs -a -q "$disk" >/dev/null 2>&1 || :
    udevadm settle
  }
  repart() {
    forget
    systemd-repart --empty=force --dry-run=no --no-pager "$@" "$disk" >&2 && return 0
    sleep 1
    forget
    systemd-repart --empty=force --dry-run=no --no-pager "$@" "$disk" >&2
  }
  if [ "$unlock" = off ]; then
    repart --definitions="$here/repart.d" || fail "could not partition $disk"
  else
    repart --definitions="$here/repart.d-crypt" --key-file="$KEYDIR/key" || fail "could not partition $disk"
  fi
  udevadm settle
  esp=$(part 1); root=$(part 2); fsdev=$root
  # Erased: whatever install-check saw on the disk is gone, so no menu waits for it.
  others=0
  if [ "$unlock" != off ]; then
    cryptsetup open --key-file="$KEYDIR/key" "$root" wolosroot || fail "could not open the encrypted disk"
    fsdev=/dev/mapper/wolosroot
  fi
else
  # Exact sectors, a shrink, someone else's partitions alongside: step by step, table checked each time.
  say disk 5 "Changing the partitions on $disk"
  (umask 077 && mkdir -p "$KEYDIR") && wol install layout "$plan" "$KEYDIR/key" > "$KEYDIR/layout.env" ||
    fail "could not partition $disk"
  take layout < "$KEYDIR/layout.env"
fi
[ "$elsewhere" = no ] || windows=1
[ "$elsewhere_bitlocker" = no ] || bitlocker=1
# A UUID or nothing: an empty or odd answer (blkid's cache, a slow rescan) is asked again with a
# probe, then the install stops; `root=UUID=` with nothing after it would not start (audit5 C9-4).
uuid() {
  u=$(blkid -s UUID -o value "$1" 2>/dev/null)
  case $u in '' | *[!0-9A-Fa-f-]*) udevadm settle; u=$(blkid -p -s UUID -o value "$1" 2>/dev/null) ;; esac
  case $u in '' | *[!0-9A-Fa-f-]* | -* | *-) return 1 ;; esac
  echo "$u"
}
luuid=
if [ "$unlock" != off ]; then luuid=$(uuid "$root") || fail "could not read the new partitions ($root)"; fi
ruuid=$(uuid "$fsdev") || fail "could not read the new partitions ($fsdev)"
euuid=$(uuid "$esp") || fail "could not read the new partitions ($esp)"
O=compress=zstd:1,noatime
mkdir -p "$T"
if [ "$slots" = two ]; then
  mount -o "subvol=@wolos-a,$O" "$fsdev" "$T" || fail "could not mount @wolos-a"
  mkdir -p "$T/home" "$T/var" "$T/efi"
  [ -n "$home_dev" ] || mount -o "subvol=@home,$O" "$fsdev" "$T/home" || fail "could not mount the new system"
  [ -n "$var_dev" ] || mount -o "subvol=@var,$O" "$fsdev" "$T/var" || fail "could not mount the new system"
else
  mount "$fsdev" "$T" || fail "could not mount the new system"
  mkdir -p "$T/home" "$T/var" "$T/efi"
fi
[ -z "$var_dev" ] || mount "$var_dev" "$T/var" || fail "could not mount the new system"
# The homes' subvolume is capped at 85 % of the pool before any account exists, so no account can
# fill the share of the system (QA-LIVE-17, ADR 0023). Best effort: it never stops an install.
[ -n "$home_dev" ] || /usr/lib/wolos/home-quota "$T/home" >&2 || true
mount "$esp" "$T/efi" || fail "could not mount the new system"
# A startup partition another WolOS used. The WolOS this plan replaces gives its startup files up
# (`wol install layout` says esp_wolos=1 only when no WolOS system stays, audit3 R2B-5): they go
# before ours are written. Any other: esp-sync would overwrite its wolos-a image, so it stops here.
if [ "$wipe" != 1 ] && [ "$esp_wolos" = 1 ]; then
  rm -rf "$T/efi/EFI/wolos" "$T/efi/wolos-a" "$T/efi/wolos-b" && rm -f "$T"/efi/loader/entries/wolos-*.conf ||
    fail "could not clear the old WolOS startup files"
elif [ "$wipe" != 1 ] && [ -e "$T/efi/EFI/wolos/wolos-a.efi" ]; then
  fail "another WolOS already starts from this startup partition; choose a new one"
fi

say files 15 "Copying WolOS"
unsquashfs -f -d "$T" "$SFS" >&2 || fail "could not copy the system"
# Live-only files: the live account, its autologin and installer rights, archiso boot bits.
rm -rf "$T/etc/sysusers.d/wolos-live.conf" "$T/etc/tmpfiles.d/wolos-live.conf" "$T/etc/sudoers.d/wolos-live" \
  "$T/etc/wolos/login.json" "$T/etc/wolos-live" "$T/etc/mkinitcpio.conf.d/archiso.conf" \
  "$T/etc/systemd/system/pacman-init.service" "$T/etc/systemd/system/etc-pacman.d-gnupg.mount" \
  "$T/etc/systemd/system/multi-user.target.wants/pacman-init.service" \
  "$T/etc/systemd/system/wolos-autoinstall.service" "$T/etc/systemd/system/multi-user.target.wants/wolos-autoinstall.service" \
  "$T/etc/systemd/journald.conf.d/volatile-storage.conf" "$T/home/live" \
  "$T/etc/systemd/system/wold.service.d" "$T/etc/systemd/system/wolos-installer.service" \
  "$T/etc/systemd/system/multi-user.target.wants/wolos-installer.service" \
  "$T/etc/systemd/system/sshd.service.d/wolos-live.conf" "$T/etc/systemd/system/multi-user.target.d/wolos-live-ssh.conf" \
  "$T/etc/wolos/nftables.d/live-ssh.conf"
userdel -R "$T" live || :
# The channel the image was built from (testing or stable): the installed system updates from it.
sh "$here/install-channel" "$T" >&2 || fail "could not set where updates come from"
# The live dock's copy of shell.json gives way to the package's.
[ ! -f "$T/etc/wolos/shell.json.pacnew" ] || mv "$T/etc/wolos/shell.json.pacnew" "$T/etc/wolos/shell.json"
# The package database belongs to the slot, not the shared @var (pacman.conf DBPath).
if [ -d "$T/var/lib/pacman/local" ]; then
  mkdir -p "$T/usr/lib/pacman" && mv "$T/var/lib/pacman/local" "$T/usr/lib/pacman/local" || fail "could not move the package database"
  grep -q '^DBPath' "$T/etc/pacman.conf" || sed -i '/^\[options\]/a DBPath = /usr/lib/pacman/' "$T/etc/pacman.conf"
fi
echo a > "$T/etc/wolos/slot"
mkdir -p "$T/etc/kernel"
# The slot is sealed (read-only) at the end: it boots ro. Encrypted: the initramfs unlocks the volume.
if [ "$unlock" = off ]; then rootword="root=UUID=$ruuid"; else rootword=$(wol encrypt words "$luuid" "$unlock"); fi
if [ "$slots" = two ]; then rootwords="$rootword rootflags=subvol=@wolos-a ro"; else rootwords="$rootword rw"; fi
echo "$rootwords quiet splash loglevel=3 audit=0 rd.udev.log_level=3 systemd.show_status=auto vt.global_cursor_default=0" > "$T/etc/kernel/cmdline"
{
  echo "# WolOS: / is the slot the boot entry names (rootflags=subvol=@wolos-a or @wolos-b)."
  if [ "$slots" = two ]; then
    [ -n "$home_dev" ] || echo "UUID=$ruuid /home btrfs subvol=/@home,$O 0 0"
    [ -n "$var_dev" ] || echo "UUID=$ruuid /var btrfs subvol=/@var,$O 0 0"
    # The btrfs top level, for updates that build the next slot; mounted only while one needs it.
    echo "UUID=$ruuid /run/wolos/top btrfs subvolid=5,noauto,x-systemd.automount,x-systemd.idle-timeout=60,$O 0 0"
  fi
  echo "UUID=$euuid /efi vfat umask=0077,shortname=winnt 0 2"
  [ -z "$extra_fstab" ] || echo "$extra_fstab"
  if [ "$slots" = two ]; then
    echo "# The slot is read-only: /etc stays writable, its changes live in the shared @var (they survive updates)."
    # The lower is the slot's /etc, another one after each update: overlayfs takes a changed lower
    # only without index, metacopy, xino and redirects (wol_core::update::ETC_FSTAB, the same line).
    echo "overlay /etc overlay lowerdir=/etc,upperdir=/var/lib/wolos/etc/upper,workdir=/var/lib/wolos/etc/work,index=off,metacopy=off,redirect_dir=follow,xino=off,nfs_export=off,x-systemd.requires-mounts-for=/var 0 0"
  fi
} > "$T/etc/fstab"
if [ "$slots" = two ]; then
  mkdir -p "$T/var/lib/wolos/etc/upper" "$T/var/lib/wolos/etc/work"
else
  # One copy (ADR 0023): updates go in place, there is no seal to check.
  : > "$T/etc/wolos/single-copy"
fi
# Folders for the partitions the plan mounts elsewhere.
echo "$extra_fstab" | awk '$2 ~ /^\// {print $2}' | while read -r m; do mkdir -p "$T$m"; done
# The plan's other encrypted volumes (/home, /var, swap, folders): opened at boot by crypttab with
# the install key, which lives only inside the encrypted system (crypttab's third field).
if [ -n "$extra_crypttab" ]; then
  mkdir -p "$T/etc/cryptsetup-keys.d" && chmod 700 "$T/etc/cryptsetup-keys.d" || fail "could not keep the volume keys"
  echo "$extra_crypttab" | awk 'NF {print $1}' | while read -r n; do
    install -m 400 "$KEYDIR/key" "$T/etc/cryptsetup-keys.d/$n.key" || exit 1
  done || fail "could not keep the volume keys"
  { echo "# WolOS: volumes beyond the system, unlocked with keys kept in the encrypted system."; echo "$extra_crypttab"; } > "$T/etc/crypttab" ||
    fail "could not write crypttab"
fi

# This computer's keys sign its boot images and, with a TPM, its disk policy; made once, kept in
# the shared @var (boot-setup finds them there).
say keys 40 "Making this computer's keys"
SB=$T/var/lib/wolos/secureboot
WOLOS_SB_DIR=$SB sh "$here/boot-keys" create || fail "could not make this computer's keys"
if [ "$unlock" != off ]; then
  say encrypt 45 "Setting up the disk unlock"
  wol encrypt hooks "$T/etc/mkinitcpio.conf.d/wolos.conf" || fail "could not set the unlock hook"
  # Real keys in, throw-away key out; the recovery key is kept once for the installer to show.
  # When the chip refuses (Secure Boot or firmware changed), the account's own password opens the
  # disk before the recovery key is needed; never a shared one. Kept in sync by `wol encrypt password`.
  # The files go to `wol encrypt enroll` as they are: it reads them as typed (one line end off,
  # encrypt::typed_secret), the same reading `wol encrypt decide` checked (audit2 B4, audit3 R2B-6).
  fallback='' pass=''
  if [ "$unlock" = tpm2 ] && [ -n "${account:-}" ] && [ -s "${plandir:-/nonexistent}/account-password" ]; then
    fallback=1 pass=$plandir/account-password
  fi
  if [ "$unlock" != tpm2 ] && [ -n "${WOLOS_PASSPHRASE_FILE:-}" ]; then
    pass=$WOLOS_PASSPHRASE_FILE
  fi
  WOLOS_TPM_PUB=$SB/tpm2-pcr-public.pem wol encrypt enroll "$root" "$KEYDIR/key" "$unlock" \
    ${pass:+"$pass"} || fail "could not set up the disk unlock"
  [ -z "$fallback" ] || echo "$account" > "$T/var/lib/wolos/disk-unlock-user" || fail "could not set up the disk unlock"
  [ "$unlock" != tpm2 ] || cp "$KEYDIR/key" "$SB/rebind.key" || fail "could not keep the first-boot key"
fi

# Language, keyboard and time zone before the initramfs: sd-vconsole bakes /etc/vconsole.conf into
# it, and the disk password is typed with that keymap (audit2 B1). Its own stage, so a stop here is
# named for what it was (audit3 R2B-8). The account comes at 90 %.
if [ -n "$plan" ]; then
  say settings 68 "Setting the language and keyboard"
  wol install settings "$plan" "$T" || fail "could not set the language and time zone"
fi
say initramfs 70 "Building the startup image"
# `wol mirror gate` turns the optimized x86-64-v3 repo sections on only where the CPU runs them (ADR
# 0030); linux-wolos-v3 (same boot files) replaces linux-wolos when a repo offers it, before the
# initramfs is built. Offline (no default
# route): nothing to wait for, the next update does it; online: bounded, a slow mirror never stalls here.
# A step cut short must not leave anything behind in the slot (audit2 B11): whatever it still runs
# inside the target is stopped, and pacman's lock goes (it is sealed into the slot otherwise and
# every later update says "unable to lock database").
stray() {
  # Never the live system itself: every process has / as its root.
  [ "${T%/}" != "" ] || return 0
  for r in "${WOLOS_PROC:-/proc}"/[0-9]*/root; do
    [ "$(readlink "$r" 2>/dev/null || :)" = "$T" ] || continue
    q=${r%/root}; kill -9 "${q##*/}" 2>/dev/null || :
  done
  rm -f "$T/usr/lib/pacman/db.lck" "$T/var/lib/pacman/db.lck"
}
bounded() { # SECONDS COMMAND...: a network step inside the target, at most SECONDS
  secs=$1; shift
  timeout -k 10 "$secs" arch-chroot "$T" "$@" >&2 && return 0
  stray; return 1
}
if [ -n "$(ip -4 route show default 2>/dev/null; ip -6 route show default 2>/dev/null)" ]; then
  bounded 60 wol mirror gate --yes || :
  bounded 120 pacman -Sy || :
  if [ "$(timeout 30 arch-chroot "$T" wol mirror kernel 2>/dev/null)" = linux-wolos-v3 ]; then
    # Only the download is bounded (the slow, network part); the swap itself runs from the
    # cache to the end: a transaction killed halfway would leave half a kernel in the slot.
    if bounded 600 pacman -Sw --noconfirm linux-wolos-v3; then
      arch-chroot "$T" pacman -S --noconfirm linux-wolos-v3 >&2 || fail "could not install the faster kernel"
    fi
  fi
  [ ! -e "$T/usr/lib/pacman/db.lck" ] || fail "the package database was left locked"
fi
mkdir -p "$T/etc/mkinitcpio.d" "$T/boot"
for m in "$T"/usr/lib/modules/*/; do
  [ -f "$m/pkgbase" ] && [ -f "$m/vmlinuz" ] || continue
  kb=$(cat "$m/pkgbase")
  install -m 644 "$m/vmlinuz" "$T/boot/vmlinuz-$kb"
  printf "PRESETS=('default')\nALL_kver='/boot/vmlinuz-%s'\ndefault_image='/boot/initramfs-%s.img'\n" "$kb" "$kb" > "$T/etc/mkinitcpio.d/$kb.preset"
done
[ -f "$T/boot/vmlinuz-linux-wolos" ] || fail "no linux-wolos kernel in the image"
arch-chroot "$T" mkinitcpio -P >&2 || fail "could not build the initramfs"
mkdir -p "$T/efi/wolos-a"
# The modules and media formats (Store kit, ADR 0032 B and C) the person ticked: online now, bounded;
# offline (or cut short) they are queued (modules-pending, packages-pending) and the first start
# installs them once it is online (firstboot drains them; the network-up hook 50-wolos-online too
# when the connection comes later, e.g. Wi-Fi): "added at first start with a network".
online=; [ -z "$(ip -4 route show default 2>/dev/null; ip -6 route show default 2>/dev/null)" ] || online=1
if [ -n "$modules" ] || [ -n "$extra_packages" ]; then
  if [ -n "$modules" ]; then say packages 80 "Installing the modules you chose"; else say packages 85 "Installing media formats"; fi
  # Options first, then the ids; the disk and plan arguments were read above.
  set --
  [ -n "$online" ] || set -- --queue
  for p in $extra_packages; do set -- "$@" --package "$p"; done
  # shellcheck disable=SC2086 # ids: wol install info checks each (valid_id), modules-install checks again
  WOLOS_MODULES_TIMEOUT=1800 sh "$here/modules-install" --root "$T" "$@" -- $modules >&2 ||
    { stray; echo "install-run: some modules or media formats wait for the first start" >&2; }
  [ ! -e "$T/usr/lib/pacman/db.lck" ] || fail "the package database was left locked"
fi

say settings 90 "Settings"
echo "$WOLOS_HOSTNAME" > "$T/etc/hostname"
# Windows keeps the hardware clock in local time; so does this system while Windows stays on this
# computer, or each start of the other one shows the wrong time.
if [ "$windows" = 1 ]; then
  printf '0.0 0 0\n0\nLOCAL\n' > "$T/etc/adjtime" || fail "could not set the clock"
fi
# Swap: zram is the package default (zram-generator.conf in /usr/lib). No hibernation either way:
# the kernel runs locked down (ADR 0025).
mkdir -p "$T/etc/systemd"
case $WOLOS_SWAP in
  none) printf '# WolOS: no swap, chosen at install. Remove this file for the default (zram).\n' > "$T/etc/systemd/zram-generator.conf" ;;
  swapfile:*)
    gib=${WOLOS_SWAP#swapfile:}
    case $gib in '' | *[!0-9]*) fail "swap: not a size: $WOLOS_SWAP" ;; esac
    [ "$gib" -ge 1 ] && [ "$gib" -le 64 ] || fail "swap: not a size: $WOLOS_SWAP"
    mkdir -p "$T/var/swap"
    if [ "$slots" = two ]; then
      # btrfs: a swap file must not be copy-on-write; mkswapfile makes it so.
      btrfs filesystem mkswapfile --size "${gib}g" "$T/var/swap/swapfile" >&2 || fail "could not make the swap file"
    else
      { fallocate -l "${gib}G" "$T/var/swap/swapfile" && chmod 600 "$T/var/swap/swapfile" && mkswap "$T/var/swap/swapfile" >&2; } ||
        fail "could not make the swap file"
    fi
    echo "/var/swap/swapfile none swap defaults 0 0" >> "$T/etc/fstab"
    printf '# WolOS: a swap file was chosen at install instead of zram.\n' > "$T/etc/systemd/zram-generator.conf"
    ;;
  zram) ;;
  *) fail "swap: not a choice: $WOLOS_SWAP" ;;
esac
if [ -n "$plan" ]; then
  # A kept /home goes on only now: nothing above ever writes to it.
  [ -z "$home_dev" ] || mount "$home_dev" "$T/home" || fail "could not mount the new system"
  wol install account "$plan" "$T" "$plandir/account-password" || fail "could not create the account"
  rm -f "$plandir/account-password" "$plandir/disk-password"
fi
# Auto-login: the login window's file, the account's name (login::parse_config).
if [ "$WOLOS_AUTOLOGIN" = yes ] && [ -n "$account" ]; then
  mkdir -p "$T/etc/wolos" && printf '{"autologin":"%s"}\n' "$account" > "$T/etc/wolos/login.json" || fail "could not set auto-login"
fi
tr -d - < /proc/sys/kernel/random/uuid > "$T/etc/machine-id"
# The real machine-id means no first boot for systemd, and a sealed slot could not take the presets
# then anyway: they go on here (layers merge at boot, NetworkManager runs).
systemctl --root="$T" preset-all >&2 || fail "could not enable the system services"
arch-chroot "$T" pacman-key --init >&2 && arch-chroot "$T" pacman-key --populate >&2 ||
  echo "package keys: set up on first update" >&2

# Sealing: fs-verity on /usr executables and libraries, then the slot is read-only.
say seal 92 "Sealing the system"
[ "$slots" = one ] || wol seal apply "$T" "$T/efi/wolos-a/verity" >&2 || fail "could not seal the system"
# After the seal: the signed image carries its digest.
say boot 95 "Making $disk start WolOS"
# The plan knows whether the startup partition is someone else's too (reused, another system
# stays) and whether Windows stays: boot-setup asks no file on the partition (audit3 R2B-4, R2B-9).
shared=no; [ "$esp_reused" != 1 ] || [ "$others" = 0 ] || shared=yes
win=no; [ "$windows" != 1 ] || win=yes
bl=no; [ "$bitlocker" != 1 ] || bl=yes
WOLOS_ROOT=$T WOLOS_ESP=$T/efi WOLOS_ESP_DEV=$esp WOLOS_OTHER_SYSTEMS=${others#0} WOLOS_BOOT_DISK=$disk \
  WOLOS_ESP_SHARED=$shared WOLOS_WINDOWS=$win WOLOS_BITLOCKER=$bl WOLOS_SECURE=$WOLOS_SECURE sh "$here/install-boot" >&2 ||
  fail "could not install the boot loader"
for f in "efi/loader/entries/wolos-a+3.conf" "efi/EFI/wolos/wolos-a.efi" "etc/fstab" "etc/hostname"; do
  [ -s "$T/$f" ] || fail "the new system did not check out: $f missing"
done
# The log stays with the system it describes.
mkdir -p "$T/var/log" && cp "$LOG" "$T/var/log/wolos-install.log" || :
cleanup
say "done" 100 "WolOS is installed on $disk"
