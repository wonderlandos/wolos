#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Boot counting (wolos-boot-ok.service): this boot is good once the slot passed its early checks
# and something a person can use is on the screen: the login window, Setup, or a session (its
# shell or its lock screen), up under wold for a few seconds in a row (QA-SYS-3). wold alone is
# not enough: a slot whose login window never appears must not raise the floor. A failure
# leaves the try counter; three such boots fall back.
# A good boot of a new slot also clears the live layers it already holds (`wol layers clear`,
# its folded list): they stay until here so a slot that fails falls back to an old slot that
# still has them. The same command settles the layers a cut-off `wol pkg` left, under the update
# lock (QA-STORE-45, QA-A9-CORE-2): one without its record never committed and goes; one with its
# record but no extension-release committed and gets it.
# `wol boot bless` rewrites loader/entries/wolos-*; wolos-mok-enroll.service may be rewriting the
# same entries at this boot (a Firmware-tier install moving to the key-screen tier, boot-enroll ->
# esp-sync), so bless waits for that unit to end, at most a minute (audit3 R2B-8).
# Env (tests): WOLOS_BOOT_OK_WAIT (seconds between looks, 5), WOLOS_BOOT_OK_LIMIT (seconds to wait
# for the screen, 90), WOLOS_PROC (/proc), WOLOS_CMDLINE_FILE (/proc/cmdline), WOLOS_MARKS
# (/var/lib/wolos), WOLOS_ESP (/efi), WOLOS_SLOTS (/run/wolos/slots.json).
set -eu
wait=${WOLOS_BOOT_OK_WAIT:-5}
limit=${WOLOS_BOOT_OK_LIMIT:-90}
P=${WOLOS_PROC:-/proc}
M=${WOLOS_MARKS:-/var/lib/wolos}

# A slot that failed its seal or floor check this boot is not good, whatever comes up after it
# (QA-LIVE3-36; a check that passes removes its slot's mark, so a mark is this boot's).
slot=$(sed -n 's/.*subvol=\/*@\(wolos-[ab]\).*/\1/p' "${WOLOS_CMDLINE_FILE:-/proc/cmdline}" 2>/dev/null || :)
if [ -n "$slot" ]; then
  for k in verity-failed epoch-failed; do
    if [ -e "$M/$k-$slot" ]; then
      echo "boot-ok: $slot failed its early check ($k): not blessed" >&2
      exit 1
    fi
  done
fi

# The program a person sees: the login window, Setup, the shell or its lock screen.
on_screen() {
  cat "$P"/[0-9]*/comm 2>/dev/null | grep -qxE 'wol-loginwindow|wol-setup|wol-shell|wol-lock'
}
waited=0 seen=0
while :; do
  if systemctl is-active --quiet wold.service && on_screen; then
    seen=$((seen + 1))
    [ "$seen" -lt 2 ] || break
  else
    seen=0
  fi
  if [ "$waited" -ge "$limit" ]; then
    echo "boot-ok: nothing reached the screen in ${limit} s: not blessed" >&2
    exit 1
  fi
  sleep "$wait"
  waited=$((waited + wait))
done

n=0
while [ "$n" -lt 60 ] &&
  [ "$(systemctl show --property=ActiveState --value wolos-mok-enroll.service 2>/dev/null || :)" = activating ]; do
  sleep 1; n=$((n + 1))
done
# Harmless if it fails: the floor and the titles are set again at the next good boot.
wol boot bless || :
# The image this good boot started, for boot-rearm (live-4 F3): it counts the next start again
# only when the image is no longer this one.
ESP=${WOLOS_ESP:-/efi}
if [ -n "$slot" ] && [ -f "$ESP/EFI/wolos/$slot.efi" ] && [ -d "$ESP/$slot" ]; then
  sum=$(sha256sum "$ESP/EFI/wolos/$slot.efi" | cut -d' ' -f1)
  if [ -n "$sum" ] && [ "$(cat "$ESP/$slot/blessed.sha256" 2>/dev/null || :)" != "$sum" ]; then
    if printf '%s\n' "$sum" > "$ESP/$slot/blessed.sha256.new"; then
      sync "$ESP/$slot/blessed.sha256.new" || :
      mv -f "$ESP/$slot/blessed.sha256.new" "$ESP/$slot/blessed.sha256" || :
    fi
  fi
fi

# The slot list for Settings > Restore and `wol restore`: they run as the person, who cannot read
# the ESP (fmask 0077), so their own `bootctl list` fails (QA-LIVE4-5, F5/F6). bootctl's JSON as
# it is, world-readable, replaced whole; a failed listing keeps the last good one.
L=${WOLOS_SLOTS:-/run/wolos/slots.json}
if list=$(bootctl --esp-path="$ESP" list --json=short 2>/dev/null) && [ -n "$list" ]; then
  if mkdir -p "${L%/*}" && printf '%s\n' "$list" > "$L.new" && chmod 0644 "$L.new"; then
    mv -f "$L.new" "$L" || :
  else
    rm -f "$L.new"
  fi
fi

# The mark of an update that was cut after it wrote this slot's boot entry and before it removed
# the mark (power lost): this slot is up and blessed, so the update did finish (QA-A9-CORE-4).
# Only the slot being built is named in it, and a build of the other slot is not touched.
if [ -n "$slot" ] && [ "$(cut -d' ' -f1 "$M/update-building" 2>/dev/null || :)" = "$slot" ]; then
  rm -f "$M/update-building" || :
fi
# Layers a cut-off `wol pkg` left, and the folded ones, are `wol layers clear`'s: it holds the
# update lock for them, which a shell test of "a chroot is mounted" cannot (the layer chroot
# lives in a private mount namespace, so `mountpoint` here is false for ever; QA-A9-CORE-2).
# Harmless if it fails: the layers stay merged and the next good boot tries again.
wol layers clear || :
