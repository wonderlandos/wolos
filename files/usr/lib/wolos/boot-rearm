#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# wolos-boot-rearm.service, at shutdown (`stop`), live-4 F3 / QA-LIVE4-3: a blessed entry
# (<slot>.conf) has no try counter, so an image the firmware cannot load failed every start and
# never fell back ("Failed to execute ... Load error", then the firmware's own screen). The image
# can also be damaged while the computer is off, where no check of this boot sees it. So the next
# start is always counted; systemd-boot counts before it loads the image, an entry with no tries
# left sorts last and the other slot starts by itself, and the good start blesses it again
# (systemd-bless-boot):
#   - three tries (<slot>+3.conf) when this boot gives a reason:
#     - the image no longer matches the digest esp-sync kept: damaged, rebuilt from the slot first;
#     - the image is not the one blessed last (boot-ok keeps <slot>/blessed.sha256);
#     - this boot's seal or floor check failed (verity-failed-<slot>, epoch-failed-<slot>);
#   - otherwise one try (<slot>+1.conf): the image that started last time shows it still loads.
#     When it does not, systemd-boot (262: `reboot-on-error`, `auto` by default, restarts only
#     after a counted entry failed) restarts the machine, the entry has no tries left, and the
#     other slot starts in the same power-on with nobody at the keyboard (checked on OVMF with
#     systemd-boot 262.1). A blessed entry instead stopped on the firmware's own screen. The other
#     slot's good start gives an intact image its three tries back (`wol boot bless`: the try was
#     lost to a power cut, not to the image).
# Limit: a computer that loses power while running skips this; its next start is not counted.
# The new entry is written, synced and renamed before the old one goes (FAT, a power cut): there
# is never a moment without an entry for the slot.
# `start` does nothing (the unit only needs to be up to be stopped at shutdown).
# Env (tests): WOLOS_ESP (/efi), WOLOS_CMDLINE_FILE (/proc/cmdline), WOLOS_LIB (/usr/lib/wolos),
# WOLOS_MARKS (/var/lib/wolos).
set -u
[ "${1:-}" = stop ] || exit 0
ESP=${WOLOS_ESP:-/efi}
M=${WOLOS_MARKS:-/var/lib/wolos}
E=$ESP/loader/entries
slot=$(sed -n 's/.*subvol=\/*@\(wolos-[ab]\).*/\1/p' "${WOLOS_CMDLINE_FILE:-/proc/cmdline}" 2>/dev/null || :)
[ -n "$slot" ] || exit 0
# Only a blessed entry: one still counted is already counted.
[ -f "$E/$slot.conf" ] || exit 0
img="$ESP/EFI/wolos/$slot.efi"
got=$(sha256sum "$img" 2>/dev/null | cut -d' ' -f1)
want=$(cat "$ESP/$slot/image.sha256" 2>/dev/null || :)
blessed=$(cat "$ESP/$slot/blessed.sha256" 2>/dev/null || :)
why=
if [ -n "$want" ] && [ "$got" != "$want" ]; then
  why=damaged
  echo "boot-rearm: the image of $slot is damaged; building it again" >&2
  WOLOS_SLOT=$slot sh "${WOLOS_LIB:-/usr/lib/wolos}/esp-sync" ||
    echo "boot-rearm: could not build it again; the try counter falls back to the other slot" >&2
fi
if [ -z "$why" ] && [ -n "$blessed" ] && [ "$got" != "$blessed" ]; then
  why="not the image blessed last"
fi
for k in verity-failed epoch-failed; do
  if [ -z "$why" ] && [ -e "$M/$k-$slot" ]; then why=$k; fi
done
tries=3
[ -n "$why" ] || { tries=1; why="the image must show it still loads"; }
echo "boot-rearm: $slot counted again at the next start, $tries tries ($why)" >&2
# esp-sync may have counted the entry already (a changed image gets three tries).
if [ -f "$E/$slot.conf" ]; then
  cp "$E/$slot.conf" "$E/$slot+$tries.conf.new" || exit 1
  sync "$E/$slot+$tries.conf.new"
  mv -f "$E/$slot+$tries.conf.new" "$E/$slot+$tries.conf" || exit 1
  sync -f "$ESP/"
  rm -f "$E/$slot.conf"
fi
sync -f "$ESP/"
exit 0
