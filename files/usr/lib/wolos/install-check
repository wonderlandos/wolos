#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# WolOS installer: may <disk> be erased? Reads only (never writes a disk). Run by install-run
# before anything is written, and by the Install WolOS app to word its warning. One fact per line:
#   size <bytes>
#   os <Windows|Linux|macOS|FreeBSD>   another system lives on this disk (GPT types, filesystems;
#                                      a LUKS or LVM volume is some Linux's)
#   bitlocker <yes|no>                 with `os Windows`: a BitLocker volume is on this disk (its
#                                      recovery key is asked for after a Secure Boot key change)
#   boot <tier>                        the protection this computer gets (`wol boot detect`);
#                                      `firmware`: a firmware setting must change first
#   refuse <not-listed|too-small|in-use|bios>
# Exit 0: may erase. 2: refused (the boot medium, a missing disk, too small, a mounted partition,
# a computer started without UEFI: the installed system boots through its EFI partition only).
#   install-check --result   what the last install-run left for the Install app (audit3 R2B-1),
#                            from the folder it made (root's only): `recovery-key <key>` once (the
#                            key is deleted as it is handed out), then the log, `log <line>` each.
#                            The sudo rule that lets the live user run this check covers it.
# Env (tests): WOLOS_EFIVARS, WOLOS_RESULT_DIR.
set -u
MIN_BYTES=16000000000   # wol_core::install::layout::MIN_ROOT (image_install.rs checks they agree)
if [ "${1:-}" = --result ]; then
  R=${WOLOS_RESULT_DIR:-/run/wolos/install}
  if [ -f "$R/recovery-key" ] && [ ! -L "$R/recovery-key" ]; then
    printf 'recovery-key %s\n' "$(cat "$R/recovery-key")"
    rm -f "$R/recovery-key"
  fi
  if [ -f "$R/log" ] && [ ! -L "$R/log" ]; then sed 's/^/log /' "$R/log"; fi
  exit 0
fi
here=$(dirname "$0")
disk=${1:-}
if [ -z "$disk" ] || ! sh "$here/install-disks" | grep -qx -- "$disk"; then
  echo "refuse not-listed"; exit 2
fi
# --probe: everything the app shows about this disk, as JSON (reads only).
[ "${2:-}" != --probe ] || exec wol install probe "$disk"
rc=0
# The facts come from the disk model (wol_core::install::disk::facts, `wol install facts`), never
# from a copy of its partition types here (audit3 R2B-16/19).
facts=$(wol install facts "$disk") || facts=
printf '%s\n' "$facts" | grep -E '^(size|os|bitlocker) ' || :
bytes=$(printf '%s\n' "$facts" | sed -n 's/^size \([0-9][0-9]*\)$/\1/p')
[ -n "$bytes" ] || { bytes=0; echo "size 0"; }
echo "boot $(wol boot detect)"
[ "$bytes" -ge "$MIN_BYTES" ] || { echo "refuse too-small"; rc=2; }
# Started without UEFI (BIOS, CSM): the installed system has no way to boot on this computer.
[ -d "${WOLOS_EFIVARS:-/sys/firmware/efi/efivars}" ] || { echo "refuse bios"; rc=2; }
# Anything on it still mounted, through a btrfs subvolume or an opened encrypted volume too (a USB
# disk opened in Files): install-run unmounts those first.
# A swap partition on it counts too (`swap <device>`).
if [ -n "$(wol install mounts "$disk" || echo unknown)" ]; then
  echo "refuse in-use"; rc=2
fi
exit $rc
