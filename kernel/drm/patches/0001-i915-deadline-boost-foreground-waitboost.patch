diff --git a/drivers/gpu/drm/i915/gt/intel_rps.c b/drivers/gpu/drm/i915/gt/intel_rps.c
index 9711e50..12dc73b 100644
--- a/drivers/gpu/drm/i915/gt/intel_rps.c
+++ b/drivers/gpu/drm/i915/gt/intel_rps.c
@@ -1013,6 +1013,45 @@ void intel_rps_dec_waiters(struct intel_rps *rps)
 	}
 }
 
+/*
+ * WolOS (ADR 0008): frame-deadline boost and foreground-only waitboost.
+ * compat.linuxkpi.i915_wol_waitboost: 0 never, 1 every waiter (upstream), 2 foreground process only.
+ * compat.linuxkpi.i915_wol_fg_pid: frontmost pid, written by wold; <= 0 = unknown, behaves as 1.
+ * compat.linuxkpi.i915_wol_deadline_boost: 1 = boost a request whose fence got a deadline (vblank).
+ */
+int i915_wol_waitboost = 2;
+module_param_named(wol_waitboost, i915_wol_waitboost, int, 0644);
+MODULE_PARM_DESC(wol_waitboost, "Waitboost: 0 off, 1 all waiters, 2 foreground pid only (default)");
+int i915_wol_fg_pid;
+module_param_named(wol_fg_pid, i915_wol_fg_pid, int, 0644);
+MODULE_PARM_DESC(wol_fg_pid, "Foreground pid for wol_waitboost=2 (0 = unknown, boost all)");
+int i915_wol_deadline_boost = 1;
+module_param_named(wol_deadline_boost, i915_wol_deadline_boost, int, 0644);
+MODULE_PARM_DESC(wol_deadline_boost, "Boost requests whose fence gets a deadline (default 1)");
+
+bool intel_rps_wol_waiter_may_boost(void)
+{
+	int fg = READ_ONCE(i915_wol_fg_pid);
+	int pid;
+
+	switch (READ_ONCE(i915_wol_waitboost)) {
+	case 0:
+		return false;
+	case 1:
+		return true;
+	default:
+		break;
+	}
+	if (fg <= 0)
+		return true;
+#ifdef __FreeBSD__
+	pid = task_pid_group_leader(current);
+#else
+	pid = task_tgid_nr(current);
+#endif
+	return pid == fg;
+}
+
 void intel_rps_boost(struct i915_request *rq)
 {
 	struct intel_guc_slpc *slpc;
