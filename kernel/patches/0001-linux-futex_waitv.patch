  * Wake up threads waiting on an userland object by a bit mask.
  */
+/*
+ * Wake the thread waiting on uq.  A multi-queue waiter (uq_wake != NULL)
+ * is woken once, by the first of its queues to be signalled.
+ */
+static __inline void
+umtxq_wakeup(struct umtx_q *uq, bool one)
+{
+	struct umtxq_wake *w;
+
+	w = uq->uq_wake;
+	if (__predict_true(w == NULL)) {
+		if (one)
+			wakeup_one(uq);
+		else
+			wakeup(uq);
+		return;
+	}
+	if (atomic_cmpset_rel_int(&w->w_index, UMTXQ_WAKE_NONE,
+	    uq->uq_wake_index))
+		wakeup(w);
+}
