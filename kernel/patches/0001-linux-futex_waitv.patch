+/*
+ * futex_waitv(2): wait on up to 128 futexes, return the index of the one
+ * that woke us.
+ *
+ * Tuned for Wine/Proton fsync, which calls it on every wait:
+ * - values are checked before any queue is touched, so a stale wait
+ *   returns EAGAIN without locks;
+ * - queue entries are cached per thread: no allocation after the first call;
+ * - the thread sleeps on one wake record (struct umtxq_wake); the first
+ *   waker records its index, so no rescan is needed to find it;
+ * - a short bounded spin (compat.linux.futex_spin) catches the
+ *   common immediate hand-off before paying for a sleep.
+ */
+/* Grow the per-thread cache to hold at least nr entries. */
+static void
+linux_futex_waitv_reserve(struct linux_emuldata *em, u_int nr)
+{
+	struct linux_futex_waitv *buf;
+	struct umtx_q **uq;
+	u_int cap, i;
+
+	if (__predict_true(nr <= em->waitv_cap))
+		return;
+	cap = MAX(8, em->waitv_cap);
+	while (cap < nr)
+		cap *= 2;
+	uq = malloc(cap * sizeof(*uq), M_LINUX, M_WAITOK);
+	buf = malloc(cap * sizeof(*buf), M_LINUX, M_WAITOK);
+	for (i = 0; i < em->waitv_cap; i++)
+		uq[i] = em->waitv_uq[i];
+	for (; i < cap; i++)
+		uq[i] = umtxq_alloc();
+	free(em->waitv_uq, M_LINUX);
+	free(em->waitv_buf, M_LINUX);
+	em->waitv_uq = uq;
+	em->waitv_buf = buf;
+	em->waitv_cap = cap;
+}
+
+/* EWOULDBLOCK if any value differs (Linux EAGAIN), EFAULT if unreadable. */
+static int
+linux_futex_waitv_check(const struct linux_futex_waitv *wv, u_int nr)
+{
+	uint32_t uval;
+	u_int i;
+
+	for (i = 0; i < nr; i++) {
+		if (fueword32((void *)(uintptr_t)wv[i].uaddr, &uval) != 0)
+			return (EFAULT);
+		if (uval != (uint32_t)wv[i].val)
+			return (EWOULDBLOCK);
+	}
+	return (0);
+}
+
+/* Sleep until woken, timed out or interrupted. */
+static int
+linux_futex_waitv_sleep(struct umtxq_wake *w, struct umtx_abs_timeout *timo)
+{
+	sbintime_t sbt;
+	u_int spin;
+	int error, flags;
+
+	if (mp_ncpus > 1)
+		for (spin = linux_futex_spin; spin > 0 &&
+		    atomic_load_acq_int(&w->w_index) == UMTXQ_WAKE_NONE; spin--)
+			cpu_spinwait();
+	error = 0;
+	while (atomic_load_acq_int(&w->w_index) == UMTXQ_WAKE_NONE) {
+		sbt = 0;
+		flags = 0;
+		if (timo != NULL) {
+			if (timo->is_abs_real)
+				curthread->td_rtcgen =
+				    atomic_load_acq_int(&rtc_generation);
+			error = umtx_abs_timeout_getsbt(timo, &sbt, &flags);
+			if (error != 0)
+				break;
+		}
+		sleepq_lock(w);
+		if (atomic_load_acq_int(&w->w_index) != UMTXQ_WAKE_NONE) {
+			sleepq_release(w);
+			break;
+		}
+		sleepq_add(w, NULL, "futexv", SLEEPQ_SLEEP |
+		    SLEEPQ_INTERRUPTIBLE, 0);
+		if (sbt != 0) {
+			sleepq_set_timeout_sbt(w, sbt, 0, flags);
+			error = sleepq_timedwait_sig(w, 0);
+		} else
+			error = sleepq_wait_sig(w, 0);
+		if (error == EWOULDBLOCK) {
+			error = (flags & C_ABSOLUTE) != 0 ? ETIMEDOUT : 0;
+			if (error != 0)
+				break;
+		} else if (error != 0)
+			break;
+	}
+	curthread->td_rtcgen = 0;
+	return (error);
+}
+
+int
+linux_futex_waitv(struct thread *td, struct linux_futex_waitv_args *args)
+{
+	struct umtx_abs_timeout timo;
+	struct linux_emuldata *em;
+	struct linux_futex_waitv *wv;
+	struct umtxq_wake w;
+	struct umtx_q *uq;
+	struct timespec ts;
+	u_int i, nr, queued;
+	int clockid, error;
+
+	nr = args->nr_futexes;
+	if (args->flags != 0 || nr == 0 || nr > LINUX_FUTEX_WAITV_MAX)
+		return (EINVAL);
+	if (args->timeout != NULL) {
+		switch (args->clockid) {
+		case LINUX_CLOCK_MONOTONIC:
+			clockid = CLOCK_MONOTONIC;
+			break;
+		case LINUX_CLOCK_REALTIME:
+			clockid = CLOCK_REALTIME;
+			break;
+		default:
+			return (EINVAL);
+		}
+#if defined(__i386__) || (defined(__amd64__) && defined(COMPAT_LINUX32))
+		error = linux_get_timespec64(&ts, args->timeout);
+#else
+		error = linux_get_timespec(&ts, args->timeout);
+#endif
+		if (error != 0)
+			return (error);
+		umtx_abs_timeout_init(&timo, clockid, 1, &ts);
+	}
+
+	em = em_find(td);
+	linux_futex_waitv_reserve(em, nr);
+	wv = em->waitv_buf;
+	error = copyin(args->waiters, wv, nr * sizeof(*wv));
+	if (error != 0)
+		return (error);
+	for (i = 0; i < nr; i++) {
+		if ((wv[i].flags & ~(LINUX_FUTEX2_SIZE_MASK |
+		    LINUX_FUTEX2_PRIVATE)) != 0 || wv[i].__reserved != 0 ||
+		    (wv[i].flags & LINUX_FUTEX2_SIZE_MASK) !=
+		    LINUX_FUTEX2_SIZE_U32 || (wv[i].val >> 32) != 0 ||
+		    !__is_aligned(wv[i].uaddr, sizeof(uint32_t)))
+			return (EINVAL);
+	}
+
+	/* Fast path: a value already changed, nothing to queue. */
+	error = linux_futex_waitv_check(wv, nr);
+	if (error != 0)
+		return (error);
+
+	w.w_index = UMTXQ_WAKE_NONE;
+	for (queued = 0; queued < nr; queued++) {
+		uq = em->waitv_uq[queued];
+		error = umtx_key_get((void *)(uintptr_t)wv[queued].uaddr,
+		    TYPE_FUTEX, (wv[queued].flags & LINUX_FUTEX2_PRIVATE) != 0 ?
+		    THREAD_SHARE : AUTO_SHARE, &uq->uq_key);
+		if (error != 0)
+			break;
+		uq->uq_thread = td;
+		uq->uq_bitset = FUTEX_BITSET_MATCH_ANY;
+		uq->uq_wake = &w;
+		uq->uq_wake_index = queued;
+		umtxq_lock(&uq->uq_key);
+		umtxq_insert(uq);
+		umtxq_unlock(&uq->uq_key);
+	}
+
+	/*
+	 * Queued before reading: a waker that changes a value after this
+	 * check finds us on its queue.
+	 */
+	atomic_thread_fence_seq_cst();
+	if (error == 0)
+		error = linux_futex_waitv_check(wv, nr);
+	if (error == 0)
+		error = linux_futex_waitv_sleep(&w,
+		    args->timeout != NULL ? &timo : NULL);
+
+	/* Holding each chain lock: no waker can still reach &w after this. */
+	for (i = 0; i < queued; i++) {
+		uq = em->waitv_uq[i];
+		umtxq_lock(&uq->uq_key);
+		if ((uq->uq_flags & UQF_UMTXQ) != 0)
+			umtxq_remove(uq);
+		uq->uq_wake = NULL;
+		umtxq_unlock(&uq->uq_key);
+		umtx_key_release(&uq->uq_key);
+	}
+
+	/* A wake that raced with a timeout or signal still wins. */
+	if (w.w_index != UMTXQ_WAKE_NONE) {
+		td->td_retval[0] = w.w_index;
+		return (0);
+	}
+	return (error);
+}
