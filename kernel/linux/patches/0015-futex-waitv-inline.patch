From eb40b2ea20ad7c4ee83a785bf2d084177f1fd8b5 Mon Sep 17 00:00:00 2001
From: Julia Klee <71413974+kleeedolinux@users.noreply.github.com>
Date: Fri, 30 Oct 2026 15:51:10 -0300
Subject: [PATCH 15/21] futex: futex_waitv on up to four futexes uses an
 on-stack vector

sys_futex_waitv() did a kzalloc/kfree of the futex_vector array on every
call. Wine/Proton fsync waits on one to three objects almost always; use
an on-stack array for up to FUTEX_WAITV_INLINE (4) entries.
futex_parse_waitv() fills every field that is used, so no zeroing.
Off: futex.waitv_inline=0. KUnit: wolos_futex_spin waitv_inline_bound.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
SPDX-License-Identifier: GPL-2.0-only
---
 kernel/futex/futex.h      | 13 +++++++++++++
 kernel/futex/spin_kunit.c | 16 ++++++++++++++++
 kernel/futex/syscalls.c   | 17 ++++++++++++-----
 kernel/futex/waitwake.c   |  5 +++++
 4 files changed, 46 insertions(+), 5 deletions(-)

diff --git a/kernel/futex/futex.h b/kernel/futex/futex.h
index 3ffa01ddd86..40ad04d6ff8 100644
--- a/kernel/futex/futex.h
+++ b/kernel/futex/futex.h
@@ -480,6 +480,19 @@ struct futex_vector {
 	struct futex_q q;
 };
 
+/*
+ * WolKernel: futex_waitv() on up to FUTEX_WAITV_INLINE futexes (Wine/Proton
+ * waits on one to three objects almost always) uses an on-stack vector
+ * instead of a kzalloc/kfree per call. Off: futex.waitv_inline=0.
+ */
+#define FUTEX_WAITV_INLINE	4
+extern bool futex_waitv_inline_on;
+
+static inline bool futex_waitv_inline(unsigned int nr)
+{
+	return READ_ONCE(futex_waitv_inline_on) && nr <= FUTEX_WAITV_INLINE;
+}
+
 extern int futex_parse_waitv(struct futex_vector *futexv,
 			     struct futex_waitv __user *uwaitv,
 			     unsigned int nr_futexes, futex_wake_fn *wake,
diff --git a/kernel/futex/spin_kunit.c b/kernel/futex/spin_kunit.c
index 57b3007a1ef..9360083bd35 100644
--- a/kernel/futex/spin_kunit.c
+++ b/kernel/futex/spin_kunit.c
@@ -32,10 +32,25 @@ static void score_moves(struct kunit *t)
 	KUNIT_EXPECT_EQ(t, s, 1U);
 }
 
+static void waitv_inline_bound(struct kunit *t)
+{
+	bool saved = futex_waitv_inline_on;
+
+	futex_waitv_inline_on = true;
+	KUNIT_EXPECT_TRUE(t, futex_waitv_inline(1));
+	KUNIT_EXPECT_TRUE(t, futex_waitv_inline(FUTEX_WAITV_INLINE));
+	KUNIT_EXPECT_FALSE(t, futex_waitv_inline(FUTEX_WAITV_INLINE + 1));
+	KUNIT_EXPECT_FALSE(t, futex_waitv_inline(FUTEX_WAITV_MAX));
+	futex_waitv_inline_on = false;	/* off: always the heap vector */
+	KUNIT_EXPECT_FALSE(t, futex_waitv_inline(1));
+	futex_waitv_inline_on = saved;
+}
+
 static struct kunit_case futex_spin_cases[] = {
 	KUNIT_CASE(budget_off_cases),
 	KUNIT_CASE(budget_scales_with_score),
 	KUNIT_CASE(score_moves),
+	KUNIT_CASE(waitv_inline_bound),
 	{}
 };
 
@@ -45,3 +60,4 @@ static struct kunit_suite futex_spin_suite = {
 };
 kunit_test_suite(futex_spin_suite);
 MODULE_LICENSE("GPL");
+MODULE_IMPORT_NS("EXPORTED_FOR_KUNIT_TESTING");
diff --git a/kernel/futex/syscalls.c b/kernel/futex/syscalls.c
index 2fa19d9d008..fd2f7922741 100644
--- a/kernel/futex/syscalls.c
+++ b/kernel/futex/syscalls.c
@@ -322,6 +322,7 @@ SYSCALL_DEFINE5(futex_waitv, struct futex_waitv __user *, waiters,
 		unsigned int, nr_futexes, unsigned int, flags,
 		struct __kernel_timespec __user *, timeout, clockid_t, clockid)
 {
+	struct futex_vector inline_futexv[FUTEX_WAITV_INLINE];
 	struct hrtimer_sleeper to;
 	struct futex_vector *futexv;
 	int ret;
@@ -336,10 +337,15 @@ SYSCALL_DEFINE5(futex_waitv, struct futex_waitv __user *, waiters,
 	if (timeout && (ret = futex2_setup_timeout(timeout, clockid, &to)))
 		return ret;
 
-	futexv = kzalloc_objs(*futexv, nr_futexes);
-	if (!futexv) {
-		ret = -ENOMEM;
-		goto destroy_timer;
+	/* futex_parse_waitv() fills every used field: no zeroing needed. */
+	if (futex_waitv_inline(nr_futexes)) {
+		futexv = inline_futexv;
+	} else {
+		futexv = kzalloc_objs(*futexv, nr_futexes);
+		if (!futexv) {
+			ret = -ENOMEM;
+			goto destroy_timer;
+		}
 	}
 
 	ret = futex_parse_waitv(futexv, waiters, nr_futexes, futex_wake_mark,
@@ -347,7 +353,8 @@ SYSCALL_DEFINE5(futex_waitv, struct futex_waitv __user *, waiters,
 	if (!ret)
 		ret = futex_wait_multiple(futexv, nr_futexes, timeout ? &to : NULL);
 
-	kfree(futexv);
+	if (futexv != inline_futexv)
+		kfree(futexv);
 
 destroy_timer:
 	if (timeout)
diff --git a/kernel/futex/waitwake.c b/kernel/futex/waitwake.c
index da9071585df..47a019e5d11 100644
--- a/kernel/futex/waitwake.c
+++ b/kernel/futex/waitwake.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 
 #include <linux/moduleparam.h>
+#include <kunit/visibility.h>
 #include <linux/sched/clock.h>
 #include <linux/random.h>
 #include <linux/sched/stat.h>
@@ -382,6 +383,10 @@ static long futex_wait_restart(struct restart_block *restart);
 static unsigned int futex_spin_ns __read_mostly = 4000;
 module_param_named(spin_ns, futex_spin_ns, uint, 0644);
 
+bool futex_waitv_inline_on __read_mostly = true;
+module_param_named(waitv_inline, futex_waitv_inline_on, bool, 0644);
+EXPORT_SYMBOL_IF_KUNIT(futex_waitv_inline_on);
+
 static void futex_spin_wait(struct futex_q *q)
 {
 	struct futex_hash_bucket *hb;
-- 
