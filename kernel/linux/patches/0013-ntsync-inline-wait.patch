From c29c75f43cb41038ece49441ff83631c8e8abf86 Mon Sep 17 00:00:00 2001
From: Julia Klee <71413974+kleeedolinux@users.noreply.github.com>
Date: Fri, 30 Oct 2026 15:32:05 -0300
Subject: [PATCH 13/21] ntsync: waits on up to four objects use an on-stack
 queue

setup_wait() did a kmalloc/kfree pair per NTSYNC_IOC_WAIT_ANY/ALL even
though Wine waits on one to three objects almost always. Use a buffer
on the waiter's stack when the entries (alert included) fit in four;
the waiter unqueues every entry before it returns, so nothing outlives
it. Off: /sys/module/ntsync/parameters/inline_wait=0. KUnit:
wolos_ntsync_q.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
SPDX-License-Identifier: GPL-2.0-only
---
 drivers/misc/Kconfig        |  5 ++++
 drivers/misc/ntsync.c       | 51 ++++++++++++++++++++++++++++++++-----
 drivers/misc/ntsync_kunit.c | 46 +++++++++++++++++++++++++++++++++
 3 files changed, 95 insertions(+), 7 deletions(-)
 create mode 100644 drivers/misc/ntsync_kunit.c

diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index c40e89cc572..09ad430145e 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -464,6 +464,11 @@ config NTSYNC
 
 	  If unsure, say N.
 
+config NTSYNC_KUNIT_TEST
+	bool "KUnit test for the WolKernel ntsync inline wait buffer" if !KUNIT_ALL_TESTS
+	depends on NTSYNC && KUNIT=y
+	default KUNIT_ALL_TESTS
+
 config VCPU_STALL_DETECTOR
 	tristate "Guest vCPU stall detector"
 	depends on OF && HAS_IOMEM
diff --git a/drivers/misc/ntsync.c b/drivers/misc/ntsync.c
index 2857ae37d3c..df9beebae7f 100644
--- a/drivers/misc/ntsync.c
+++ b/drivers/misc/ntsync.c
@@ -119,6 +119,37 @@ struct ntsync_q {
 	struct ntsync_q_entry entries[];
 };
 
+/*
+ * WolKernel: Wine waits on one to three objects almost always. A wait with up
+ * to NTSYNC_Q_INLINE entries (alert included) uses this on-stack buffer
+ * instead of a kmalloc/kfree pair per wait; the queue entries live until the
+ * waiter has unqueued itself, which happens before it returns.
+ * Off: /sys/module/ntsync/parameters/inline_wait=0.
+ */
+#define NTSYNC_Q_INLINE 4
+
+struct ntsync_q_buf {
+	u8 raw[struct_size_t(struct ntsync_q, entries, NTSYNC_Q_INLINE)]
+		__aligned(SMP_CACHE_BYTES);	/* a waker writes here: no line shared with the frame */
+};
+
+static bool ntsync_inline_wait __read_mostly = true;
+module_param_named(inline_wait, ntsync_inline_wait, bool, 0644);
+
+/* The wait's q: the caller's buffer when it fits and the switch is on, else the heap. */
+static struct ntsync_q *ntsync_q_get(struct ntsync_q_buf *buf, __u32 total_count)
+{
+	if (READ_ONCE(ntsync_inline_wait) && total_count <= NTSYNC_Q_INLINE)
+		return (struct ntsync_q *)buf->raw;
+	return kmalloc(struct_size_t(struct ntsync_q, entries, total_count), GFP_KERNEL);
+}
+
+static void ntsync_q_put(struct ntsync_q_buf *buf, struct ntsync_q *q)
+{
+	if (q != (struct ntsync_q *)buf->raw)
+		kfree(q);
+}
+
 struct ntsync_device {
 	/*
 	 * Wait-all operations must atomically grab all objects, and be totally
@@ -863,7 +894,7 @@ static int ntsync_schedule(const struct ntsync_q *q, const struct ntsync_wait_ar
  */
 static int setup_wait(struct ntsync_device *dev,
 		      const struct ntsync_wait_args *args, bool all,
-		      struct ntsync_q **ret_q)
+		      struct ntsync_q_buf *buf, struct ntsync_q **ret_q)
 {
 	int fds[NTSYNC_MAX_WAIT_COUNT + 1];
 	const __u32 count = args->count;
@@ -890,7 +921,7 @@ static int setup_wait(struct ntsync_device *dev,
 	if (args->alert)
 		fds[count] = args->alert;
 
-	q = kmalloc_flex(*q, entries, total_count);
+	q = ntsync_q_get(buf, total_count);
 	if (!q)
 		return -ENOMEM;
 	q->task = current;
@@ -928,7 +959,7 @@ static int setup_wait(struct ntsync_device *dev,
 err:
 	for (j = 0; j < i; j++)
 		put_obj(q->entries[j].obj);
-	kfree(q);
+	ntsync_q_put(buf, q);
 	return -EINVAL;
 }
 
@@ -949,6 +980,7 @@ static void try_wake_any_obj(struct ntsync_obj *obj)
 
 static int ntsync_wait_any(struct ntsync_device *dev, void __user *argp)
 {
+	struct ntsync_q_buf qbuf;
 	struct ntsync_wait_args args;
 	__u32 i, total_count;
 	struct ntsync_q *q;
@@ -959,7 +991,7 @@ static int ntsync_wait_any(struct ntsync_device *dev, void __user *argp)
 	if (copy_from_user(&args, argp, sizeof(args)))
 		return -EFAULT;
 
-	ret = setup_wait(dev, &args, false, &q);
+	ret = setup_wait(dev, &args, false, &qbuf, &q);
 	if (ret < 0)
 		return ret;
 
@@ -1027,12 +1059,13 @@ static int ntsync_wait_any(struct ntsync_device *dev, void __user *argp)
 		ret = -ETIMEDOUT;
 	}
 
-	kfree(q);
+	ntsync_q_put(&qbuf, q);
 	return ret;
 }
 
 static int ntsync_wait_all(struct ntsync_device *dev, void __user *argp)
 {
+	struct ntsync_q_buf qbuf;
 	struct ntsync_wait_args args;
 	struct ntsync_q *q;
 	int signaled;
@@ -1042,7 +1075,7 @@ static int ntsync_wait_all(struct ntsync_device *dev, void __user *argp)
 	if (copy_from_user(&args, argp, sizeof(args)))
 		return -EFAULT;
 
-	ret = setup_wait(dev, &args, true, &q);
+	ret = setup_wait(dev, &args, true, &qbuf, &q);
 	if (ret < 0)
 		return ret;
 
@@ -1143,7 +1176,7 @@ static int ntsync_wait_all(struct ntsync_device *dev, void __user *argp)
 		ret = -ETIMEDOUT;
 	}
 
-	kfree(q);
+	ntsync_q_put(&qbuf, q);
 	return ret;
 }
 
@@ -1213,3 +1246,7 @@ module_misc_device(ntsync_misc);
 MODULE_AUTHOR("Elizabeth Figura <zfigura@codeweavers.com>");
 MODULE_DESCRIPTION("Kernel driver for NT synchronization primitives");
 MODULE_LICENSE("GPL");
+
+#if IS_ENABLED(CONFIG_NTSYNC_KUNIT_TEST)
+#include "ntsync_kunit.c"
+#endif
diff --git a/drivers/misc/ntsync_kunit.c b/drivers/misc/ntsync_kunit.c
new file mode 100644
index 00000000000..c4e1fdf77e8
--- /dev/null
+++ b/drivers/misc/ntsync_kunit.c
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * KUnit for the WolKernel ntsync inline wait buffer (included from ntsync.c):
+ * waits with up to NTSYNC_Q_INLINE entries use the caller's buffer, larger
+ * ones and the off switch use the heap, and put frees only heap queues.
+ */
+#include <kunit/test.h>
+
+static void ntsync_q_inline_or_heap(struct kunit *test)
+{
+	struct ntsync_q_buf buf;
+	bool saved = ntsync_inline_wait;
+	struct ntsync_q *q;
+	__u32 n;
+
+	ntsync_inline_wait = true;
+	for (n = 1; n <= NTSYNC_Q_INLINE; n++) {
+		q = ntsync_q_get(&buf, n);
+		KUNIT_EXPECT_PTR_EQ(test, q, (struct ntsync_q *)buf.raw);
+		/* every entry fits in the buffer */
+		KUNIT_EXPECT_LE(test, (u8 *)&q->entries[n] - buf.raw, (long)sizeof(buf.raw));
+		ntsync_q_put(&buf, q);
+	}
+	q = ntsync_q_get(&buf, NTSYNC_Q_INLINE + 1);
+	KUNIT_ASSERT_NOT_NULL(test, q);
+	KUNIT_EXPECT_PTR_NE(test, q, (struct ntsync_q *)buf.raw);
+	ntsync_q_put(&buf, q);
+
+	ntsync_inline_wait = false;	/* off: the stock heap queue */
+	q = ntsync_q_get(&buf, 1);
+	KUNIT_ASSERT_NOT_NULL(test, q);
+	KUNIT_EXPECT_PTR_NE(test, q, (struct ntsync_q *)buf.raw);
+	ntsync_q_put(&buf, q);
+	ntsync_inline_wait = saved;
+}
+
+static struct kunit_case ntsync_q_cases[] = {
+	KUNIT_CASE(ntsync_q_inline_or_heap),
+	{}
+};
+
+static struct kunit_suite ntsync_q_suite = {
+	.name = "wolos_ntsync_q",
+	.test_cases = ntsync_q_cases,
+};
+kunit_test_suite(ntsync_q_suite);
-- 
2.56.0

