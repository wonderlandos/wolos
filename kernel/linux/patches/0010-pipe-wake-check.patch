From aebb8baf58c9512c0c0c5ac624893310ddb9baa8 Mon Sep 17 00:00:00 2001
From: Julia Klee <71413974+kleeedolinux@users.noreply.github.com>
Date: Fri, 30 Oct 2026 14:10:07 -0300
Subject: [PATCH 10/21] pipe: skip the wait-queue lock when nobody sleeps

anon_pipe_read/write woke rd_wait/wr_wait unconditionally, so a writer
to an empty pipe took rd_wait.lock on every write even while the reader
was running, and the lock's cache line bounced between the two CPUs.
Check wq_has_sleeper() first; pipe_poll() gets the smp_mb() that orders
poll_wait() before its head/tail read (Oleg/Manfred, lkml 2501.0).
Off: /sys/module/pipe/parameters/wake_check=0. KUnit: wolos_pipe_wake.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
SPDX-License-Identifier: GPL-2.0-only
---
 fs/Kconfig      |  5 +++
 fs/pipe.c       | 41 ++++++++++++++++++++---
 fs/pipe_kunit.c | 87 +++++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 128 insertions(+), 5 deletions(-)
 create mode 100644 fs/pipe_kunit.c

diff --git a/fs/Kconfig b/fs/Kconfig
index e67220a15ea..dbf45b426c5 100644
--- a/fs/Kconfig
+++ b/fs/Kconfig
@@ -111,6 +111,11 @@ config EXPORTFS_BLOCK_OPS
 	  This option enables the export operations for a filesystem to support
 	  external block IO.
 
+config PIPE_WAKE_KUNIT_TEST
+	bool "KUnit test for the WolKernel pipe wake check" if !KUNIT_ALL_TESTS
+	depends on KUNIT=y
+	default KUNIT_ALL_TESTS
+
 config FILE_LOCKING
 	bool "Enable POSIX file locking API" if EXPERT
 	default y
diff --git a/fs/pipe.c b/fs/pipe.c
index 4fa69192e6f..756d4007067 100644
--- a/fs/pipe.c
+++ b/fs/pipe.c
@@ -77,6 +77,30 @@ static unsigned long pipe_user_pages_soft = PIPE_DEF_BUFFERS * INR_OPEN_CUR;
  * -- Manfred Spraul <manfred@colorfullife.com> 2002-05-09
  */
 
+/*
+ * WolKernel: skip the wait-queue lock when nobody sleeps on it. A writer to an
+ * empty pipe used to take rd_wait.lock on every write even while the reader
+ * was busy; the lock's cache line then bounces between the two CPUs.
+ * Waiters set their state with a full barrier (prepare_to_wait_event) and
+ * pipe_poll() orders poll_wait() before reading head/tail, so the
+ * wq_has_sleeper() check (smp_mb + list test) cannot miss a sleeper.
+ * Off: /sys/module/pipe/parameters/wake_check=0.
+ */
+static bool pipe_wake_check __read_mostly = true;
+module_param_named(wake_check, pipe_wake_check, bool, 0644);
+
+/* True when a wakeup on @wq must be issued. */
+static inline bool pipe_wake_needed(struct wait_queue_head *wq)
+{
+	return !READ_ONCE(pipe_wake_check) || wq_has_sleeper(wq);
+}
+
+static inline void pipe_wake_sync(struct wait_queue_head *wq, __poll_t key)
+{
+	if (pipe_wake_needed(wq))
+		wake_up_interruptible_sync_poll(wq, key);
+}
+
 #ifdef CONFIG_PROVE_LOCKING
 static int pipe_lock_cmp_fn(const struct lockdep_map *a,
 			    const struct lockdep_map *b)
@@ -472,9 +496,9 @@ anon_pipe_read(struct kiocb *iocb, struct iov_iter *to)
 	anon_pipe_trim_and_unlock(pipe);
 
 	if (wake_writer)
-		wake_up_interruptible_sync_poll(&pipe->wr_wait, EPOLLOUT | EPOLLWRNORM);
+		pipe_wake_sync(&pipe->wr_wait, EPOLLOUT | EPOLLWRNORM);
 	if (wake_next_reader)
-		wake_up_interruptible_sync_poll(&pipe->rd_wait, EPOLLIN | EPOLLRDNORM);
+		pipe_wake_sync(&pipe->rd_wait, EPOLLIN | EPOLLRDNORM);
 	kill_fasync(&pipe->fasync_writers, SIGIO, POLL_OUT);
 	return ret;
 }
@@ -644,7 +668,7 @@ anon_pipe_write(struct kiocb *iocb, struct iov_iter *from)
 		 */
 		mutex_unlock(&pipe->mutex);
 		if (was_empty)
-			wake_up_interruptible_sync_poll(&pipe->rd_wait, EPOLLIN | EPOLLRDNORM);
+			pipe_wake_sync(&pipe->rd_wait, EPOLLIN | EPOLLRDNORM);
 		kill_fasync(&pipe->fasync_readers, SIGIO, POLL_IN);
 		wait_event_interruptible_exclusive(pipe->wr_wait, pipe_writable(pipe));
 		mutex_lock(&pipe->mutex);
@@ -668,10 +692,10 @@ anon_pipe_write(struct kiocb *iocb, struct iov_iter *from)
 	 * ->pseudo_edgetrigger enables per-write wakeups, see pipe_poll()
 	 */
 	if (was_empty || READ_ONCE(pipe->pseudo_edgetrigger))
-		wake_up_interruptible_sync_poll(&pipe->rd_wait, EPOLLIN | EPOLLRDNORM);
+		pipe_wake_sync(&pipe->rd_wait, EPOLLIN | EPOLLRDNORM);
 	kill_fasync(&pipe->fasync_readers, SIGIO, POLL_IN);
 	if (wake_next_writer)
-		wake_up_interruptible_sync_poll(&pipe->wr_wait, EPOLLOUT | EPOLLWRNORM);
+		pipe_wake_sync(&pipe->wr_wait, EPOLLOUT | EPOLLWRNORM);
 	return ret;
 }
 
@@ -759,6 +783,9 @@ pipe_poll(struct file *filp, poll_table *wait)
 		poll_wait(filp, &pipe->rd_wait, wait);
 	if (filp->f_mode & FMODE_WRITE)
 		poll_wait(filp, &pipe->wr_wait, wait);
+	/* Pairs with wq_has_sleeper() in pipe_wake_sync(). */
+	if (wait && READ_ONCE(pipe_wake_check))
+		smp_mb();
 
 	/*
 	 * .. and only then can you do the racy tests. That way,
@@ -1633,3 +1660,7 @@ static int __init init_pipe_fs(void)
 }
 
 fs_initcall(init_pipe_fs);
+
+#ifdef CONFIG_PIPE_WAKE_KUNIT_TEST
+#include "pipe_kunit.c"
+#endif
diff --git a/fs/pipe_kunit.c b/fs/pipe_kunit.c
new file mode 100644
index 00000000000..a8ce66a5122
--- /dev/null
+++ b/fs/pipe_kunit.c
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * KUnit for the WolKernel pipe wake check (included from fs/pipe.c).
+ * pipe_wake_needed() must report a sleeper whenever one is queued, and a
+ * blocked reader must still be woken by a write with the check on.
+ */
+#include <kunit/test.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/kthread.h>
+
+static void pipe_wake_needed_tracks_sleepers(struct kunit *test)
+{
+	struct wait_queue_head wq;
+	struct wait_queue_entry e;
+	bool saved = pipe_wake_check;
+
+	init_waitqueue_head(&wq);
+	init_waitqueue_entry(&e, current);
+	pipe_wake_check = true;
+	KUNIT_EXPECT_FALSE(test, pipe_wake_needed(&wq));
+	add_wait_queue(&wq, &e);
+	KUNIT_EXPECT_TRUE(test, pipe_wake_needed(&wq));
+	remove_wait_queue(&wq, &e);
+	KUNIT_EXPECT_FALSE(test, pipe_wake_needed(&wq));
+	pipe_wake_check = false;	/* off: always wake, the stock behaviour */
+	KUNIT_EXPECT_TRUE(test, pipe_wake_needed(&wq));
+	pipe_wake_check = saved;
+}
+
+struct pipe_wake_ctx {
+	struct file *rd;
+	struct completion started, done;
+	char buf[8];
+	ssize_t ret;
+};
+
+static int pipe_wake_reader(void *data)
+{
+	struct pipe_wake_ctx *c = data;
+	loff_t pos = 0;
+
+	complete(&c->started);
+	c->ret = kernel_read(c->rd, c->buf, sizeof(c->buf), &pos);
+	complete(&c->done);
+	return 0;
+}
+
+/* Many rounds: reader blocks first (or not yet), writer writes; no round may hang. */
+static void pipe_wake_blocked_reader(struct kunit *test)
+{
+	struct file *f[2];
+	int i;
+
+	KUNIT_ASSERT_EQ(test, create_pipe_files(f, 0), 0);
+	for (i = 0; i < 200; i++) {
+		struct pipe_wake_ctx c = { .rd = f[0] };
+		struct task_struct *t;
+		loff_t pos = 0;
+
+		init_completion(&c.started);
+		init_completion(&c.done);
+		t = kthread_run(pipe_wake_reader, &c, "pipe_wake_kunit");
+		KUNIT_ASSERT_FALSE(test, IS_ERR(t));
+		wait_for_completion(&c.started);
+		if (i & 1)
+			msleep(1);	/* odd rounds: the reader is surely asleep */
+		KUNIT_ASSERT_EQ(test, kernel_write(f[1], "x", 1, &pos), 1);
+		KUNIT_ASSERT_NE_MSG(test, wait_for_completion_timeout(&c.done, 5 * HZ), 0,
+				    "reader not woken in round %d", i);
+		KUNIT_EXPECT_EQ(test, c.ret, 1);
+	}
+	fput(f[0]);
+	fput(f[1]);
+}
+
+static struct kunit_case pipe_wake_cases[] = {
+	KUNIT_CASE(pipe_wake_needed_tracks_sleepers),
+	KUNIT_CASE(pipe_wake_blocked_reader),
+	{}
+};
+
+static struct kunit_suite pipe_wake_suite = {
+	.name = "wolos_pipe_wake",
+	.test_cases = pipe_wake_cases,
+};
+kunit_test_suite(pipe_wake_suite);
-- 
