From e8cc1457024c6bce09437d1e834a51bde90ddfcd Mon Sep 17 00:00:00 2001
From: kleeedolinux <71413974+kleeedolinux@users.noreply.github.com>
Date: Sat, 31 Oct 2026 03:41:22 +0000
Subject: [PATCH] x86/entry: out-of-range syscalls return -ENOSYS under ptrace

An invalid syscall number left regs->ax untouched, so a tracer that wrote
ax at the entry stop got its own value back instead of -ENOSYS. Number -1
keeps that behaviour: it is how a tracer skips a syscall.

tools/testing/selftests/x86/syscall_numbering_64 failed 37800 calls
without CONFIG_X86_X32_ABI.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
SPDX-License-Identifier: GPL-2.0-only
---
 arch/x86/entry/syscall_64.c | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/arch/x86/entry/syscall_64.c b/arch/x86/entry/syscall_64.c
index 966d3d1b758..bcefc867d5e 100644
--- a/arch/x86/entry/syscall_64.c
+++ b/arch/x86/entry/syscall_64.c
@@ -67,11 +67,14 @@ static __always_inline bool do_syscall_x64(struct pt_regs *regs, unsigned long n
 static __always_inline void do_syscall_x32(struct pt_regs *regs, unsigned long nr)
 {
 	/* Adjust the starting offset of the table */
-	nr -= __X32_SYSCALL_BIT;
-
-	if (IS_ENABLED(CONFIG_X86_X32_ABI) && likely(nr < X32_NR_syscalls)) {
-		nr = array_index_nospec(nr, X32_NR_syscalls);
-		regs->ax = x32_sys_call(regs, (unsigned int)nr);
+	unsigned long xnr = nr - __X32_SYSCALL_BIT;
+
+	if (IS_ENABLED(CONFIG_X86_X32_ABI) && likely(xnr < X32_NR_syscalls)) {
+		xnr = array_index_nospec(xnr, X32_NR_syscalls);
+		regs->ax = x32_sys_call(regs, (unsigned int)xnr);
+	} else if ((int)nr != -1) {
+		/* A tracer may have written ax at syscall entry. */
+		regs->ax = -ENOSYS;
 	}
 }
 
