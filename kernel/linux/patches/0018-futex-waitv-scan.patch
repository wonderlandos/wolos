diff --git a/kernel/futex/.kunitconfig b/kernel/futex/.kunitconfig
new file mode 100644
index 00000000000..a2855d0a9be
--- /dev/null
+++ b/kernel/futex/.kunitconfig
@@ -0,0 +1,3 @@
+CONFIG_KUNIT=y
+CONFIG_FUTEX=y
+CONFIG_FUTEX_SPIN_KUNIT_TEST=y
diff --git a/kernel/futex/futex.h b/kernel/futex/futex.h
index 8972a8beb7a..0b01e5b74b0 100644
--- a/kernel/futex/futex.h
+++ b/kernel/futex/futex.h
@@ -510,6 +510,65 @@ static inline bool futex_value_differs(u32 __user *uaddr, u32 val)
 	return !futex_get_value_locked(&cur, uaddr) && cur != val;
 }
 
+/*
+ * WolKernel: futex_waitv()'s non-blocking answer in one pass over the user's
+ * array and timeout, inside one user access window: no key, no hash, no lock,
+ * no copy. Only when every entry is plain (u32, private or shared, aligned, no
+ * reserved bits) and the timeout is valid does the scan have a verdict, and
+ * any word that differs means the kernel can only say -EWOULDBLOCK. Everything
+ * else, a fault included, is FUTEX_SCAN_FULL and the full path decides, so no
+ * error can change: the scan reads every word because an unreadable one at any
+ * index may have to win over the mismatch. A word that differs is a valid
+ * linearization; a word that matches is read again under the bucket lock
+ * before any sleep. May fault in user pages: only for syscall context.
+ */
+enum { FUTEX_SCAN_FULL, FUTEX_SCAN_MATCH, FUTEX_SCAN_DIFFERS };
+
+#ifndef masked_user_access_begin
+#define mask_user_address(p) (access_ok(p, sizeof(*(p))) ? (p) : NULL)
+#endif
+
+static __always_inline int futex_waitv_scan(const struct futex_waitv __user *uw,
+					    unsigned int nr,
+					    const struct __kernel_timespec __user *to)
+{
+	u32 odd = 0, diff = 0;
+	unsigned int i;
+
+	scoped_user_read_access_size(uw, nr * sizeof(*uw), full) {
+		if (to) {
+			const struct __kernel_timespec __user *t = mask_user_address(to);
+			s64 sec, nsec;
+
+			unsafe_get_user(sec, &t->tv_sec, full);
+			unsafe_get_user(nsec, &t->tv_nsec, full);
+			if (in_compat_syscall())
+				nsec = (u32)nsec;
+			odd = (sec < 0) | ((u64)nsec >= NSEC_PER_SEC);
+		}
+		for (i = 0; i < nr; i++) {
+			u64 val, uaddr;
+			u32 fl, rsv, cur;
+			u32 __user *word;
+
+			unsafe_get_user(val, &uw[i].val, full);
+			unsafe_get_user(uaddr, &uw[i].uaddr, full);
+			unsafe_get_user(fl, &uw[i].flags, full);
+			unsafe_get_user(rsv, &uw[i].__reserved, full);
+			odd |= ((fl & ~FUTEX2_PRIVATE) ^ FUTEX2_SIZE_U32) | rsv |
+			       (u32)(val >> 32) | ((u32)uaddr & 3);
+			word = mask_user_address(u64_to_user_ptr(uaddr));
+			unsafe_get_user(cur, word, full);
+			diff |= cur ^ (u32)val;
+		}
+	}
+	if (odd)
+		return FUTEX_SCAN_FULL;
+	return diff ? FUTEX_SCAN_DIFFERS : FUTEX_SCAN_MATCH;
+full:
+	return FUTEX_SCAN_FULL;
+}
+
 extern int futex_parse_waitv(struct futex_vector *futexv,
 			     struct futex_waitv __user *uwaitv,
 			     unsigned int nr_futexes, futex_wake_fn *wake,
diff --git a/kernel/futex/spin_kunit.c b/kernel/futex/spin_kunit.c
index 87a0fefffce..5227265f974 100644
--- a/kernel/futex/spin_kunit.c
+++ b/kernel/futex/spin_kunit.c
@@ -64,12 +64,160 @@ static void precheck_reads_user_value(struct kunit *t)
 	KUNIT_EXPECT_FALSE(t, futex_value_differs((u32 __user *)(addr - PAGE_SIZE), 6));
 }
 
+/* One page of user memory: word[] at the start, then the waitv array. */
+struct scan_ctx {
+	struct futex_waitv __user *uw;
+	u32 __user *word;
+	unsigned long addr;
+};
+
+static void scan_setup(struct kunit *t, struct scan_ctx *c)
+{
+	u32 five = 5;
+
+	c->addr = kunit_vm_mmap(t, NULL, 0, PAGE_SIZE, PROT_READ | PROT_WRITE,
+				MAP_ANONYMOUS | MAP_PRIVATE, 0);
+	KUNIT_ASSERT_NE(t, c->addr, 0UL);
+	c->word = (u32 __user *)c->addr;
+	c->uw = (struct futex_waitv __user *)(c->addr + 256);
+	KUNIT_ASSERT_EQ(t, copy_to_user(c->word, &five, sizeof(five)), 0UL);
+}
+
+enum { NORMAL, BAD_FLAGS, BAD_NUMA, BAD_RSV, BAD_VAL, BAD_ALIGN, BAD_UNMAPPED, BAD_KERNEL };
+
+static const struct {
+	const char *name;
+	u64 v0;		/* expected value of entry 0 (word holds 5) */
+	u32 fl0;
+	int odd;	/* what is wrong with entry 1 */
+	int want;
+} scan_cases[] = {
+	{ "all match", 5, FUTEX2_SIZE_U32, NORMAL, FUTEX_SCAN_MATCH },
+	{ "differs", 6, FUTEX2_SIZE_U32, NORMAL, FUTEX_SCAN_DIFFERS },
+	{ "differs private", 6, FUTEX2_SIZE_U32 | FUTEX2_PRIVATE, NORMAL, FUTEX_SCAN_DIFFERS },
+	{ "unknown flag", 6, FUTEX2_SIZE_U32, BAD_FLAGS, FUTEX_SCAN_FULL },
+	{ "numa entry", 6, FUTEX2_SIZE_U32, BAD_NUMA, FUTEX_SCAN_FULL },
+	{ "reserved set", 6, FUTEX2_SIZE_U32, BAD_RSV, FUTEX_SCAN_FULL },
+	{ "value over 32 bits", 6, FUTEX2_SIZE_U32, BAD_VAL, FUTEX_SCAN_FULL },
+	{ "misaligned word", 6, FUTEX2_SIZE_U32, BAD_ALIGN, FUTEX_SCAN_FULL },
+	{ "unmapped word", 6, FUTEX2_SIZE_U32, BAD_UNMAPPED, FUTEX_SCAN_FULL },
+	{ "kernel word", 6, FUTEX2_SIZE_U32, BAD_KERNEL, FUTEX_SCAN_FULL },
+};
+
+static void waitv_scan_table(struct kunit *t)
+{
+	struct scan_ctx c;
+	unsigned int i;
+
+	scan_setup(t, &c);
+	for (i = 0; i < ARRAY_SIZE(scan_cases); i++) {
+		struct futex_waitv w[2] = {
+			{ .val = scan_cases[i].v0, .uaddr = c.addr, .flags = scan_cases[i].fl0 },
+			{ .val = 5, .uaddr = c.addr, .flags = FUTEX2_SIZE_U32 },
+		};
+
+		switch (scan_cases[i].odd) {
+		case BAD_FLAGS:		w[1].flags |= 0x40; break;
+		case BAD_NUMA:		w[1].flags |= FUTEX2_NUMA; break;
+		case BAD_RSV:		w[1].__reserved = 1; break;
+		case BAD_VAL:		w[1].val |= 1ULL << 32; break;
+		case BAD_ALIGN:		w[1].uaddr += 1; break;
+		case BAD_UNMAPPED:	w[1].uaddr = c.addr - PAGE_SIZE; break;
+		case BAD_KERNEL:	w[1].uaddr = (unsigned long)&c; break;
+		}
+		KUNIT_ASSERT_EQ(t, copy_to_user(c.uw, w, sizeof(w)), 0UL);
+		KUNIT_EXPECT_EQ_MSG(t, futex_waitv_scan(c.uw, 2, NULL), scan_cases[i].want,
+				    "%s", scan_cases[i].name);
+	}
+}
+
+static void waitv_scan_array_fault(struct kunit *t)
+{
+	struct scan_ctx c;
+	struct futex_waitv w = { .val = 6, .flags = FUTEX2_SIZE_U32 };
+	struct futex_waitv __user *last;
+
+	scan_setup(t, &c);
+	w.uaddr = c.addr;
+	last = (struct futex_waitv __user *)(c.addr + PAGE_SIZE - sizeof(w));
+	KUNIT_ASSERT_EQ(t, copy_to_user(last, &w, sizeof(w)), 0UL);
+	KUNIT_EXPECT_EQ(t, futex_waitv_scan(last, 1, NULL), FUTEX_SCAN_DIFFERS);
+	/* entry 1 runs into the next page: whatever is there, no verdict */
+	vm_munmap(c.addr + PAGE_SIZE, PAGE_SIZE);
+	KUNIT_EXPECT_EQ(t, futex_waitv_scan(last, 2, NULL), FUTEX_SCAN_FULL);
+}
+
+static void waitv_scan_every_index(struct kunit *t)
+{
+	static struct futex_waitv w[FUTEX_WAITV_MAX];
+	struct scan_ctx c;
+	unsigned long big;
+	unsigned int i;
+
+	scan_setup(t, &c);
+	big = kunit_vm_mmap(t, NULL, 0, 2 * PAGE_SIZE, PROT_READ | PROT_WRITE,
+			    MAP_ANONYMOUS | MAP_PRIVATE, 0);
+	KUNIT_ASSERT_NE(t, big, 0UL);
+	for (i = 0; i < FUTEX_WAITV_MAX; i++) {
+		w[i].val = 5;
+		w[i].uaddr = c.addr;
+		w[i].flags = FUTEX2_SIZE_U32;
+		w[i].__reserved = 0;
+	}
+	for (i = 0; i < FUTEX_WAITV_MAX; i++) {
+		w[i].val = 4;
+		KUNIT_ASSERT_EQ(t, copy_to_user((void __user *)big, w, sizeof(w)), 0UL);
+		KUNIT_EXPECT_EQ(t, futex_waitv_scan((void __user *)big, FUTEX_WAITV_MAX, NULL),
+				FUTEX_SCAN_DIFFERS);
+		w[i].val = 5;
+	}
+	KUNIT_ASSERT_EQ(t, copy_to_user((void __user *)big, w, sizeof(w)), 0UL);
+	KUNIT_EXPECT_EQ(t, futex_waitv_scan((void __user *)big, FUTEX_WAITV_MAX, NULL),
+			FUTEX_SCAN_MATCH);
+}
+
+static void waitv_scan_timeout(struct kunit *t)
+{
+	static const struct {
+		s64 sec, nsec;
+		int want;
+	} cases[] = {
+		{ 1, 0, FUTEX_SCAN_DIFFERS },
+		{ 0, 999999999, FUTEX_SCAN_DIFFERS },
+		{ -1, 0, FUTEX_SCAN_FULL },
+		{ 0, NSEC_PER_SEC, FUTEX_SCAN_FULL },
+		{ 0, -1, FUTEX_SCAN_FULL },
+	};
+	struct futex_waitv w = { .val = 6, .flags = FUTEX2_SIZE_U32 };
+	struct __kernel_timespec __user *ut;
+	struct scan_ctx c;
+	unsigned int i;
+
+	scan_setup(t, &c);
+	w.uaddr = c.addr;
+	ut = (struct __kernel_timespec __user *)(c.addr + 128);
+	KUNIT_ASSERT_EQ(t, copy_to_user(c.uw, &w, sizeof(w)), 0UL);
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		struct __kernel_timespec ts = { cases[i].sec, cases[i].nsec };
+
+		KUNIT_ASSERT_EQ(t, copy_to_user(ut, &ts, sizeof(ts)), 0UL);
+		KUNIT_EXPECT_EQ(t, futex_waitv_scan(c.uw, 1, ut), cases[i].want);
+	}
+	/* an unreadable timeout has no verdict either */
+	KUNIT_EXPECT_EQ(t, futex_waitv_scan(c.uw, 1, (void __user *)(c.addr - PAGE_SIZE)),
+			FUTEX_SCAN_FULL);
+}
+
 static struct kunit_case futex_spin_cases[] = {
 	KUNIT_CASE(budget_off_cases),
 	KUNIT_CASE(budget_scales_with_score),
 	KUNIT_CASE(score_moves),
 	KUNIT_CASE(waitv_inline_bound),
 	KUNIT_CASE(precheck_reads_user_value),
+	KUNIT_CASE(waitv_scan_table),
+	KUNIT_CASE(waitv_scan_array_fault),
+	KUNIT_CASE(waitv_scan_every_index),
+	KUNIT_CASE(waitv_scan_timeout),
 	{}
 };
 
diff --git a/kernel/futex/syscalls.c b/kernel/futex/syscalls.c
index fd2f7922741..4a8d2b9f4ee 100644
--- a/kernel/futex/syscalls.c
+++ b/kernel/futex/syscalls.c
@@ -318,22 +318,20 @@ static inline void futex2_destroy_timeout(struct hrtimer_sleeper *to)
  * smallest index, nor the one most recently woken, nor...)
  */
 
-SYSCALL_DEFINE5(futex_waitv, struct futex_waitv __user *, waiters,
-		unsigned int, nr_futexes, unsigned int, flags,
-		struct __kernel_timespec __user *, timeout, clockid_t, clockid)
+/*
+ * The blocking half of sys_futex_waitv(): out of line, because its frame holds
+ * the vector and the timer that the non-blocking answer never touches.
+ */
+static noinline long futex_waitv_block(struct futex_waitv __user *waiters,
+				       unsigned int nr_futexes,
+				       struct __kernel_timespec __user *timeout,
+				       clockid_t clockid)
 {
-	struct futex_vector inline_futexv[FUTEX_WAITV_INLINE];
-	struct hrtimer_sleeper to;
+	struct futex_vector inline_futexv[FUTEX_WAITV_INLINE] __uninitialized;
+	struct hrtimer_sleeper to __uninitialized;
 	struct futex_vector *futexv;
 	int ret;
 
-	/* This syscall supports no flags for now */
-	if (flags)
-		return -EINVAL;
-
-	if (!nr_futexes || nr_futexes > FUTEX_WAITV_MAX || !waiters)
-		return -EINVAL;
-
 	if (timeout && (ret = futex2_setup_timeout(timeout, clockid, &to)))
 		return ret;
 
@@ -362,6 +360,26 @@ SYSCALL_DEFINE5(futex_waitv, struct futex_waitv __user *, waiters,
 	return ret;
 }
 
+
+SYSCALL_DEFINE5(futex_waitv, struct futex_waitv __user *, waiters,
+		unsigned int, nr_futexes, unsigned int, flags,
+		struct __kernel_timespec __user *, timeout, clockid_t, clockid)
+{
+	/* This syscall supports no flags for now */
+	if (flags)
+		return -EINVAL;
+
+	if (!nr_futexes || nr_futexes > FUTEX_WAITV_MAX || !waiters)
+		return -EINVAL;
+
+	if (READ_ONCE(futex_precheck_on) &&
+	    (!timeout || clockid == CLOCK_MONOTONIC || clockid == CLOCK_REALTIME) &&
+	    futex_waitv_scan(waiters, nr_futexes, timeout) == FUTEX_SCAN_DIFFERS)
+		return -EWOULDBLOCK;
+
+	return futex_waitv_block(waiters, nr_futexes, timeout, clockid);
+}
+
 /*
  * sys_futex_wake - Wake a number of futexes
  * @uaddr:	Address of the futex(es) to wake
diff --git a/kernel/futex/waitwake.c b/kernel/futex/waitwake.c
index 9fae31d9914..111cccec585 100644
--- a/kernel/futex/waitwake.c
+++ b/kernel/futex/waitwake.c
@@ -393,10 +393,11 @@ EXPORT_SYMBOL_IF_KUNIT(futex_waitv_inline_on);
  * is a valid linearization (the value differed at that instant); a value that
  * matches is still re-read under the bucket lock before sleeping, so no
  * wakeup can be lost. Wine/Proton fsync waits on already-signaled objects all
- * the time. Off: futex.precheck=0.
+ * the time. Off: futex.precheck=0, for FUTEX_WAIT and for futex_waitv_scan().
  */
 bool futex_precheck_on __read_mostly = true;
 module_param_named(precheck, futex_precheck_on, bool, 0644);
+EXPORT_SYMBOL_IF_KUNIT(futex_precheck_on);
 
 static void futex_spin_wait(struct futex_q *q)
 {
@@ -521,13 +522,8 @@ int futex_wait_multiple_setup(struct futex_vector *vs, int count, int *woken)
 	 * Private futexes doesn't need to recalculate hash in retry, so skip
 	 * get_futex_key() when retrying.
 	 */
-	if (READ_ONCE(futex_precheck_on)) {
-		for (i = 0; i < count; i++) {
-			if (futex_value_differs(u64_to_user_ptr(vs[i].w.uaddr), vs[i].w.val))
-				return -EWOULDBLOCK;
-		}
-	}
 retry:
+
 	for (i = 0; i < count; i++) {
 		if (!(vs[i].w.flags & FLAGS_SHARED) && retry)
 			continue;
@@ -769,8 +765,6 @@ int futex_wait_setup(u32 __user *uaddr, u32 val, unsigned int flags,
 	 * absorb a wakeup if *uaddr does not match the desired values
 	 * while the syscall executes.
 	 */
-	if (READ_ONCE(futex_precheck_on) && futex_value_differs(uaddr, val))
-		return -EWOULDBLOCK;
 retry:
 	ret = get_futex_key(uaddr, flags, &q->key, FUTEX_READ);
 	if (unlikely(ret != 0))
@@ -828,12 +822,16 @@ int futex_wait_setup(u32 __user *uaddr, u32 val, unsigned int flags,
 int __futex_wait(u32 __user *uaddr, unsigned int flags, u32 val,
 		 struct hrtimer_sleeper *to, u32 bitset)
 {
-	struct futex_q q = futex_q_init;
+	struct futex_q q __uninitialized;
 	int ret;
 
 	if (!bitset)
 		return -EINVAL;
 
+	if (READ_ONCE(futex_precheck_on) && futex_value_differs(uaddr, val))
+		return -EWOULDBLOCK;
+
+	q = futex_q_init;
 	q.bitset = bitset;
 
 retry:
@@ -867,7 +865,7 @@ int __futex_wait(u32 __user *uaddr, unsigned int flags, u32 val,
 
 int futex_wait(u32 __user *uaddr, unsigned int flags, u32 val, ktime_t *abs_time, u32 bitset)
 {
-	struct hrtimer_sleeper timeout, *to;
+	struct hrtimer_sleeper timeout __uninitialized, *to;
 	struct restart_block *restart;
 	int ret;
 
