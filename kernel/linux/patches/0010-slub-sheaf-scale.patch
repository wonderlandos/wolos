 #endif /* MM_SLAB_H */
diff --git a/mm/slub.c b/mm/slub.c
index 45e077c7526..1c4508d7474 100644
--- a/mm/slub.c
+++ b/mm/slub.c
@@ -20,6 +20,7 @@
 #include <linux/swab.h>
 #include <linux/bitops.h>
 #include <linux/slab.h>
+#include <kunit/visibility.h>
 #include "slab.h"
 #include <linux/vmalloc.h>
 #include <linux/proc_fs.h>
@@ -7991,6 +7992,43 @@ static int init_kmem_cache_nodes(struct kmem_cache *s)
 	return 1;
 }
 
+/*
+ * WolKernel: bigger per-CPU sheaves. The base capacity mirrors the old per-CPU
+ * partial sizing; on desktop churn (pipes, sockets, filp, dentry) a CPU drains
+ * a 26-object sheaf in a few hundred syscalls and goes to the node barn (a
+ * spinlock shared by every CPU). slub_sheaf_scale=N multiplies the base
+ * capacity (1..4, default 2); slub_sheaf_scale=1 is the stock size.
+ */
+static unsigned int slub_sheaf_scale __ro_after_init = 2;
+
+static int __init setup_slub_sheaf_scale(char *str)
+{
+	unsigned int v;
+
+	if (!kstrtouint(str, 0, &v))
+		slub_sheaf_scale = clamp(v, 1U, 4U);
+	return 0;
+}
+early_param("slub_sheaf_scale", setup_slub_sheaf_scale);
+
+/* Base sheaf capacity for an object of @size bytes, before rounding. */
+VISIBLE_IF_KUNIT unsigned int slub_sheaf_base_capacity(unsigned int size,
+						       unsigned int scale)
+{
+	unsigned int capacity;
+
+	if (size >= PAGE_SIZE)
+		capacity = 4;
+	else if (size >= 1024)
+		capacity = 12;
+	else if (size >= 256)
+		capacity = 26;
+	else
+		capacity = 60;
+	return capacity * clamp(scale, 1U, 4U);
+}
+EXPORT_SYMBOL_IF_KUNIT(slub_sheaf_base_capacity);
+
 static unsigned int calculate_sheaf_capacity(struct kmem_cache *s,
 					     struct kmem_cache_args *args)
 
@@ -8016,14 +8054,7 @@ static unsigned int calculate_sheaf_capacity(struct kmem_cache *s,
 	 * two percpu sheaves) as what was used for percpu partial slabs, which
 	 * should result in similar lock contention (barn or list_lock)
 	 */
-	if (s->size >= PAGE_SIZE)
-		capacity = 4;
-	else if (s->size >= 1024)
-		capacity = 12;
-	else if (s->size >= 256)
-		capacity = 26;
-	else
-		capacity = 60;
+	capacity = slub_sheaf_base_capacity(s->size, slub_sheaf_scale);
 
 	/* Increment capacity to make sheaf exactly a kmalloc size bucket */
 	size = struct_size_t(struct slab_sheaf, objects, capacity);
diff --git a/mm/slub_sheaf_kunit.c b/mm/slub_sheaf_kunit.c
new file mode 100644
index 00000000000..13f5f001765
--- /dev/null
+++ b/mm/slub_sheaf_kunit.c
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * KUnit for the WolKernel sheaf scale: the base capacity table times
+ * slub_sheaf_scale (clamped 1..4), and a new cache really gets it.
+ */
+#include <kunit/test.h>
+#include <linux/slab.h>
+#include "slab.h"
+
+static void sheaf_base_table(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, slub_sheaf_base_capacity(64, 1), 60);
+	KUNIT_EXPECT_EQ(test, slub_sheaf_base_capacity(256, 1), 26);
+	KUNIT_EXPECT_EQ(test, slub_sheaf_base_capacity(1024, 1), 12);
+	KUNIT_EXPECT_EQ(test, slub_sheaf_base_capacity(PAGE_SIZE, 1), 4);
+	KUNIT_EXPECT_EQ(test, slub_sheaf_base_capacity(256, 2), 52);
+	KUNIT_EXPECT_EQ(test, slub_sheaf_base_capacity(64, 0), 60);	/* clamped */
+	KUNIT_EXPECT_EQ(test, slub_sheaf_base_capacity(64, 9), 240);	/* clamped */
+}
+
+static void sheaf_cache_uses_scale(struct kunit *test)
+{
+	struct kmem_cache *s = kmem_cache_create("wolos_sheaf_kunit", 128, 0, 0, NULL);
+	unsigned int cap;
+	bool debug;
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	/* Default scale 2 (no boot parameter under KUnit), rounded up to a bucket. */
+	debug = s->flags & SLAB_DEBUG_FLAGS;
+	cap = s->sheaf_capacity;
+	kmem_cache_destroy(s);
+	if (debug)
+		kunit_skip(test, "slub_debug active: no sheaves");
+	KUNIT_EXPECT_GE(test, cap, 120U);
+}
+
+static struct kunit_case sheaf_cases[] = {
+	KUNIT_CASE(sheaf_base_table),
+	KUNIT_CASE(sheaf_cache_uses_scale),
+	{}
+};
+
+static struct kunit_suite sheaf_suite = {
+	.name = "wolos_slub_sheaf",
+	.test_cases = sheaf_cases,
+};
+kunit_test_suite(sheaf_suite);
+MODULE_DESCRIPTION("KUnit for the WolKernel SLUB sheaf scale");
+MODULE_LICENSE("GPL");
+MODULE_IMPORT_NS("EXPORTED_FOR_KUNIT_TESTING");
-- 
