From cd7ca20a638c4402d110e6f2fbbcda3ccb4f5e6f Mon Sep 17 00:00:00 2001
From: Julia Klee <71413974+kleeedolinux@users.noreply.github.com>
Date: Fri, 30 Oct 2026 14:31:53 -0300
Subject: [PATCH 10/13] mm/slub: slub_sheaf_scale, bigger per-CPU sheaves

The sheaf base capacity (60/26/12/4 by object size) mirrors the old
per-CPU partial sizing. Desktop churn drains a 26-object sheaf in a few
hundred syscalls and then goes to the node barn, a spinlock every CPU
shares. Multiply the base by slub_sheaf_scale (1..4, default 2);
slub_sheaf_scale=1 is the stock size. KUnit: wolos_slub_sheaf.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
SPDX-License-Identifier: GPL-2.0-only
---
 lib/Kconfig.debug     |  5 +++++
 mm/Makefile           |  1 +
 mm/slab.h             |  4 ++++
 mm/slub.c             | 47 +++++++++++++++++++++++++++++++++-------
 mm/slub_sheaf_kunit.c | 50 +++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 99 insertions(+), 8 deletions(-)
 create mode 100644 mm/slub_sheaf_kunit.c

diff --git a/lib/Kconfig.debug b/lib/Kconfig.debug
index 5012b0b8740..02844d510c9 100644
--- a/lib/Kconfig.debug
+++ b/lib/Kconfig.debug
@@ -3016,6 +3016,11 @@ config SHDI3_KUNIT_TEST
 	  shift left, arithmetic shift right and logical shift right,
 	  respectively, on a 32-bit CPUs.
 
+config SLUB_SHEAF_KUNIT_TEST
+	tristate "KUnit test for the WolKernel SLUB sheaf scale" if !KUNIT_ALL_TESTS
+	depends on KUNIT && !SLUB_TINY
+	default KUNIT_ALL_TESTS
+
 config SLUB_KUNIT_TEST
 	tristate "KUnit test for SLUB cache error detection" if !KUNIT_ALL_TESTS
 	depends on SLUB_DEBUG && KUNIT
diff --git a/mm/Makefile b/mm/Makefile
index 2a3ec53d62e..3cfdb5d1261 100644
--- a/mm/Makefile
+++ b/mm/Makefile
@@ -71,6 +71,7 @@ obj-y += init-mm.o
 obj-y += memblock.o
 obj-y += $(memory-hotplug-y)
 obj-y += slub.o
+obj-$(CONFIG_SLUB_SHEAF_KUNIT_TEST) += slub_sheaf_kunit.o
 
 ifdef CONFIG_MMU
 	obj-$(CONFIG_ADVISE_SYSCALLS)	+= madvise.o
diff --git a/mm/slab.h b/mm/slab.h
index e94ac63d10d..e838bb43262 100644
--- a/mm/slab.h
+++ b/mm/slab.h
@@ -945,4 +945,8 @@ static inline bool slub_debug_orig_size(struct kmem_cache *s)
 void skip_orig_size_check(struct kmem_cache *s, const void *object);
 #endif
 
+#if IS_ENABLED(CONFIG_KUNIT)
+unsigned int slub_sheaf_base_capacity(unsigned int size, unsigned int scale);
+#endif
