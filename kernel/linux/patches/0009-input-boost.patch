From ad3079bdc6a705b5b1b0fdcf840c9d8327977800 Mon Sep 17 00:00:00 2001
From: Julia Klee <71413974+kleeedolinux@users.noreply.github.com>
Date: Fri, 30 Oct 2026 12:09:47 -0300
Subject: [PATCH] wolos: input boost, CPU floor right after an input event

An input handler on key/button devices opens a wolos_input_boost.ms
(100 ms) window per event, rate-limited to one per 50 ms. While it is
open schedutil keeps every CPU at least at floor_pct (60%) of capacity,
and GPU drivers on wolos_input_boost_chain get a call. ms=0 turns it
off. KUnit: wolos_policy input_boost.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
SPDX-License-Identifier: GPL-2.0-only
---
 include/linux/wolos.h            |  10 +++
 include/linux/wolos_policy.h     |  19 +++++
 kernel/Kconfig.preempt           |   9 +++
 kernel/Makefile                  |   1 +
 kernel/sched/build_utility.c     |   1 +
 kernel/sched/cpufreq_schedutil.c |   1 +
 kernel/wolos_input_boost.c       | 115 +++++++++++++++++++++++++++++++
 lib/wolos_policy_kunit.c         |  19 +++++
 8 files changed, 175 insertions(+)
 create mode 100644 kernel/wolos_input_boost.c

diff --git a/include/linux/wolos.h b/include/linux/wolos.h
index 66ffba1ea..33ffd275b 100644
--- a/include/linux/wolos.h
+++ b/include/linux/wolos.h
@@ -11,4 +11,14 @@ int wolos_foreground_tgid(void);
 static inline int wolos_foreground_tgid(void) { return 0; }
 #endif
 
+#ifdef CONFIG_WOLOS_INPUT_BOOST
+#include <linux/notifier.h>
+/* Utilization floor for a CPU of capacity @cap while an input boost is open. */
+unsigned long wolos_input_boost_util(unsigned long cap);
+/* Called (atomic) with the window length in ms when a boost opens. */
+extern struct atomic_notifier_head wolos_input_boost_chain;
+#else
+static inline unsigned long wolos_input_boost_util(unsigned long cap) { return 0; }
+#endif
+
 #endif /* _LINUX_WOLOS_H */
diff --git a/include/linux/wolos_policy.h b/include/linux/wolos_policy.h
index 269ac8ac7..9a5021551 100644
--- a/include/linux/wolos_policy.h
+++ b/include/linux/wolos_policy.h
@@ -54,4 +54,23 @@ static inline long wolos_oom_bias(long points, unsigned long totalpages,
 	return points;
 }
 
+/*
+ * Input boost: fire at most once per @gap jiffies (signed difference, so it
+ * survives jiffies wrap). @last must start at least @gap before now.
+ */
+static inline bool wolos_boost_should_fire(unsigned long now, unsigned long last,
+					   unsigned long gap)
+{
+	return (long)(now - last - gap) >= 0;
+}
+
+/* Utilization floor while the boost window (until @until) is open, else 0. */
+static inline unsigned long wolos_boost_floor(unsigned long now, unsigned long until,
+					      unsigned long cap, unsigned int pct)
+{
+	if ((long)(until - now) <= 0)
+		return 0;
+	return cap * (pct > 100 ? 100 : pct) / 100;
+}
+
 #endif
diff --git a/kernel/Kconfig.preempt b/kernel/Kconfig.preempt
index 0ec0b36ad..13ddbc2eb 100644
--- a/kernel/Kconfig.preempt
+++ b/kernel/Kconfig.preempt
@@ -207,3 +207,12 @@ config WOLOS_HINTS
 	  Lets the WolOS session daemon publish the frontmost application
 	  (/sys/kernel/wolos/foreground_pid) so drivers can boost it only.
 	  QoS classes themselves use sched_setattr(2), see <linux/wolos.h>.
+
+config WOLOS_INPUT_BOOST
+	bool "WolOS input boost (CPU floor right after an input event)"
+	depends on WOLOS_HINTS && INPUT=y && CPU_FREQ_GOV_SCHEDUTIL
+	default y
+	help
+	  For wolos_input_boost.ms (100 ms) after a key, button or pointer
+	  event, schedutil keeps CPUs at least at floor_pct of capacity, and
+	  GPU drivers on wolos_input_boost_chain get a call. ms=0 turns it off.
diff --git a/kernel/Makefile b/kernel/Makefile
index 01a736956..8c1cd437f 100644
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -49,6 +49,7 @@ CFLAGS_kcov.o := $(call cc-option, -fno-conserve-stack) -fno-stack-protector
 
 obj-y += sched/
 obj-$(CONFIG_WOLOS_HINTS) += wolos_hints.o
+obj-$(CONFIG_WOLOS_INPUT_BOOST) += wolos_input_boost.o
 obj-y += locking/
 obj-y += power/
 obj-y += printk/
diff --git a/kernel/sched/build_utility.c b/kernel/sched/build_utility.c
index e2cf3b08d..4830229bc 100644
--- a/kernel/sched/build_utility.c
+++ b/kernel/sched/build_utility.c
@@ -20,6 +20,7 @@
 #include <linux/sched/task_stack.h>
 
 #include <linux/cpufreq.h>
+#include <linux/wolos.h>
 #include <linux/cpumask_api.h>
 #include <linux/cpuset.h>
 #include <linux/ctype.h>
diff --git a/kernel/sched/cpufreq_schedutil.c b/kernel/sched/cpufreq_schedutil.c
index 14405a614..4e2810a95 100644
--- a/kernel/sched/cpufreq_schedutil.c
+++ b/kernel/sched/cpufreq_schedutil.c
@@ -254,6 +254,7 @@ static void sugov_get_util(struct sugov_cpu *sg_cpu, unsigned long boost)
 	if (!scx_switched_all())
 		util += cpu_util_cfs_boost(sg_cpu->cpu);
 	util = effective_cpu_util(sg_cpu->cpu, util, &min, &max);
+	boost = max(boost, wolos_input_boost_util(max));
 	util = max(util, boost);
 	sg_cpu->bw_min = min;
 	sg_cpu->bw_max = max;
diff --git a/kernel/wolos_input_boost.c b/kernel/wolos_input_boost.c
new file mode 100644
index 000000000..5a4850b4e
--- /dev/null
+++ b/kernel/wolos_input_boost.c
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * WolOS input boost: the first frame after the user touches the keyboard,
+ * mouse, touchpad or a gamepad should not run at idle clocks. Each input
+ * event (rate-limited to one per 50 ms) opens a boost window of
+ * wolos_input_boost.ms milliseconds during which schedutil keeps every CPU at
+ * least at wolos_input_boost.floor_pct percent of its capacity, and GPU drivers
+ * on wolos_input_boost_chain get a call. ms=0 turns it off.
+ */
+#include <linux/init.h>
+#include <linux/input.h>
+#include <linux/jiffies.h>
+#include <linux/moduleparam.h>
+#include <linux/notifier.h>
+#include <linux/slab.h>
+#include <linux/wolos.h>
+#include <linux/wolos_policy.h>
+
+#undef MODULE_PARAM_PREFIX
+#define MODULE_PARAM_PREFIX "wolos_input_boost."
+
+static unsigned int boost_ms = 100;
+module_param_named(ms, boost_ms, uint, 0644);
+MODULE_PARM_DESC(ms, "Boost window after an input event in ms (0 = off)");
+
+static unsigned int floor_pct = 60;
+module_param_named(floor_pct, floor_pct, uint, 0644);
+MODULE_PARM_DESC(floor_pct, "CPU utilization floor during the window, percent of capacity");
+
+#define WIB_GAP_MS 50
+
+static unsigned long boost_until;
+static unsigned long last_fire;
+
+ATOMIC_NOTIFIER_HEAD(wolos_input_boost_chain);
+EXPORT_SYMBOL_GPL(wolos_input_boost_chain);
+
+unsigned long wolos_input_boost_util(unsigned long cap)
+{
+	return wolos_boost_floor(jiffies, READ_ONCE(boost_until), cap,
+				 READ_ONCE(floor_pct));
+}
+
+static void wib_event(struct input_handle *handle, unsigned int type,
+		      unsigned int code, int value)
+{
+	unsigned long now = jiffies, ms = READ_ONCE(boost_ms);
+
+	if (!ms || (type != EV_KEY && type != EV_REL && type != EV_ABS))
+		return;
+	if (!wolos_boost_should_fire(now, READ_ONCE(last_fire),
+				     msecs_to_jiffies(WIB_GAP_MS)))
+		return;
+	WRITE_ONCE(last_fire, now);
+	WRITE_ONCE(boost_until, now + msecs_to_jiffies(ms));
+	atomic_notifier_call_chain(&wolos_input_boost_chain, ms, NULL);
+}
+
+static int wib_connect(struct input_handler *handler, struct input_dev *dev,
+		       const struct input_device_id *id)
+{
+	struct input_handle *handle;
+	int err;
+
+	handle = kzalloc_obj(*handle);
+	if (!handle)
+		return -ENOMEM;
+	handle->dev = dev;
+	handle->handler = handler;
+	handle->name = "wolos_input_boost";
+	err = input_register_handle(handle);
+	if (err)
+		goto free;
+	err = input_open_device(handle);
+	if (err)
+		goto unregister;
+	return 0;
+unregister:
+	input_unregister_handle(handle);
+free:
+	kfree(handle);
+	return err;
+}
+
+static void wib_disconnect(struct input_handle *handle)
+{
+	input_close_device(handle);
+	input_unregister_handle(handle);
+	kfree(handle);
+}
+
+/*
+ * Devices with keys or buttons only: keyboards, mice, touchpads, gamepads.
+ * Sensors that stream EV_ABS without buttons (accelerometers) never boost.
+ */
+static const struct input_device_id wib_ids[] = {
+	{ .flags = INPUT_DEVICE_ID_MATCH_EVBIT, .evbit = { BIT_MASK(EV_KEY) } },
+	{ }
+};
+
+static struct input_handler wib_handler = {
+	.event		= wib_event,
+	.connect	= wib_connect,
+	.disconnect	= wib_disconnect,
+	.name		= "wolos_input_boost",
+	.id_table	= wib_ids,
+};
+
+static int __init wolos_input_boost_init(void)
+{
+	last_fire = jiffies - msecs_to_jiffies(WIB_GAP_MS);
+	boost_until = jiffies;
+	return input_register_handler(&wib_handler);
+}
+late_initcall(wolos_input_boost_init);
diff --git a/lib/wolos_policy_kunit.c b/lib/wolos_policy_kunit.c
index 834d40694..15ed99761 100644
--- a/lib/wolos_policy_kunit.c
+++ b/lib/wolos_policy_kunit.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 /* KUnit: WolKernel policy decisions (include/linux/wolos_policy.h). */
 #include <kunit/test.h>
+#include <linux/limits.h>
 #include <linux/wolos_policy.h>
 
 static void tsc_trust(struct kunit *t)
@@ -39,7 +40,25 @@ static void oom_bias(struct kunit *t)
 			wolos_oom_bias(800, 8000, true, false));
 }
 
+static void input_boost(struct kunit *t)
+{
+	unsigned long gap = 50;
+
+	KUNIT_EXPECT_TRUE(t, wolos_boost_should_fire(1000, 950, gap));
+	KUNIT_EXPECT_FALSE(t, wolos_boost_should_fire(1000, 951, gap));	/* rate limit */
+	/* across the jiffies wrap */
+	KUNIT_EXPECT_TRUE(t, wolos_boost_should_fire(10, ULONG_MAX - 40, gap));
+	KUNIT_EXPECT_FALSE(t, wolos_boost_should_fire(5, ULONG_MAX - 40, gap));
+
+	KUNIT_EXPECT_EQ(t, wolos_boost_floor(100, 200, 1024, 60), 614UL);
+	KUNIT_EXPECT_EQ(t, wolos_boost_floor(200, 200, 1024, 60), 0UL);	/* window closed */
+	KUNIT_EXPECT_EQ(t, wolos_boost_floor(300, 200, 1024, 60), 0UL);
+	KUNIT_EXPECT_EQ(t, wolos_boost_floor(100, 200, 1024, 250), 1024UL);	/* clamped */
+	KUNIT_EXPECT_EQ(t, wolos_boost_floor(ULONG_MAX - 5, 10, 1000, 50), 500UL); /* wrap */
+}
+
 static struct kunit_case wolos_policy_cases[] = {
+	KUNIT_CASE(input_boost),
 	KUNIT_CASE(tsc_trust),
 	KUNIT_CASE(kbd_bypass),
 	KUNIT_CASE(oom_bias),
-- 
2.54.0

