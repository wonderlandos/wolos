From c9ae5f4ffa4d095369bc8885b63562b9ea35e6aa Mon Sep 17 00:00:00 2001
From: Julia Klee <71413974+kleeedolinux@users.noreply.github.com>
Date: Fri, 30 Oct 2026 03:59:28 -0300
Subject: [PATCH 5/8] wolos: policy decisions as pure functions, KUnit
 wolos_policy

TSC trust, VT keyboard bypass and OOM bias as inlines in
<linux/wolos_policy.h>, testable on any arch.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
SPDX-License-Identifier: GPL-2.0-only
---
 include/linux/wolos_policy.h | 57 ++++++++++++++++++++++++++++++++++++
 lib/Kconfig.debug            |  5 ++++
 lib/Makefile                 |  1 +
 lib/wolos_policy_kunit.c     | 54 ++++++++++++++++++++++++++++++++++
 4 files changed, 117 insertions(+)
 create mode 100644 include/linux/wolos_policy.h
 create mode 100644 lib/wolos_policy_kunit.c

diff --git a/include/linux/wolos_policy.h b/include/linux/wolos_policy.h
new file mode 100644
index 000000000..269ac8ac7
--- /dev/null
+++ b/include/linux/wolos_policy.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * WolKernel policy decisions as pure functions, so KUnit can test them on any
+ * arch (lib/wolos_policy_kunit.c). Callers pass in the hardware/task facts.
+ */
+#ifndef _LINUX_WOLOS_POLICY_H
+#define _LINUX_WOLOS_POLICY_H
+
+#include <linux/types.h>
+
+/* Facts the TSC watchdog decision depends on. */
+struct wolos_tsc_facts {
+	bool constant, nonstop, tsc_adjust, hypervisor;
+	unsigned int packages;
+};
+
+/*
+ * True: skip the clocksource watchdog for the TSC. Stock rule (TSC_ADJUST,
+ * <= 4 packages) plus: one package, invariant TSC, bare metal, which covers
+ * AMD desktops without TSC_ADJUST. Boot and hotplug sync checks still run;
+ * tsc=watchdog restores the watchdog.
+ */
+static inline bool wolos_tsc_trusted(const struct wolos_tsc_facts *f)
+{
+	if (!f->constant || !f->nonstop)
+		return false;
+	if (f->tsc_adjust && f->packages <= 4)
+		return true;
+	return !f->hypervisor && f->packages == 1;
+}
+
+/*
+ * True: kbd_event() skips the keymap, LED tasklet and console work. Only when
+ * a graphical session owns the keyboard (K_OFF + KD_GRAPHICS); text VTs keep
+ * the full path.
+ */
+static inline bool wolos_kbd_bypass(bool kbd_off, bool vt_graphics)
+{
+	return kbd_off && vt_graphics;
+}
+
+/*
+ * OOM badness after the WolOS bias: the frontmost app counts a quarter of its
+ * size, SCHED_IDLE (Background QoS) tasks gain an eighth of RAM, so background
+ * work dies first and the app in front last. oom_score_adj still applies.
+ */
+static inline long wolos_oom_bias(long points, unsigned long totalpages,
+				  bool foreground, bool sched_idle)
+{
+	if (foreground)
+		return points / 4;
+	if (sched_idle)
+		return points + (long)(totalpages / 8);
+	return points;
+}
+
+#endif
diff --git a/lib/Kconfig.debug b/lib/Kconfig.debug
index 675908715..7330581f2 100644
--- a/lib/Kconfig.debug
+++ b/lib/Kconfig.debug
@@ -2845,6 +2845,11 @@ config KFIFO_KUNIT_TEST
 
 	  If unsure, say N.
 
+config WOLOS_POLICY_KUNIT_TEST
+	tristate "KUnit test for WolKernel policy decisions" if !KUNIT_ALL_TESTS
+	depends on KUNIT
+	default KUNIT_ALL_TESTS
+
 config LIST_KUNIT_TEST
 	tristate "KUnit Test for Kernel Linked-list structures" if !KUNIT_ALL_TESTS
 	depends on KUNIT
diff --git a/lib/Makefile b/lib/Makefile
index a2afe9548..81a3c431f 100644
--- a/lib/Makefile
+++ b/lib/Makefile
@@ -350,3 +350,4 @@ CONTEXT_ANALYSIS_test_context-analysis.o := y
 obj-$(CONFIG_CONTEXT_ANALYSIS_TEST) += test_context-analysis.o
 
 subdir-$(CONFIG_FORTIFY_SOURCE) += test_fortify
+obj-$(CONFIG_WOLOS_POLICY_KUNIT_TEST) += wolos_policy_kunit.o
diff --git a/lib/wolos_policy_kunit.c b/lib/wolos_policy_kunit.c
new file mode 100644
index 000000000..834d40694
--- /dev/null
+++ b/lib/wolos_policy_kunit.c
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-2.0
+/* KUnit: WolKernel policy decisions (include/linux/wolos_policy.h). */
+#include <kunit/test.h>
+#include <linux/wolos_policy.h>
+
+static void tsc_trust(struct kunit *t)
+{
+	struct wolos_tsc_facts desktop_amd = { true, true, false, false, 1 };
+	struct wolos_tsc_facts intel = { true, true, true, false, 1 };
+	struct wolos_tsc_facts vm = { true, true, false, true, 1 };
+	struct wolos_tsc_facts dual = { true, true, false, false, 2 };
+	struct wolos_tsc_facts old = { true, false, false, false, 1 };
+
+	/* one package, invariant TSC, bare metal: trusted even without TSC_ADJUST */
+	KUNIT_EXPECT_TRUE(t, wolos_tsc_trusted(&desktop_amd));
+	KUNIT_EXPECT_TRUE(t, wolos_tsc_trusted(&intel));	/* stock rule still holds */
+	KUNIT_EXPECT_FALSE(t, wolos_tsc_trusted(&vm));
+	KUNIT_EXPECT_FALSE(t, wolos_tsc_trusted(&dual));
+	KUNIT_EXPECT_FALSE(t, wolos_tsc_trusted(&old));
+}
+
+static void kbd_bypass(struct kunit *t)
+{
+	KUNIT_EXPECT_TRUE(t, wolos_kbd_bypass(true, true));	/* compositor session */
+	KUNIT_EXPECT_FALSE(t, wolos_kbd_bypass(false, true));
+	KUNIT_EXPECT_FALSE(t, wolos_kbd_bypass(true, false));
+	KUNIT_EXPECT_FALSE(t, wolos_kbd_bypass(false, false));	/* text VT */
+}
+
+static void oom_bias(struct kunit *t)
+{
+	KUNIT_EXPECT_EQ(t, wolos_oom_bias(800, 8000, true, false), 200L);
+	KUNIT_EXPECT_EQ(t, wolos_oom_bias(100, 8000, false, true), 1100L);
+	KUNIT_EXPECT_EQ(t, wolos_oom_bias(500, 8000, false, false), 500L);
+	/* foreground wins over SCHED_IDLE */
+	KUNIT_EXPECT_EQ(t, wolos_oom_bias(800, 8000, true, true), 200L);
+	/* background (100+1000) now ranks above a bigger foreground app (800/4) */
+	KUNIT_EXPECT_GT(t, wolos_oom_bias(100, 8000, false, true),
+			wolos_oom_bias(800, 8000, true, false));
+}
+
+static struct kunit_case wolos_policy_cases[] = {
+	KUNIT_CASE(tsc_trust),
+	KUNIT_CASE(kbd_bypass),
+	KUNIT_CASE(oom_bias),
+	{}
+};
+
+static struct kunit_suite wolos_policy_suite = {
+	.name = "wolos_policy",
+	.test_cases = wolos_policy_cases,
+};
+kunit_test_suite(wolos_policy_suite);
+MODULE_LICENSE("GPL");
-- 
