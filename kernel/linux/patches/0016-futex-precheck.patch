From 7ce5b223fb53ec93c11bf102b7c0d9bd16191711 Mon Sep 17 00:00:00 2001
From: Julia Klee <71413974+kleeedolinux@users.noreply.github.com>
Date: Fri, 30 Oct 2026 15:52:47 -0300
Subject: [PATCH 16/21] futex: a value that already differs returns before
 hashing

FUTEX_WAIT and futex_waitv hashed the key and took the bucket lock
before reading the futex word, even when the word already differed and
the call could only return -EWOULDBLOCK. Read it first, pagefaults off:
a mismatch returns at once (a valid linearization); a match or a fault
goes down the unchanged locked path, which re-reads the value under the
bucket lock, so no wakeup can be lost. Misaligned addresses keep their
-EINVAL. Off: futex.precheck=0. KUnit: precheck_reads_user_value.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
SPDX-License-Identifier: GPL-2.0-only
---
 kernel/futex/futex.h      | 17 +++++++++++++++++
 kernel/futex/spin_kunit.c | 19 +++++++++++++++++++
 kernel/futex/waitwake.c   | 19 +++++++++++++++++++
 3 files changed, 55 insertions(+)

diff --git a/kernel/futex/futex.h b/kernel/futex/futex.h
index 40ad04d6ff8..8972a8beb7a 100644
--- a/kernel/futex/futex.h
+++ b/kernel/futex/futex.h
@@ -493,6 +493,23 @@ static inline bool futex_waitv_inline(unsigned int nr)
 	return READ_ONCE(futex_waitv_inline_on) && nr <= FUTEX_WAITV_INLINE;
 }
 
+extern bool futex_precheck_on;
+
+/*
+ * Lockless pre-read: true only when *uaddr is aligned, readable without
+ * faulting and differs from @val. A fault or a match says nothing; the
+ * locked path decides.
+ */
+static inline bool futex_value_differs(u32 __user *uaddr, u32 val)
+{
+	u32 cur;
+
+	/* Misaligned addresses keep their -EINVAL from get_futex_key(). */
+	if (!IS_ALIGNED((unsigned long)uaddr, sizeof(u32)))
+		return false;
+	return !futex_get_value_locked(&cur, uaddr) && cur != val;
+}
+
 extern int futex_parse_waitv(struct futex_vector *futexv,
 			     struct futex_waitv __user *uwaitv,
 			     unsigned int nr_futexes, futex_wake_fn *wake,
diff --git a/kernel/futex/spin_kunit.c b/kernel/futex/spin_kunit.c
index 9360083bd35..87a0fefffce 100644
--- a/kernel/futex/spin_kunit.c
+++ b/kernel/futex/spin_kunit.c
@@ -1,6 +1,8 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 /* KUnit: WolKernel adaptive FUTEX_WAIT spin policy (futex_spin_budget/next). */
 #include <kunit/test.h>
+#include <linux/mman.h>
+#include <linux/uaccess.h>
 #include "futex.h"
 
 static void budget_off_cases(struct kunit *t)
@@ -46,11 +48,28 @@ static void waitv_inline_bound(struct kunit *t)
 	futex_waitv_inline_on = saved;
 }
 
+static void precheck_reads_user_value(struct kunit *t)
+{
+	unsigned long addr = kunit_vm_mmap(t, NULL, 0, PAGE_SIZE,
+					   PROT_READ | PROT_WRITE, MAP_ANONYMOUS | MAP_PRIVATE, 0);
+	u32 __user *u = (u32 __user *)addr;
+	u32 five = 5;
+
+	KUNIT_ASSERT_NE(t, addr, 0UL);
+	KUNIT_ASSERT_EQ(t, copy_to_user(u, &five, sizeof(five)), 0UL);
+	KUNIT_EXPECT_FALSE(t, futex_value_differs(u, 5));	/* match: locked path decides */
+	KUNIT_EXPECT_TRUE(t, futex_value_differs(u, 6));
+	/* misaligned: keep -EINVAL; unmapped: keep -EFAULT handling */
+	KUNIT_EXPECT_FALSE(t, futex_value_differs((u32 __user *)(addr + 1), 6));
+	KUNIT_EXPECT_FALSE(t, futex_value_differs((u32 __user *)(addr - PAGE_SIZE), 6));
+}
+
 static struct kunit_case futex_spin_cases[] = {
 	KUNIT_CASE(budget_off_cases),
 	KUNIT_CASE(budget_scales_with_score),
 	KUNIT_CASE(score_moves),
 	KUNIT_CASE(waitv_inline_bound),
+	KUNIT_CASE(precheck_reads_user_value),
 	{}
 };
 
diff --git a/kernel/futex/waitwake.c b/kernel/futex/waitwake.c
index 47a019e5d11..d25d2130057 100644
--- a/kernel/futex/waitwake.c
+++ b/kernel/futex/waitwake.c
@@ -387,6 +387,17 @@ bool futex_waitv_inline_on __read_mostly = true;
 module_param_named(waitv_inline, futex_waitv_inline_on, bool, 0644);
 EXPORT_SYMBOL_IF_KUNIT(futex_waitv_inline_on);
 
+/*
+ * WolKernel: a futex whose value already differs from the expected one
+ * returns -EWOULDBLOCK before any key lookup, hashing or bucket lock. That
+ * is a valid linearization (the value differed at that instant); a value that
+ * matches is still re-read under the bucket lock before sleeping, so no
+ * wakeup can be lost. Wine/Proton fsync waits on already-signaled objects all
+ * the time. Off: futex.precheck=0.
+ */
+bool futex_precheck_on __read_mostly = true;
+module_param_named(precheck, futex_precheck_on, bool, 0644);
+
 static void futex_spin_wait(struct futex_q *q)
 {
 	struct futex_hash_bucket *hb;
@@ -510,6 +521,12 @@ int futex_wait_multiple_setup(struct futex_vector *vs, int count, int *woken)
 	 * Private futexes doesn't need to recalculate hash in retry, so skip
 	 * get_futex_key() when retrying.
 	 */
+	if (READ_ONCE(futex_precheck_on)) {
+		for (i = 0; i < count; i++) {
+			if (futex_value_differs(u64_to_user_ptr(vs[i].w.uaddr), vs[i].w.val))
+				return -EWOULDBLOCK;
+		}
+	}
 retry:
 	for (i = 0; i < count; i++) {
 		if (!(vs[i].w.flags & FLAGS_SHARED) && retry)
@@ -700,6 +717,8 @@ int futex_wait_setup(u32 __user *uaddr, u32 val, unsigned int flags,
 	 * absorb a wakeup if *uaddr does not match the desired values
 	 * while the syscall executes.
 	 */
+	if (READ_ONCE(futex_precheck_on) && futex_value_differs(uaddr, val))
+		return -EWOULDBLOCK;
 retry:
 	ret = get_futex_key(uaddr, flags, &q->key, FUTEX_READ);
 	if (unlikely(ret != 0))
-- 
2.56.0

