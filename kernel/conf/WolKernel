# WolKernel: GENERIC (releng/15.1) plus the lines below, one reason each. Built by kernel/build.sh.
# GENERIC already has SCHED_ULE (ifunc-selected, no runtime cost), PREEMPTION, SMP, COMPAT_LINUXKPI.
include GENERIC
ident   WolKernel

# 1 ms ticks in VMs too: GENERIC is 1000 Hz on hardware but 100 Hz under a hypervisor (subr_param.c
# HZ_VM). LinuxKPI jiffies are ticks, so drm/Wi-Fi delayed work and timeouts get 1 ms granularity.
options     HZ=1000

# No-ops on releng and stable (their GENERIC has none of these); a main-branch GENERIC turns them
# on, and a desktop must not ship a debugging kernel (lock-order and assertion checks on every lock).
nooptions   INVARIANTS
nooptions   INVARIANT_SUPPORT
nooptions   WITNESS
nooptions   WITNESS_SKIPSPIN
