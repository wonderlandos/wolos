# SPDX-License-Identifier: BSD-2-Clause
# UAPI headers from the same WolKernel tree as linux-wolos (ADR 0017): replaces Arch's linux-api-headers.
# _ref must match kernel/linux-wolos/ref (the fork's wolos branch, which carries the WolKernel patches).
pkgname=linux-wolos-api-headers
# Version: kernel/VERSION (pkgver = <wolkernel>+<linux>; epoch 1 sorts it above the old 7.3.0).
_wk=$(sed -n 's/^wolkernel=//p' "$startdir/../VERSION")
_linux=$(sed -n 's/^linux=//p' "$startdir/../VERSION")
epoch=1
pkgver=$_wk+$_linux
pkgrel=1
_ref=eb68e491b6e7f079e885d3ff98ae6677da01e505
pkgdesc="Kernel headers sanitized for use in userspace (WolKernel $_wk ($_linux))"
arch=(any)
url='https://github.com/wonderlandos/linux'
license=(GPL-2.0-only)
makedepends=(git rsync)
provides=("linux-api-headers=$_linux")
conflicts=(linux-api-headers)
replaces=(linux-api-headers)
source=("linux-$_ref.tar.gz::https://github.com/wonderlandos/linux/archive/$_ref.tar.gz")
sha256sums=(SKIP)

prepare() {
  cd linux-$_ref
  # Extra patches from $WOLOS_OVERLAY when present, same order as linux-wolos.
  if [ -n "${WOLOS_OVERLAY:-}" ] && [ -d "$WOLOS_OVERLAY/kernel/linux/patches" ]; then
    for p in "$WOLOS_OVERLAY"/kernel/linux/patches/*.patch; do
      [ -e "$p" ] || continue
      patch -Np1 < "$p" || { echo "extra patch does not apply: $p" >&2; exit 3; }
    done
  fi
}

build() {
  cd linux-$_ref
  make mrproper
}

package() {
  cd linux-$_ref
  make INSTALL_HDR_PATH="$pkgdir/usr" headers_install
  # libdrm ships the drm headers (as on Arch).
  rm -r "$pkgdir/usr/include/drm"
}
