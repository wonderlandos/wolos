{
  "default": "GPL-2.0-or-later",
  "rewrite_from": [
    "BSD-2-Clause",
    "GPL-3.0-or-later",
    "GPL-3.0-only",
    "GPL-3.0",
    "GPL-2.0-or-later WITH AdditionRef-WolOS-libwol-exception"
  ],
  "head_lines": 12,
  "max_bytes": 2000000,
  "skip": [
    "third_party/**",
    "crates/aurlaws/tests/fixtures/**",
    "desktop/overlay/usr/share/wolos/gtk-*/*.css",
    "desktop/overlay/usr/share/wolos/gtk3-theme/**",
    "desktop/overlay/usr/share/wolos/firefox/wolos-chrome.css",
    "desktop/overlay/usr/share/wolos/toolkits/**",
    "**/vendor/**",
    "**/target/**",
    "**/.git/**",
    "LICENSE",
    "LICENSE.*",
    "**/LICENSE",
    "**/LICENSE.*",
    "COPYRIGHT",
    "**/NOTICE",
    "**/NOTICE.*",
    "LICENSES/**",
    "tools/license/staged/**",
    "**/*.patch",
    "**/Cargo.lock",
    "**/*.lock",
    "assets/**",
    "site/**",
    "design/**",
    "crates/shell/protocols/**",
    "wopkg/recipes/**",
    "wolos-pkgbuilds/linux-wolos/ref"
  ],
  "unskip": [
    "design/tools/**"
  ],
  "accept": [],
  "expected": [
    {
      "glob": "crates/wol-abi/**",
      "spdx": "BSD-2-Clause"
    },
    {
      "glob": "crates/shared/**",
      "spdx": "BSD-2-Clause"
    },
    {
      "glob": "crates/core/**",
      "spdx": "BSD-2-Clause"
    },
    {
      "glob": "wolos-crystal/shards/cryswol/src/wol/pkg/**",
      "spdx": "GPL-2.0-or-later"
    },
    {
      "glob": "wolos-crystal/shards/cryswol/src/wol/realtime/**",
      "spdx": "GPL-2.0-or-later"
    },
    {
      "glob": "wolos-crystal/shards/cryswol/spec/pkg_spec.cr",
      "spdx": "GPL-2.0-or-later"
    },
    {
      "glob": "wolos-crystal/shards/cryswol/**",
      "spdx": "BSD-2-Clause"
    },
    {
      "glob": "kernel/scx_wolos/**",
      "spdx": "GPL-2.0-only"
    },
    {
      "glob": "kernel/freebsd/**",
      "spdx": "GPL-2.0-only"
    },
    {
      "glob": "hue/src/hue/color.cr",
      "spdx": "MIT"
    },
    {
      "glob": "hue/src/hue/extract.cr",
      "spdx": "MIT"
    },
    {
      "glob": "hue/src/hue/palette.cr",
      "spdx": "MIT"
    },
    {
      "glob": "hue/src/hue/imports.cr",
      "spdx": "MIT"
    },
    {
      "glob": "crates/shell/src/offers.rs",
      "spdx": "MIT"
    },
    {
      "glob": "crates/shell/tests/offers.rs",
      "spdx": "MIT"
    }
  ],
  "code": {
    "rs": "//",
    "js": "//",
    "mjs": "//",
    "cpp": "//",
    "cc": "//",
    "hpp": "//",
    "c": "/*",
    "h": "/*",
    "css": "/*",
    "cr": "#",
    "sh": "#",
    "bash": "#",
    "py": "#",
    "rb": "#",
    "mk": "#",
    "lua": "--"
  },
  "code_names": {
    "Makefile": "#",
    "PKGBUILD": "#"
  },
  "fields": [
    {
      "glob": "Cargo.toml",
      "kind": "toml"
    },
    {
      "glob": "fuzz/Cargo.toml",
      "kind": "toml"
    },
    {
      "glob": "crates/shell/Cargo.toml",
      "kind": "toml"
    },
    {
      "glob": "wopkg/shard.yml",
      "kind": "yaml"
    },
    {
      "glob": "wolos-pkgbuilds/wolos-*/PKGBUILD",
      "kind": "pkgbuild"
    },
    {
      "glob": "wolos-pkgbuilds/wopkg/PKGBUILD",
      "kind": "pkgbuild"
    }
  ],
  "field_from": [
    "BSD-2-Clause",
    "GPL-3.0-or-later"
  ],
  "docs": [
    {
      "file": "README.md",
      "old": "**License:** BSD-2-Clause; the shell is GPL-3.0-or-later; brand art is CC BY-NC-ND 4.0 (share it to talk about WolOS; ask for anything else).",
      "new": "**License:** GPL-2.0-or-later; libwol (`crates/wol-abi`, `crates/shared`, `crates/core`) is BSD-2-Clause; kernel patches are GPL-2.0-only; brand art is CC BY-NC-ND 4.0 (share it to talk about WolOS; ask for anything else)."
    },
    {
      "file": "docs/adr/0021-wopkg.md",
      "old": "(Rust, `crates/wopkg`, BSD)",
      "new": "(Rust, `crates/wopkg`)"
    },
    {
      "file": "crates/shell/NOTICE",
      "old": "Licensed under GPL-3.0-or-later (see LICENSE).",
      "new": "Licensed under GPL-2.0-or-later (see LICENSE)."
    },
    {
      "file": "design/README.md",
      "old": "`tools/` is BSD-2-Clause;",
      "new": "`tools/` is GPL-2.0-or-later;"
    },
    {
      "file": "design/LICENSE",
      "old": "`tools/` is BSD-2-Clause (each file's SPDX line)",
      "new": "`tools/` is GPL-2.0-or-later (each file's SPDX line)"
    },
    {
      "file": "crates/core/Cargo.toml",
      "old": "license.workspace = true",
      "new": "license = \"BSD-2-Clause\""
    },
    {
      "file": "crates/shared/Cargo.toml",
      "old": "license.workspace = true",
      "new": "license = \"BSD-2-Clause\""
    },
    {
      "file": "crates/wol-abi/Cargo.toml",
      "old": "license.workspace = true",
      "new": "license = \"BSD-2-Clause\""
    }
  ],
  "copy": [
    {
      "from": "tools/license/staged/LICENSE",
      "to": "LICENSE"
    },
    {
      "from": "tools/license/staged/COPYRIGHT",
      "to": "COPYRIGHT"
    },
    {
      "from": "tools/license/staged/LICENSE.shell",
      "to": "crates/shell/LICENSE"
    },
    {
      "from": "tools/license/staged/LICENSE.bsd",
      "to": "LICENSES/BSD-2-Clause.txt"
    }
  ]
}
