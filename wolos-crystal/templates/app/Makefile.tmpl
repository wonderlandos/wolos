# {{class_name}}. `make` builds, `make spec` runs the headless spec, `make run` starts the app,
# `make styles` compiles the .wolcss sheets. Wolkit comes from CRYSTAL_PATH (the system shards
# directory, /usr/lib/wolos/crystal).
CRYSTAL ?= crystal

all: bin/{{name}}

bin/{{name}}: $(wildcard src/*.cr src/*/*.cr)
	mkdir -p bin
	$(CRYSTAL) build --error-on-warnings src/main.cr -o bin/{{name}}

spec:
	$(CRYSTAL) spec --error-on-warnings

format:
	$(CRYSTAL) tool format src spec dev

check:
	$(CRYSTAL) build --no-codegen src/main.cr

# `wol app run` comes here. With WOL_APP_WATCH=1 (`wol app run --watch`) dev/watch.sh runs a dev
# build (-Ddev) and follows your edits; without it the program runs once.
ifeq ($(WOL_APP_WATCH),1)
run:
	sh dev/watch.sh
else
run: bin/{{name}}
	bin/{{name}}
endif

# The kit sheet goes first (build/00-kit.wolcss sorts before src/styles/), so the default look's class
# ids stay where Wolkit expects them; load the result with Wolkit.use_styles("build/styles.wsb").
KIT_SHEET ?= $(firstword $(wildcard $(addsuffix /wolkit/styles/kit.wolcss,$(subst :, ,$(shell crystal env CRYSTAL_PATH)))))

styles:
	mkdir -p build src/gen
	cp $(KIT_SHEET) build/00-kit.wolcss
	wolkit-stylec --out build/styles.wsb --crystal src/gen/styles.cr build/00-kit.wolcss src/styles/app.wolcss

.PHONY: all spec format check run styles
