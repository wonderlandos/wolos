SET_PROP 3 placeholder "What needs doing?"
SET_PROP 3 grow 1.0
SET_A11Y 3 textbox "What needs doing?" ""
BIND_EVENT 3 100000
SET_TEXT 3 ""
BIND_EVENT 3 110000
INSERT 2 3 append
CREATE 4 button
SET_PROP 4 flex-direction row
SET_STATE 4 16
SET_STYLE 4 1
SET_A11Y 4 button "Add" ""
BIND_EVENT 4 1
SET_TEXT 4 "Add"
INSERT 2 4 append
CREATE 5 spacer
SET_PROP 5 display none
INSERT 1 5 append
CREATE 6 text
SET_PROP 6 font-size caption
SET_TEXT 6 "0 left"
INSERT 1 6 append
