CREATE 1 box
SET_PROP 1 flex-direction column
SET_PROP 1 gap 12.0
SET_PROP 1 padding 16.0
INSERT 0 1 append
CREATE 2 box
SET_PROP 2 flex-direction row
SET_PROP 2 gap 8.0
INSERT 1 2 append
