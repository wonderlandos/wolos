#!/bin/sh
# WolOS removable media (auto_master: /media -wolmedia -nosuid,noatime): the stock -media map
# (fstyp detection, sync mounts) plus write access for group operator (gid 5, every WolOS account)
# on FAT, exFAT and NTFS. msdosfs masks are decimal: 436 = 0664 files, 509 = 0775 directories.
# WOLOS_SPECIAL_MEDIA: the stock map (tests run a fake).
media=${WOLOS_SPECIAL_MEDIA:-/etc/autofs/special_media}
[ $# -eq 0 ] && exec "$media"
entry=$("$media" "$@") || exit
printf '%s\n' "$entry" | sed -E \
	-e 's/^-fstype=msdosfs,/-fstype=msdosfs,gid=5,mask=436,dirmask=509,/' \
	-e 's/^(-mountprog=[^,]*\/mount\.exfat,fstype=exfat,)/\1allow_other,gid=5,umask=002,/' \
	-e 's/^(-mountprog=[^,]*\/ntfs-3g,fstype=ntfs,)/\1allow_other,gid=5,umask=002,/'
