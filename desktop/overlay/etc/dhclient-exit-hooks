# WolOS: sourced by dhclient-script(8) after a lease is applied ($reason).
# ntpd starts at boot before Wi-Fi has a lease, so its pool names do not resolve yet and the
# leap-second file cannot be refreshed. On a new lease: refresh the leap file if it is near or
# past expiry (rc.d/ntpd `fetch`), then restart ntpd to resolve the pool now. In the background:
# never delays the interface coming up.
# Also: a driver only the internet has (NVIDIA) that first boot could not install is installed now,
# once per boot (`wol hw online`; one run at a time); the session says restart, or where to fix it.
case ${reason:-} in
BOUND | REBOOT)
	if service ntpd status >/dev/null 2>&1; then
		(service ntpd fetch; service ntpd restart) >/dev/null 2>&1 &
	fi
	lockf -s -t 0 /var/run/wolos-hw-online.lock /usr/local/bin/wol hw online >/dev/null 2>&1 &
	;;
esac
