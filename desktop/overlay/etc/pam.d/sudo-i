#%PAM-1.0
# sudo and sudo -i (pam.d/sudo-i): WolOS's guessing limits, as wol-lock and wol-admin (QA-PRIV-13):
# 10 failures lock for 60 s on one count with the lock screen and Settings, instead of Arch
# system-auth's 3 failures for 10 minutes. pam_unix keeps its own fail delay: sudo has none.
auth		required	pam_faillock.so preauth deny=10 unlock_time=60
auth		[success=1 default=bad]	pam_unix.so
auth		[default=die]	pam_faillock.so authfail deny=10 unlock_time=60
auth		optional	pam_permit.so
auth		required	pam_env.so
account		required	pam_faillock.so
account		include		system-auth
session		include		system-auth
