# wol-admin (crates/controller wol-authcheck --admin, for wol-admind): an administrator's password
# before a privileged change in Settings. Guessing limits as wol-lock.
auth		required	pam_faillock.so preauth deny=10 unlock_time=60
auth		[success=1 default=bad]	pam_unix.so
auth		[default=die]	pam_faillock.so authfail deny=10 unlock_time=60
auth		optional	pam_permit.so
account		required	pam_faillock.so
account		include		system-auth
