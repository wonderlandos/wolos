    <property name="sidebar_backdrop_color">#27272d</property>
    <property name="secondary_sidebar_bg_color">#27272d</property>
    <property name="card_bg_color">#2c2c30</property>
    <property name="card_fg_color">#f5f5f7</property>
    <property name="dialog_bg_color">#2c2c30</property>
    <property name="dialog_fg_color">#f5f5f7</property>
    <property name="popover_bg_color">#2c2c30</property>
    <property name="popover_fg_color">#f5f5f7</property>
    <property name="borders">rgba(255,255,255,0.08)</property>
  </metadata>
  <style name="text" foreground="#f5f5f7" background="#2c2c30"/>
  <style name="selection" foreground="#ffffff" background="#8b6cff"/>
  <style name="cursor" foreground="#8b6cff"/>
  <style name="current-line" background="#36363a"/>
  <style name="line-numbers" foreground="#a1a1a6" background="#2c2c30"/>
  <style name="current-line-number" foreground="#f5f5f7" background="#36363a"/>
  <style name="right-margin" foreground="#444448" background="#444448"/>
  <style name="draw-spaces" foreground="#5e5e62"/>
  <style name="background-pattern" foreground="#38383c"/>
  <style name="bracket-match" background="#444448" bold="true"/>
  <style name="bracket-mismatch" foreground="#ff6158" underline="error"/>
  <style name="search-match" foreground="#ffffff" background="#8b6cff"/>
  <style name="map-overlay" background="#404044"/>
  <style name="def:comment" foreground="#a1a1a6" italic="true"/>
  <style name="def:doc-comment-element" foreground="#a1a1a6" bold="true" italic="true"/>
  <style name="def:keyword" foreground="#9c82ff" bold="true"/>
  <style name="def:statement" foreground="#9c82ff" bold="true"/>
  <style name="def:type" foreground="#9c82ff"/>
  <style name="def:builtin" foreground="#9c82ff"/>
  <style name="def:preprocessor" foreground="#ff9f0a"/>
  <style name="def:string" foreground="#30d158"/>
  <style name="def:special-char" foreground="#ff9f0a"/>
  <style name="def:character" foreground="#30d158"/>
  <style name="def:number" foreground="#ff9f0a"/>
  <style name="def:decimal" foreground="#ff9f0a"/>
