  <style name="def:constant" foreground="#ff9f0a"/>
  <style name="def:identifier" foreground="#f5f5f7"/>
  <style name="def:function" foreground="#9c82ff"/>
  <style name="def:heading" foreground="#9c82ff" bold="true"/>
  <style name="def:link-destination" foreground="#9c82ff"/>
  <style name="def:net-address" foreground="#9c82ff"/>
  <style name="def:error" foreground="#ff6158" underline="error"/>
