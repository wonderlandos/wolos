  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:inline-code" foreground="#30d158"/>
  <style name="def:insertion" foreground="#30d158"/>
  <style name="def:deletion" foreground="#ff6158"/>
  <style name="def:underlined" underline="single"/>
