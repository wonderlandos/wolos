<?xml version="1.0" encoding="UTF-8"?>
<!-- WolOS wol-dark — generated by `wol theme`; edits are overwritten. -->
<style-scheme id="wolos-dark" name="WolOS Dark" version="1.0">
  <author>WolOS</author>
  <description>WolOS Dark</description>
  <metadata>
    <property name="variant">dark</property>
    <property name="light-variant">wolos-light</property>
    <property name="dark-variant">wolos-dark</property>
    <property name="accent_bg_color">#8b6cff</property>
    <property name="accent_fg_color">#ffffff</property>
    <property name="accent_color">#9c82ff</property>
    <property name="destructive_bg_color">#ff453a</property>
    <property name="destructive_color">#ff6158</property>
    <property name="success_bg_color">#30d158</property>
    <property name="success_color">#30d158</property>
    <property name="warning_bg_color">#ff9f0a</property>
    <property name="warning_color">#ff9f0a</property>
    <property name="error_bg_color">#ff453a</property>
    <property name="error_color">#ff6158</property>
    <property name="window_bg_color">#1e1e22</property>
    <property name="window_fg_color">#f5f5f7</property>
    <property name="view_bg_color">#2c2c30</property>
    <property name="view_fg_color">#f5f5f7</property>
    <property name="headerbar_bg_color">#1e1e22</property>
    <property name="headerbar_fg_color">#f5f5f7</property>
