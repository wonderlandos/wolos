#!/bin/sh
# Start a WolOS session: Hyprland with WolOS defaults (user file sources the system file).
export XDG_SESSION_TYPE=wayland XDG_SESSION_DESKTOP=Hyprland XDG_CURRENT_DESKTOP=Hyprland
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
	XDG_RUNTIME_DIR=/var/run/user/$(id -u)
	mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
	export XDG_RUNTIME_DIR
fi
# WOLOS_SHARE: shipped defaults (overridable so a live test runs this script from the repo).
share=${WOLOS_SHARE:-/usr/local/share/wolos}
conf=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf
if [ ! -e "$conf" ]; then
	mkdir -p "${conf%/*}"
	cat > "$conf" <<CONF
# WolOS defaults. Add your overrides below.
source = $share/hypr/hyprland.conf
CONF
fi
# Third-party apps look like WolOS before the first `wol theme set`: link the shipped defaults
# (never over the user's own files). Hyprland exec-once regenerates them from the active theme.
cfg=${XDG_CONFIG_HOME:-$HOME/.config}
for f in gtk-4.0/gtk.css gtk-4.0/settings.ini gtk-3.0/gtk.css gtk-3.0/settings.ini qt6ct/qt6ct.conf foot/foot.ini \
	Kvantum/kvantum.kvconfig Kvantum/WolOS/WolOS.kvconfig Kvantum/WolOS/WolOS.svg; do
	if [ ! -e "$cfg/$f" ] && [ ! -L "$cfg/$f" ]; then
		mkdir -p "$cfg/${f%/*}" && ln -s "$share/$f" "$cfg/$f"
	fi
done
# Desktop, Documents, Downloads, Music, Pictures, Videos (names follow the account language).
command -v xdg-user-dirs-update >/dev/null 2>&1 && xdg-user-dirs-update
# GPU env (AQ_DRM_DEVICES = compositing GPU first, LIBVA_DRIVER_NAME): `wol-realtime gpu env`.
if command -v wol-realtime >/dev/null 2>&1; then
	eval "$(wol-realtime gpu env)"
fi
# GTK 4: cairo renderer until a GPU renderer is proven on real hardware (the default never mapped
# the shell, Setup or login windows on the passthrough iGPU). A user override wins.
export GSK_RENDERER=${GSK_RENDERER:-cairo}
# start-hyprland: the 0.56 watchdog launcher (restarts on crash; no "started without" banner).
# After a crash it restarts Hyprland locked behind this lock screen (WolOS fork, ADR 0012).
export WOLOS_CRASH_LOCK_CMD="wol-lock --startup"
# Single-account boot (wol-login): Hyprland starts locked, nothing of the session shows before the
# password. The variable stops here; apps never see it.
if [ "${WOL_SESSION_LOCKED:-}" = 1 ]; then
	unset WOL_SESSION_LOCKED
	exec dbus-run-session -- start-hyprland -- --locked-cmd "$WOLOS_CRASH_LOCK_CMD"
fi
exec dbus-run-session -- start-hyprland
