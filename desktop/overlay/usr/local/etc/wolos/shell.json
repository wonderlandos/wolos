{
  "iconTheme": "WolOS",
  "status": [
    "network-wireless-signal-excellent-symbolic",
    "bluetooth-active-symbolic",
    "battery-full-charged-symbolic",
    "audio-volume-high-symbolic",
    "preferences-system-symbolic"
  ],
  "clockFormat": "%a %d %b %H:%M",
  "dock": [
    { "id": "org.mozilla.firefox", "name": "Firefox", "icon": "firefox", "exec": ["firefox"] },
    { "id": "org.gnome.Nautilus", "name": "Files", "icon": "org.gnome.Nautilus", "exec": ["nautilus"] },
    { "id": "org.codeberg.dnkl.foot", "name": "Terminal", "icon": "foot", "exec": ["foot"] },
    { "id": "org.gnome.TextEditor", "name": "Text Editor", "icon": "org.gnome.TextEditor", "exec": ["gnome-text-editor"] },
    { "id": "org.gnome.Loupe", "name": "Image Viewer", "icon": "org.gnome.Loupe", "exec": ["loupe"] },
    { "id": "org.wolos.settings", "name": "Settings", "icon": "preferences-system", "exec": ["wol-settings"] }
  ],
  "menuBar": [
    {
      "title": "",
      "items": [
        { "label": "About This Computer", "exec": ["wol-settings", "About"] },
        { "label": "-" },
        { "label": "System Settings…", "exec": ["wol-settings"] },
        { "label": "-" },
        { "label": "Sleep", "action": "sleep" },
        { "label": "Restart…", "exec": ["wol", "shell", "show", "session"] },
        { "label": "Shut Down…", "exec": ["wol", "shell", "show", "session"] },
        { "label": "-" },
        { "label": "Lock Screen", "action": "lock" },
        { "label": "Log Out…", "exec": ["wol", "shell", "show", "session"] }
      ]
    },
    {
      "title": "File",
      "items": [
        { "label": "New Window", "action": "new-window" },
        { "label": "Close Window", "action": "close" }
      ]
    },
    {
      "title": "Window",
      "items": [
        { "label": "Minimize", "action": "minimize" },
        { "label": "Zoom", "action": "zoom" }
      ]
    }
  ],
  "wallpaper": {
    "day": "/usr/local/share/wolos/wallpapers/wonderland-day.svg",
    "night": "/usr/local/share/wolos/wallpapers/wonderland-night.svg",
    "dir": "~/Pictures/Wallpapers",
    "rotateMinutes": 0
  }
}
