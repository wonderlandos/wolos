# WolOS system zprofile: every login zsh (console, `su -l`, the desktop session start). Quiet and
# fast: it runs on each login. FreeBSD /etc/profile loads /etc/profile.d and /usr/local/etc/profile.d
# drop-ins from ports; they are sh scripts.
[[ -r /etc/profile ]] && emulate sh -c '. /etc/profile'
