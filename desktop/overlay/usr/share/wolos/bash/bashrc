# WolOS bash setup (ADR 0032 "Console"): the same history, keys and colours as the WolOS zsh for
# people who choose bash. Arch's /etc/bash.bashrc reads no drop-ins, so this is read from
# /etc/profile.d/wolos-console.sh by login shells and from ~/.bashrc by any shell that adds
#   [ -r /usr/share/wolos/bash/bashrc ] && . /usr/share/wolos/bash/bashrc
# Upgrades replace this file; your settings stay in ~/.bashrc. Theme colours come from
# ${XDG_CONFIG_HOME:-~/.config}/wolos/toolkits/bash/colors.sh (`wol theme`), else the default
# theme's /usr/share/wolos/toolkits/bash/colors.sh (core theme/console.rs `bash`): WOLOS_ANSI_<ROLE>
# for ACCENT, MUTED, OK, ERROR as SGR parameters such as 38;2;124;92;255 (and WOLOS_PROMPT_<ROLE>
# as #rrggbb, for other programs). Unset = terminal palette.
# shellcheck shell=bash
case $- in *i*) ;; *) return 0 2>/dev/null || exit 0 ;; esac
[ -z "${WOLOS_BASHRC_READ:-}" ] || return 0
WOLOS_BASHRC_READ=1

HISTSIZE=50000
HISTFILESIZE=50000
HISTCONTROL=ignorespace:ignoredups:erasedups
shopt -s histappend checkwinsize autocd 2>/dev/null # an older bash without autocd: only that option is lost
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# Keys: Ctrl/Alt-arrows by word, Up/Down search history by the typed prefix.
bind '"\e[1;5C": forward-word' '"\e[1;5D": backward-word' '"\e[1;3C": forward-word' \
  '"\e[1;3D": backward-word' '"\e[A": history-search-backward' '"\e[B": history-search-forward' \
  2>/dev/null # no line editor (bash -i on a pipe): nothing to bind, harmless

_wolos_colors=${XDG_CONFIG_HOME:-$HOME/.config}/wolos/toolkits/bash/colors.sh
[ -r "$_wolos_colors" ] || _wolos_colors=/usr/share/wolos/toolkits/bash/colors.sh
# shellcheck source=/dev/null
[ -r "$_wolos_colors" ] && . "$_wolos_colors"
: "${WOLOS_ANSI_ACCENT:=35}" "${WOLOS_ANSI_MUTED:=90}" "${WOLOS_ANSI_OK:=39}"
: "${WOLOS_ANSI_ERROR:=31}"
alias ls='ls --color=auto' ll='ls -lh' la='ls -lAh' grep='grep --color=auto'

# Prompt: the pure-bash fallback (directory, one symbol coloured by the last status), replaced by
# starship when it is installed (WOLOS_PROMPT=pure keeps this one). The symbol is \$ (# for root)
# where the font may lack it, like the zsh prompt; starship is not used on the Linux text console.
case ${TERM:-} in
  foot* | *256color* | *-direct) _wolos_sym='❯' ;;
  *) _wolos_sym='\$' ;;
esac
[ "${EUID:-1}" != 0 ] || _wolos_sym='#'
_wolos_ps1() {
  local s=$? c=$WOLOS_ANSI_OK
  [ "$s" = 0 ] || c=$WOLOS_ANSI_ERROR
  PS1="\[\e[${WOLOS_ANSI_ACCENT}m\]\w\[\e[0m\] \[\e[${c}m\]${_wolos_sym}\[\e[0m\] "
}
PROMPT_COMMAND="_wolos_ps1; $PROMPT_COMMAND"
if [ "${WOLOS_PROMPT:-starship}" != pure ] && [ "${TERM:-}" != linux ] &&
  command -v starship >/dev/null 2>&1; then
  _wolos_star=${XDG_CONFIG_HOME:-$HOME/.config}/wolos/toolkits/starship/palette.toml
  [ -r "$_wolos_star" ] || _wolos_star=/usr/share/wolos/toolkits/starship/palette.toml
  [ -r "$_wolos_star" ] || _wolos_star=/usr/share/wolos/starship/starship.toml
  export STARSHIP_CONFIG=${STARSHIP_CONFIG:-$_wolos_star}
  eval "$(starship init bash)"
fi
# The console module's tools, each only when installed (the evals run the program's own init).
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --bash)"
fi
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first' ll='eza -lh --git' la='eza -lah --git'
fi
if command -v bat >/dev/null 2>&1; then
  export BAT_THEME=${BAT_THEME:-ansi}
fi
unset _wolos_colors _wolos_star
