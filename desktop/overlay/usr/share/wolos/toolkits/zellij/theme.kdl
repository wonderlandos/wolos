// WolOS wol-light — generated by `wol theme`; edits are overwritten.
themes {
    wolos {
        fg "#1d1d1f"
        bg "#dbdbdd"
        black "#f5f5f7"
        red "#ff3b30"
        green "#34c759"
        yellow "#ff9500"
        blue "#0a84ff"
        magenta "#7c5cff"
        cyan "#007aa8"
        white "#c7c7cc"
        orange "#7c5cff"
    }
}
