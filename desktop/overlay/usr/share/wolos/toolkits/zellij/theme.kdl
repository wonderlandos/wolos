// WolOS wol-light — generated by `wol theme`; edits are overwritten.
themes {
    wolos {
        fg "#1d1d1f"
        bg "#dbdbdd"
        black "#f5f5f7"
        red "#cf3a68"
        green "#1c9a6e"
        yellow "#d9541e"
        blue "#1d64b0"
        magenta "#7c5cff"
        cyan "#007aa8"
        white "#c7c7cc"
        orange "#7c5cff"
    }
}
