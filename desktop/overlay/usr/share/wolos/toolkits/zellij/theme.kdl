themes {
    wolos {
        fg "#181521"
        bg "#d9d7de"
        black "#f3f1f8"
        red "#cf3a68"
        green "#1c9a6e"
        yellow "#d9541e"
        blue "#1d64b0"
        magenta "#7c5cff"
        cyan "#0f6e79"
        white "#c4c2cd"
        orange "#7c5cff"
    }
}
