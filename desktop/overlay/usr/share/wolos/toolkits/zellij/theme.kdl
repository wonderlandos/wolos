// WolOS wol-light — generated by `wol theme`; edits are overwritten.
themes {
    wolos {
        fg "#151520"
        bg "#d7d7e0"
        black "#f1f1fa"
        red "#bb3f27"
        green "#00863c"
        yellow "#c06400"
        blue "#1d64b0"
        magenta "#7452f5"
        cyan "#0f6e79"
        white "#c4c2cd"
        orange "#7452f5"
    }
}
