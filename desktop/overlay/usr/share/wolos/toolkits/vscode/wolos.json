{
  "$schema": "vscode://schemas/color-theme",
  "colors": {
    "activityBar.background": "#ebebf4",
    "activityBar.foreground": "#151520",
    "activityBarBadge.background": "#7452f5",
    "activityBarBadge.foreground": "#ffffff",
    "button.background": "#7452f5",
    "button.foreground": "#ffffff",
    "descriptionForeground": "#565563",
    "dropdown.background": "#ffffff",
    "editor.background": "#f1f1fa",
    "editor.foreground": "#151520",
    "editor.selectionBackground": "#7452f555",
    "editorCursor.foreground": "#7452f5",
    "editorGroupHeader.tabsBackground": "#f1f1fa",
    "editorLineNumber.foreground": "#565563",
    "errorForeground": "#bb3f27",
    "focusBorder": "#7452f5",
    "foreground": "#151520",
    "input.background": "#ffffff",
    "input.foreground": "#151520",
    "list.activeSelectionBackground": "#7452f5",
    "list.activeSelectionForeground": "#ffffff",
    "panel.background": "#f1f1fa",
    "panel.border": "#d7d7e0",
    "sideBar.background": "#ebebf4",
    "sideBar.border": "#d7d7e0",
    "sideBar.foreground": "#151520",
    "statusBar.background": "#ebebf4",
    "statusBar.foreground": "#151520",
    "tab.activeBackground": "#ffffff",
    "tab.inactiveBackground": "#f1f1fa",
    "terminal.ansiBlack": "#181521",
    "terminal.ansiBlue": "#1d64b0",
    "terminal.ansiBrightBlack": "#121019",
    "terminal.ansiBrightBlue": "#164b84",
    "terminal.ansiBrightCyan": "#0b535b",
    "terminal.ansiBrightGreen": "#00652d",
    "terminal.ansiBrightMagenta": "#573eb8",
    "terminal.ansiBrightRed": "#8c2f1d",
    "terminal.ansiBrightWhite": "#93929a",
    "terminal.ansiBrightYellow": "#904b00",
    "terminal.ansiCyan": "#0f6e79",
    "terminal.ansiGreen": "#00863c",
    "terminal.ansiMagenta": "#7452f5",
    "terminal.ansiRed": "#bb3f27",
    "terminal.ansiWhite": "#c4c2cd",
    "terminal.ansiYellow": "#c06400",
    "terminal.background": "#f1f1fa",
    "terminal.foreground": "#151520",
    "titleBar.activeBackground": "#f1f1fa",
    "titleBar.activeForeground": "#151520"
  },
  "name": "WolOS WolOS Light",
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#565563"
      }
    },
    {
      "scope": "keyword, storage",
      "settings": {
        "foreground": "#6e4ee9"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#007f39"
      }
    },
    {
      "scope": "constant.numeric, constant.language",
      "settings": {
        "foreground": "#a35500"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#6e4ee9"
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#bb3f27"
      }
    }
  ],
  "type": "light"
}
