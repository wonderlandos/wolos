# WolOS wol-light — generated by `wol theme`; edits are overwritten.
$env.WOLOS_THEME = "wol-light"
$env.WOLOS_PROMPT_ACCENT = "#6e4ee9"
$env.WOLOS_PROMPT_MUTED = "#565563"
$env.WOLOS_PROMPT_OK = "#007f39"
$env.WOLOS_PROMPT_ERROR = "#bb3f27"
$env.WOLOS_PROMPT_SUGGEST = "#858590"
$env.WOLOS_PROMPT_WARN = "#a35500"
$env.config.color_config = ($env.config.color_config? | default {} | merge {
    separator: "#565563"
    header: "#6e4ee9"
    row_index: "#565563"
    hints: "#858590"
    bool: "#a35500"
    int: "#a35500"
    float: "#a35500"
    string: "#151520"
    date: "#007f39"
    filesize: "#007f39"
    shape_string: "#007f39"
    shape_external: "#6e4ee9"
    shape_internalcall: "#6e4ee9"
    shape_keyword: "#6e4ee9"
    shape_flag: "#565563"
    shape_filepath: "#151520"
    shape_bool: "#a35500"
    shape_int: "#a35500"
    shape_float: "#a35500"
    shape_garbage: "#bb3f27"
})
