# WolOS wol-light — generated by `wol theme`; edits are overwritten.
$env.WOLOS_THEME = "wol-light"
$env.WOLOS_PROMPT_ACCENT = "#7053e6"
$env.WOLOS_PROMPT_MUTED = "#6e6e73"
$env.WOLOS_PROMPT_OK = "#22813a"
$env.WOLOS_PROMPT_ERROR = "#cc2f26"
$env.WOLOS_PROMPT_SUGGEST = "#8d8d91"
$env.WOLOS_PROMPT_WARN = "#995900"
$env.config.color_config = ($env.config.color_config? | default {} | merge {
    separator: "#6e6e73"
    header: "#7053e6"
    row_index: "#6e6e73"
    hints: "#8d8d91"
    bool: "#995900"
    int: "#995900"
    float: "#995900"
    string: "#1d1d1f"
    date: "#22813a"
    filesize: "#22813a"
    shape_string: "#22813a"
    shape_external: "#7053e6"
    shape_internalcall: "#7053e6"
    shape_keyword: "#7053e6"
    shape_flag: "#6e6e73"
    shape_filepath: "#1d1d1f"
    shape_bool: "#995900"
    shape_int: "#995900"
    shape_float: "#995900"
    shape_garbage: "#cc2f26"
})
