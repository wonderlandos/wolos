<?xml version="1.0" encoding="UTF-8"?>
<!-- WolOS wol-light — generated by `wol theme`; edits are overwritten. -->
<style-scheme id="wolos-light" name="WolOS Light" version="1.0">
  <author>WolOS</author>
  <description>WolOS Light</description>
  <metadata>
    <property name="variant">light</property>
    <property name="light-variant">wolos-light</property>
    <property name="dark-variant">wolos-dark</property>
    <property name="accent_bg_color">#7c5cff</property>
    <property name="accent_fg_color">#ffffff</property>
    <property name="accent_color">#7657f2</property>
    <property name="destructive_bg_color">#ff3b30</property>
    <property name="destructive_color">#d93229</property>
    <property name="success_bg_color">#34c759</property>
    <property name="success_color">#22813a</property>
    <property name="warning_bg_color">#ff9500</property>
    <property name="warning_color">#a66100</property>
    <property name="error_bg_color">#ff3b30</property>
    <property name="error_color">#d93229</property>
    <property name="window_bg_color">#f5f5f7</property>
    <property name="window_fg_color">#1d1d1f</property>
    <property name="view_bg_color">#ffffff</property>
    <property name="view_fg_color">#1d1d1f</property>
    <property name="headerbar_bg_color">#f5f5f7</property>
    <property name="headerbar_fg_color">#1d1d1f</property>
    <property name="headerbar_backdrop_color">#f5f5f7</property>
    <property name="sidebar_bg_color">#ededf1</property>
    <property name="sidebar_fg_color">#1d1d1f</property>
    <property name="sidebar_backdrop_color">#ededf1</property>
    <property name="secondary_sidebar_bg_color">#ededf1</property>
    <property name="card_bg_color">#ffffff</property>
    <property name="card_fg_color">#1d1d1f</property>
    <property name="dialog_bg_color">#ffffff</property>
    <property name="dialog_fg_color">#1d1d1f</property>
    <property name="popover_bg_color">#ffffff</property>
    <property name="popover_fg_color">#1d1d1f</property>
    <property name="borders">rgba(0,0,0,0.08)</property>
  </metadata>
  <style name="text" foreground="#1d1d1f" background="#ffffff"/>
  <style name="selection" foreground="#ffffff" background="#7c5cff"/>
  <style name="cursor" foreground="#7c5cff"/>
  <style name="current-line" background="#f4f4f4"/>
  <style name="line-numbers" foreground="#6e6e73" background="#ffffff"/>
  <style name="current-line-number" foreground="#1d1d1f" background="#f4f4f4"/>
  <style name="right-margin" foreground="#e4e4e4" background="#e4e4e4"/>
  <style name="draw-spaces" foreground="#c7c7c7"/>
  <style name="background-pattern" foreground="#f1f1f2"/>
  <style name="bracket-match" background="#e4e4e4" bold="true"/>
  <style name="bracket-mismatch" foreground="#d93229" underline="error"/>
  <style name="search-match" foreground="#ffffff" background="#7c5cff"/>
  <style name="map-overlay" background="#e8e8e9"/>
  <style name="def:comment" foreground="#6e6e73" italic="true"/>
  <style name="def:doc-comment-element" foreground="#6e6e73" bold="true" italic="true"/>
  <style name="def:keyword" foreground="#7657f2" bold="true"/>
  <style name="def:statement" foreground="#7657f2" bold="true"/>
  <style name="def:type" foreground="#7657f2"/>
  <style name="def:builtin" foreground="#7657f2"/>
  <style name="def:preprocessor" foreground="#a66100"/>
  <style name="def:string" foreground="#22813a"/>
  <style name="def:special-char" foreground="#a66100"/>
  <style name="def:character" foreground="#22813a"/>
  <style name="def:number" foreground="#a66100"/>
  <style name="def:decimal" foreground="#a66100"/>
  <style name="def:floating-point" foreground="#a66100"/>
  <style name="def:base-n-integer" foreground="#a66100"/>
  <style name="def:boolean" foreground="#d93229"/>
  <style name="def:special-constant" foreground="#d93229"/>
  <style name="def:constant" foreground="#a66100"/>
  <style name="def:identifier" foreground="#1d1d1f"/>
  <style name="def:function" foreground="#7657f2"/>
  <style name="def:heading" foreground="#7657f2" bold="true"/>
  <style name="def:link-destination" foreground="#7657f2"/>
  <style name="def:net-address" foreground="#7657f2"/>
  <style name="def:error" foreground="#d93229" underline="error"/>
  <style name="def:warning" foreground="#a66100"/>
  <style name="def:note" foreground="#7657f2" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:inline-code" foreground="#22813a"/>
  <style name="def:insertion" foreground="#22813a"/>
  <style name="def:deletion" foreground="#d93229"/>
  <style name="def:underlined" underline="single"/>
</style-scheme>
