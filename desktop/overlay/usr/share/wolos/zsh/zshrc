# WolOS system zshrc: every interactive zsh (from /etc/zsh/zshenv). Upgrades replace this file;
# your settings go in ~/.zshrc (read after this one, never touched by WolOS).
#
# Prompt colours follow the WolOS theme: `wol theme` may write
#   ${XDG_CONFIG_HOME:-~/.config}/wolos/toolkits/zsh/colors.zsh
# (else the default theme's /usr/share/wolos/zsh/colors.zsh, like the other shells) setting any of
# WOLOS_PROMPT_ACCENT WOLOS_PROMPT_MUTED WOLOS_PROMPT_OK WOLOS_PROMPT_ERROR WOLOS_PROMPT_SUGGEST
# to a zsh colour (%F{...}: name, 0-255 or #rrggbb). Unset = terminal palette.

# Plugins: Arch package paths (WOLOS_ZSH_PLUGINS: tests point it at a fixture).
_wolos_share=${WOLOS_ZSH_PLUGINS:-/usr/share/zsh/plugins}

# History: large, shared between open terminals, no duplicates, space-prefixed lines stay private.
HISTFILE=${HISTFILE:-$HOME/.zsh_history}
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_SPACE HIST_REDUCE_BLANKS HIST_VERIFY

setopt AUTO_CD INTERACTIVE_COMMENTS NO_BEEP COMPLETE_IN_WORD ALWAYS_TO_END PROMPT_SUBST CHASE_LINKS
# Tab: the first press lists the matches, the second walks the menu.
setopt AUTO_LIST LIST_AMBIGUOUS AUTO_MENU
unsetopt MENU_COMPLETE

# Colours: ls --color with LS_COLORS; the same scheme for completion lists.
export CLICOLOR=1
: ${LS_COLORS:=di=34:ln=35:so=32:pi=33:ex=31:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;43}
export LS_COLORS
alias ls='ls --color=auto' ll='ls -lh' la='ls -lAh' grep='grep --color=auto'

_wolos_colors=${XDG_CONFIG_HOME:-$HOME/.config}/wolos/toolkits/zsh/colors.zsh
[[ -r $_wolos_colors ]] || _wolos_colors=/usr/share/wolos/zsh/colors.zsh
[[ -r $_wolos_colors ]] && source "$_wolos_colors"
: ${WOLOS_PROMPT_ACCENT:=magenta} ${WOLOS_PROMPT_MUTED:=8} ${WOLOS_PROMPT_OK:=default}
: ${WOLOS_PROMPT_ERROR:=red} ${WOLOS_PROMPT_SUGGEST:=8}
# #rrggbb on a terminal without truecolor: nearest palette entry.
[[ $COLORTERM == (truecolor|24bit) ]] || zmodload zsh/nearcolor 2>/dev/null

# Keys: emacs bindings plus Home/End/Insert/Delete, Ctrl/Alt-arrows by word, Up/Down search history
# by the typed prefix. terminfo entries plus the literal foot/xterm/vt sequences.
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
_wolos_bind() {
  local widget=$1 seq
  shift
  for seq in "$@"; do
    [[ -n $seq ]] && bindkey -- "$seq" "$widget"
  done
}
_wolos_bind beginning-of-line "${terminfo[khome]}" '^[[H' '^[OH' '^[[1~' '^[[7~'
_wolos_bind end-of-line "${terminfo[kend]}" '^[[F' '^[OF' '^[[4~' '^[[8~'
_wolos_bind delete-char "${terminfo[kdch1]}" '^[[3~'
_wolos_bind overwrite-mode "${terminfo[kich1]}" '^[[2~'
_wolos_bind backward-word '^[[1;5D' '^[[1;3D' '^[^[[D'
_wolos_bind forward-word '^[[1;5C' '^[[1;3C' '^[^[[C'
_wolos_bind kill-word '^[[3;5~' '^[[3;3~'
_wolos_bind backward-kill-word '^[^?'
_wolos_bind up-line-or-beginning-search "${terminfo[kcuu1]}" '^[[A' '^[OA'
_wolos_bind down-line-or-beginning-search "${terminfo[kcud1]}" '^[[B' '^[OB'
_wolos_bind reverse-menu-complete "${terminfo[kcbt]}" '^[[Z'
# foot sends ^H for Ctrl-Backspace (plain Backspace is ^?); other terminals may send ^H for Backspace.
[[ $TERM == foot* ]] && _wolos_bind backward-kill-word '^H'
unfunction _wolos_bind

# Completion: menu you can arrow through, case-insensitive, partial words (f.b -> foo.bar).
# zsh-completions installs into site-functions, already on $fpath.
zmodload zsh/complist
autoload -Uz compinit
_wolos_cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
[[ -d $_wolos_cache ]] || mkdir -p "$_wolos_cache"
# Full scan + security audit at most once a day (new packages' completions); otherwise the
# compiled dump: ~1 ms instead of ~20 ms per new terminal.
() {
  setopt local_options extended_glob
  local dump=$_wolos_cache/zcompdump-$ZSH_VERSION
  if [[ -n $dump(#qN.mh-20) ]]; then
    compinit -C -d "$dump"
  else
    compinit -i -d "$dump"
    zcompile "$dump" 2>/dev/null
  fi
}
zstyle ':completion:*' menu select
zstyle ':completion:*' list-prompt ''
# No shell variables among the command-position Tab matches; `$HO<Tab>` still completes $HOME.
zstyle ':completion:*:-command-:*' tag-order '!parameters'
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format "%F{$WOLOS_PROMPT_MUTED}%d%f"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$_wolos_cache/compcache"
bindkey -M menuselect "${terminfo[kcbt]:-^[[Z}" reverse-menu-complete

# Prompt: directory, git branch, one symbol (accent after success, red after a failure). user@host
# only over SSH. Pure zsh: no extra process unless the directory is in a git work tree.
autoload -Uz vcs_info add-zsh-hook
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats ' %b'
zstyle ':vcs_info:git:*' actionformats ' %b|%a'
_wolos_vcs() { vcs_info }
add-zsh-hook precmd _wolos_vcs
_wolos_sym='%(!.#.%#)'
[[ $TERM == (foot*|*256color*|*-direct) ]] && _wolos_sym='%(!.#.❯)'
PROMPT=
[[ -n $SSH_CONNECTION ]] && PROMPT="%F{$WOLOS_PROMPT_MUTED}%n@%m%f "
PROMPT+="%F{$WOLOS_PROMPT_ACCENT}%(4~|.../%3~|%~)%f"
PROMPT+="%F{$WOLOS_PROMPT_MUTED}"'${vcs_info_msg_0_}'"%f "
PROMPT+="%(?.%F{$WOLOS_PROMPT_OK}.%F{$WOLOS_PROMPT_ERROR})$_wolos_sym%f "
unset _wolos_sym

# Console module (ADR 0032 "Console"): each tool is wired only when it is installed, so the base
# stays as above. starship replaces the prompt with the same shape, coloured by the theme's
# palette (WOLOS_PROMPT=pure keeps the prompt above); fzf adds Ctrl+R history and Ctrl+T files;
# zoxide adds `z`; eza takes over ls. The `eval`s run the installed program's own init output.
# Not on the Linux text console (TERM=linux): its font has no prompt glyph; the prompt above has `%`.
if [[ ${WOLOS_PROMPT:-starship} != pure && $TERM != linux ]] && (( $+commands[starship] )); then
  _wolos_star=${XDG_CONFIG_HOME:-$HOME/.config}/wolos/toolkits/starship/palette.toml
  [[ -r $_wolos_star ]] || _wolos_star=/usr/share/wolos/toolkits/starship/palette.toml
  [[ -r $_wolos_star ]] || _wolos_star=/usr/share/wolos/starship/starship.toml
  export STARSHIP_CONFIG=${STARSHIP_CONFIG:-$_wolos_star}
  eval "$(starship init zsh)"
  unset _wolos_star
fi
if (( $+commands[fzf] )); then
  [[ -r /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
  [[ -r /usr/share/fzf/completion.zsh ]] && source /usr/share/fzf/completion.zsh
  # Ctrl+Alt+F files, Ctrl+Alt+L git commits, Ctrl+Alt+V variables (next to this file).
  [[ -r ${${(%):-%x}:h}/fzf.zsh ]] && source "${${(%):-%x}:h}/fzf.zsh"
fi
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
if (( $+commands[eza] )); then
  alias ls='eza --group-directories-first' ll='eza -lh --git' la='eza -lah --git'
fi
# bat follows the terminal palette, which the theme sets; man pages go through bat.
if (( $+commands[bat] )); then
  export BAT_THEME=${BAT_THEME:-ansi}
  export MANPAGER=${MANPAGER:-"sh -c 'col -bx | bat -l man -p'"} MANROFFOPT=${MANROFFOPT:--c}
fi

# Autosuggestions (grey, from history; Right/End accepts), then syntax highlighting last.
if [[ -r $_wolos_share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=$WOLOS_PROMPT_SUGGEST"
  ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=40
  ZSH_AUTOSUGGEST_MANUAL_REBIND=1
  source "$_wolos_share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi
if [[ -r $_wolos_share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source "$_wolos_share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# su: root has no password on WolOS, so `su` and `su NAME` become sudo (your own password). An
# interactive-shell function only: wol-login and scripts run the real /usr/bin/su (`command su`).
su() {
  case $#:${1-} in
    0:* | 1:- | 1:-l | 1:--login) sudo -i; return ;;
    1:[!-]*) sudo -iu "$1"; return ;;
    2:- | 2:-l | 2:--login) case $2 in -*) ;; *) sudo -iu "$2"; return ;; esac ;;
    2:-c | 2:--command) sudo sh -c "$2"; return ;;
  esac
  (( ! $+commands[wol] )) || wol hint su
  command su "$@"
}

# Hints (console/hints.tsv, `wol hint`): a missing command or one that fails in a way WolOS knows
# gets one sentence and what to run instead. The table's command names are read once here (no
# process: $(<file) is read by zsh itself), so a command it does not name never starts `wol`.
typeset -gA _wolos_hint_cmds
() {
  local file=${WOLOS_HINTS:-/usr/share/wolos/console/hints.tsv} line
  [[ -r $file ]] && (( $+commands[wol] )) || return 0
  for line in "${(@f)$(<$file)}"; do
    [[ -z $line || $line == \#* ]] || _wolos_hint_cmds[${line%%$'\t'*}]=1
  done
}
command_not_found_handler() {
  if [[ -n ${_wolos_hint_cmds[${1:t}]} ]] && wol hint "$*" --not-found; then
    return 127
  fi
  print -ru2 -- "zsh: command not found: $1"
  return 127
}
# After each command (first among the precmd hooks, so $? is the command's): a failure that is
# not command-not-found (127) or an interrupt (over 128), and a first word in the table. su
# speaks for itself. preexec clears and sets the line, so an empty line stays quiet.
_wolos_hint_line=
_wolos_hint_preexec() { _wolos_hint_line=$1 }
_wolos_hint_precmd() {
  local s=$? line=$_wolos_hint_line w
  _wolos_hint_line=
  (( s != 0 && s != 127 && s <= 128 )) && [[ -n $line ]] || return $s
  w=${${(z)line}[1]}
  w=${w:t}
  [[ -n $w && $w != su && -n ${_wolos_hint_cmds[$w]} ]] && wol hint "$line" $s
  return $s
}
precmd_functions=(_wolos_hint_precmd $precmd_functions)
preexec_functions+=(_wolos_hint_preexec)
unset _wolos_share _wolos_colors _wolos_cache
