# WolOS wol-light - generated by `wol theme`; edits are overwritten.
[%General]
author=WolOS
comment=Generated from WolOS theme tokens
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=6
scroll_width=8
scroll_min_extent=40
transient_scrollbar=true
transient_groove=false
scrollbar_in_view=true
scroll_arrows=false
slider_width=4
slider_handle_width=16
slider_handle_length=16
check_size=16
tooltip_delay=500
submenu_overlap=0
menu_shadow_depth=0
tooltip_shadow_depth=0
composite=true
translucent_windows=false
blurring=false
popup_blurring=false
animate_states=true
button_contents_shift=false
combo_as_lineedit=false
combo_menu=true
hide_combo_checkboxes=true
layout_spacing=6
layout_margin=12
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=22
fill_rubberband=false
respect_DE=true
no_inactiveness=true
dark_titlebar=false
menubar_mouse_tracking=true
merge_menubar_with_toolbar=true
inline_spin_indicators=true
vertical_spin_indicators=false
tree_branch_line=false

[GeneralColors]
window.color=#f1f1fa
base.color=#ffffff
alt.base.color=#f8f8fd
button.color=#ebebf3
light.color=#f3f3f8
mid.light.color=#efeff5
dark.color=#cacad2
mid.color=#c0c0c9
highlight.color=#7452f5
inactive.highlight.color=#a692f7
text.color=#151520
window.text.color=#151520
button.text.color=#151520
disabled.text.color=#565563
tooltip.text.color=#151520
highlight.text.color=#ffffff
link.color=#7452f5
link.visited.color=#5740b5
progress.indicator.text.color=#151520

