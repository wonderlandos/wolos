# WolOS ghostty defaults (ADR 0032 "Console"). ghostty has no system-wide config, so wol-session
# links this file as ~/.config/ghostty/config when you have none (replace the link to make it
# yours; `ghostty --config-file=/usr/share/wolos/ghostty/config` starts it with these alone).
# Same font, padding and opacity as foot (desktop/overlay/usr/share/wolos/foot/foot.ini). The
# colours are the theme's, written by `wol theme` to ~/.config/wolos/toolkits/ghostty/theme (the
# leading ? makes a missing file fine).
font-family = JetBrains Mono
font-size = 11
window-padding-x = 12
window-padding-y = 12
background-opacity = 0.9
window-decoration = none
gtk-titlebar = false
confirm-close-surface = false
# The shell chosen in Settings > General (/usr/bin/wol-term-shell reads it, else zsh).
command = /usr/bin/wol-term-shell
shell-integration = detect
copy-on-select = clipboard
scrollback-limit = 50000000
# The default theme first, then yours (a later file wins).
config-file = ?/usr/share/wolos/toolkits/ghostty/theme
config-file = ?~/.config/wolos/toolkits/ghostty/theme
