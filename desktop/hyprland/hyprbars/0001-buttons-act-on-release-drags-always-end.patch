+// All three glyphs follow one state, decided here and never while rendering. The redraw waits for
+// the event loop: damage added mid-frame (draw() runs inside the render) can be lost with the frame.
+void CHyprBar::sampleHover() {
+    if (!g_pGlobalState->config.iconOnHover->value() || !validMapped(m_pWindow))
+        return;
+
+    const auto COORDS = cursorRelativeToBar();
+    const bool OVER   = wol_lights_over((int)shownButtons(), (int)std::floor(COORDS.x), (int)std::floor(COORDS.y)) && pointerReachesBar();
+    const auto NEXT   = wol_lights_hover(m_hover, OVER, m_pressedButton >= 0);
+    const bool REDRAW = wol_lights_glyphs(NEXT) != wol_lights_glyphs(m_hover);
+    m_hover           = NEXT;
+
+    if (REDRAW)
+        g_pEventLoopManager->doLater([self = m_self] {
+            // m_self comes from a UP: it can be checked, not locked.
+            if (self)
+                self->damageEntire();
+        });
+}
+
+// "close", "minimize" and "zoom" act on this bar's window in-process: no hyprctl round trip, and
+// never on whichever window happens to be active by the time a spawned command runs.
+void CHyprBar::runAction(const std::string& cmd) {
+    const auto PWINDOW = m_pWindow.lock();
+    if (!PWINDOW)
+        return;
+    if (cmd == "close")
+        (void)Config::Actions::closeWindow(PWINDOW);
+    else if (cmd == "minimize")
+        (void)Config::Actions::moveToWorkspace("special:hidden", true, PWINDOW);
+    else if (cmd == "zoom") {
+        if (Desktop::focusState()->window() != PWINDOW)
+            Desktop::focusState()->fullWindowFocus(PWINDOW, Desktop::FOCUS_REASON_CLICK);
+        (void)Config::Actions::fullscreenWindow(Fullscreen::FSMODE_MAXIMIZED, true, PWINDOW);
+    } else if (!cmd.empty())
+        Config::Supplementary::executor()->spawn(cmd);
 }
 
