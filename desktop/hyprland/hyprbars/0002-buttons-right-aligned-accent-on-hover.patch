+bool CHyprBar::buttonsRight() {
+    return g_pGlobalState->config.barButtonsAlignment->value() != "left";
+}
+
+// Geometry and order are realtime's (titlebar.rs): a right row holds close at the edge, then zoom,
+// minimise; the button in slot i is the i-th hyprbars-button, so what is drawn is what is pressed.
 int CHyprBar::buttonAt(Vector2D COORDS) {
-    return wol_lights_at((int)shownButtons(), (int)std::floor(COORDS.x), (int)std::floor(COORDS.y));
+    const int N = (int)shownButtons();
+    const int X = (int)std::floor(COORDS.x), Y = (int)std::floor(COORDS.y);
+    if (!buttonsRight())
+        return wol_lights_at(N, X, Y);
+    const int B = wol_lights_at_w((int)assignedBoxGlobal().w, N, X, Y);
+    for (int slot = 0; B >= 0 && slot < N; ++slot) {
+        if (wol_lights_slot_w(slot) == B)
+            return slot;
+    }
+    return -1;
+}
+
+bool CHyprBar::overButtons(Vector2D COORDS) {
+    const int N = (int)shownButtons();
+    const int X = (int)std::floor(COORDS.x), Y = (int)std::floor(COORDS.y);
+    return buttonsRight() ? wol_lights_over_w((int)assignedBoxGlobal().w, N, X, Y) : wol_lights_over(N, X, Y);
 }
 
