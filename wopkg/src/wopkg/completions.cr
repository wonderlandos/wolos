module Wopkg
  # Shell completion scripts. Package names come from `wopkg __complete <prefix>`, a prefix scan of
  # the local index (no network, a few milliseconds).
  module Completions
    VERBS = %w(install remove update search info list sync sources history rollback channel pause resume appimage aur recipe completions version help)
    NAMED = %w(install remove info)

    def self.zsh : String
      <<-ZSH
        #compdef wopkg
        # wopkg completion (generated by `wopkg completions zsh`).
        _wopkg() {
          local -a verbs
          verbs=(#{VERBS.join(" ")})
          if (( CURRENT == 2 )); then
            _describe 'command' verbs
            return
          fi
          case $words[2] in
            #{NAMED.join("|")}|-S|-R|-Rns|-Si|-Qi)
              local -a names
              names=(${(f)"$(wopkg __complete "$PREFIX" 2>/dev/null)"})
              compadd -a names ;;
            channel) compadd stable beta nightly ;;
            completions) compadd zsh bash fish ;;
          esac
        }
        _wopkg "$@"

        ZSH
    end

    def self.bash : String
      <<-BASH
        # wopkg completion (generated by `wopkg completions bash`).
        _wopkg() {
          local cur=${COMP_WORDS[COMP_CWORD]}
          if [ "$COMP_CWORD" -eq 1 ]; then
            COMPREPLY=($(compgen -W "#{VERBS.join(" ")}" -- "$cur"))
            return
          fi
          case ${COMP_WORDS[1]} in
            #{NAMED.join("|")}|-S|-R|-Rns|-Si|-Qi)
              local IFS=$'\\n'
              COMPREPLY=($(wopkg __complete "$cur" 2>/dev/null)) ;;
            channel) COMPREPLY=($(compgen -W "stable beta nightly" -- "$cur")) ;;
            completions) COMPREPLY=($(compgen -W "zsh bash fish" -- "$cur")) ;;
          esac
        }
        complete -F _wopkg wopkg

        BASH
    end

    def self.fish : String
      lines = ["# wopkg completion (generated by `wopkg completions fish`).", "complete -c wopkg -f"]
      VERBS.each { |v| lines << "complete -c wopkg -n '__fish_use_subcommand' -a #{v}" }
      lines << "complete -c wopkg -n '__fish_seen_subcommand_from #{NAMED.join(" ")}' -a '(wopkg __complete (commandline -ct) 2>/dev/null)'"
      lines << "complete -c wopkg -n '__fish_seen_subcommand_from channel' -a 'stable beta nightly'"
      lines << "complete -c wopkg -n '__fish_seen_subcommand_from completions' -a 'zsh bash fish'"
      lines << "complete -c wopkg -l json -d 'Machine-readable output'"
      lines << "complete -c wopkg -s y -l yes -d 'Do not ask'"
      lines.join("\n") + "\n"
    end

    def self.for(shell : String) : String?
      case shell
      when "zsh"  then zsh
      when "bash" then bash
      when "fish" then fish
      end
    end
  end
end
