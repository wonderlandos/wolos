module Wopkg
  # Shell completion scripts. Package names come from `wopkg __complete <prefix>`, a prefix scan of
  # the local index (no network, a few milliseconds).
  module Completions
    VERBS = %w(pin unpin install remove update search info list sync sources history rollback channel pause resume appimage aur audit recipe shard completions version help)
    NAMED = %w(install remove info)

    def self.zsh : String
      <<-ZSH
        #compdef wopkg
        # wopkg completion (generated by `wopkg completions zsh`).
        _wopkg() {
          local -a verbs
          verbs=(#{VERBS.join(" ")})
          if (( CURRENT == 2 )); then
            _describe 'command' verbs
            return
          fi
          case $words[2] in
            #{NAMED.join("|")}|-S|-R|-Rns|-Si|-Qi)
              local -a names
              names=(${(f)"$(wopkg __complete "$PREFIX" 2>/dev/null)"})
              compadd -a names ;;
            channel) compadd stable ;;
            completions) compadd zsh bash fish pwsh ;;
          esac
        }
        _wopkg "$@"

        ZSH
    end

    def self.bash : String
      <<-BASH
        # wopkg completion (generated by `wopkg completions bash`).
        _wopkg() {
          local cur=${COMP_WORDS[COMP_CWORD]}
          if [ "$COMP_CWORD" -eq 1 ]; then
            COMPREPLY=($(compgen -W "#{VERBS.join(" ")}" -- "$cur"))
            return
          fi
          case ${COMP_WORDS[1]} in
            #{NAMED.join("|")}|-S|-R|-Rns|-Si|-Qi)
              local IFS=$'\\n'
              COMPREPLY=($(wopkg __complete "$cur" 2>/dev/null)) ;;
            channel) COMPREPLY=($(compgen -W "stable" -- "$cur")) ;;
            completions) COMPREPLY=($(compgen -W "zsh bash fish pwsh" -- "$cur")) ;;
          esac
        }
        complete -F _wopkg wopkg

        BASH
    end

    def self.fish : String
      lines = ["# wopkg completion (generated by `wopkg completions fish`).", "complete -c wopkg -f"]
      VERBS.each { |v| lines << "complete -c wopkg -n '__fish_use_subcommand' -a #{v}" }
      lines << "complete -c wopkg -n '__fish_seen_subcommand_from #{NAMED.join(" ")}' -a '(wopkg __complete (commandline -ct) 2>/dev/null)'"
      lines << "complete -c wopkg -n '__fish_seen_subcommand_from channel' -a 'stable'"
      lines << "complete -c wopkg -n '__fish_seen_subcommand_from completions' -a 'zsh bash fish pwsh'"
      lines << "complete -c wopkg -l json -d 'Machine-readable output'"
      lines << "complete -c wopkg -s y -l yes -d 'Do not ask'"
      lines.join("\n") + "\n"
    end

    # pwsh: a native-command completer (Register-ArgumentCompleter -Native); same words as zsh.
    def self.pwsh : String
      verbs = VERBS.map { |v| "'#{v}'" }.join(", ")
      named = (NAMED + %w(-S -R -Rns -Si -Qi)).map { |v| "'#{v}'" }.join(", ")
      <<-PWSH
        # wopkg completion (generated by `wopkg completions pwsh`).
        Register-ArgumentCompleter -Native -CommandName wopkg -ScriptBlock {
            param($word, $ast, $cursor)
            $words = @($ast.CommandElements | ForEach-Object { $_.Extent.Text })
            $at = if ($word) { $words.Count - 1 } else { $words.Count }
            $list = if ($at -le 1) {
                @(#{verbs})
            } elseif ($words[1] -in @(#{named})) {
                @(wopkg __complete "$word" 2>$null)
            } elseif ($words[1] -eq 'channel') {
                @('stable')
            } elseif ($words[1] -eq 'completions') {
                @('zsh', 'bash', 'fish', 'pwsh')
            } else {
                @()
            }
            $list | Where-Object { $_ -and $_.StartsWith($word) } | ForEach-Object {
                [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
            }
        }

        PWSH
    end

    def self.for(shell : String) : String?
      case shell
      when "zsh"  then zsh
      when "bash" then bash
      when "fish" then fish
      when "pwsh" then pwsh
      end
    end
  end
end
